{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "e2e": "vite build --mode localnet && tsx e2e/owner.e2e.ts",
    "e2e:live": "tsx e2e/live.e2e.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@sealed-arena/shared": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "viem": "2.57.19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.7",
    "@hono/node-server": "2.1.8",
    "attacks": "workspace:*",
    "hono": "4.13.17",
    "playwright": "1.65.1",
    "relayer": "workspace:*",
    "tsx": "4.23.15"
  }
}
