+	e := newV3Env(t, true)
+	require.ErrorIs(t, e.guardianFreeze(gKey, e.epoch()), ErrNoGuardian)
+	require.NoError(t, e.setGuardianWith(g, flagsUPUV))
+	require.ErrorIs(t, e.guardianFreeze(other, e.epoch()), ErrBadGuardianSignature)
+	require.ErrorIs(t, e.guardianFreeze(gKey, big.NewInt(1)), ErrBadFreezeEpoch)
+
+	// high s: flip s to n - s and the recovery id.
+	sig, err := crypto.Sign(GuardianFreezeDigest(e.domain(), e.agent, e.epoch()).Bytes(), gKey)
+	require.NoError(t, err)
+	s := new(big.Int).SetBytes(sig[32:64])
+	high := new(big.Int).Sub(crypto.S256().Params().N, s)
+	bad := append(append(append([]byte{}, sig[:32]...), common.LeftPadBytes(high.Bytes(), 32)...), sig[64]^1)
+	require.ErrorIs(t, e.run(PackGuardianFreeze(GuardianFreezeInput{Agent: e.agent, Epoch: e.epoch(), Sig: bad})), ErrBadGuardianSignature)
+
+	ep := e.epoch()
+	require.NoError(t, e.guardianFreeze(gKey, ep))
+	require.True(t, e.frozen())
+	require.Equal(t, AgentPolicyABI.Events["Frozen"].ID, e.db.raw.Logs()[len(e.db.raw.Logs())-1].Topics[0])
+	require.NoError(t, e.guardianFreeze(gKey, ep), "idempotent")
+
+	// After an unfreeze the old epoch is stale.
+	require.NoError(t, e.unfreezeWith(flagsUPUV))
+	require.False(t, e.frozen())
+	require.ErrorIs(t, e.guardianFreeze(gKey, ep), ErrBadFreezeEpoch)
+	// After a rotation the old guardian is refused.
+	require.NoError(t, e.setGuardianWith(crypto.PubkeyToAddress(other.PublicKey), flagsUPUV))
+	require.ErrorIs(t, e.guardianFreeze(gKey, e.epoch()), ErrBadGuardianSignature)
+	require.NoError(t, e.guardianFreeze(other, e.epoch()))
+
+	// Unregistered agent.
+	e2 := newV3Env(t, true)
+	e2.agent = v3PayeeC
+	require.ErrorIs(t, e2.guardianFreeze(gKey, big.NewInt(0)), ErrNotRegistered)
+}
