@@ -0,0 +1,56 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package extras
+
+import (
+	"errors"
+	"fmt"
+)
+
+// Config keys of the agent rule version markers (Sealed Arena). Written out here to avoid an
+// import cycle; a test in agentrulev3 checks they match the modules' keys.
+const (
+	AgentRuleV2ConfigKey = "agentRuleV2Config"
+	AgentRuleV3ConfigKey = "agentRuleV3Config"
+)
+
+var errAgentRuleOrder = errors.New("agentRuleV3Config must activate at or after agentRuleV2Config")
+
+// firstActivation is the earliest enabling timestamp of `key` in the genesis precompiles or the
+// precompile upgrades, or nil if it is never enabled.
+func (c *ChainConfig) firstActivation(key string) *uint64 {
+	var first *uint64
+	consider := func(ts *uint64, disabled bool) {
+		if ts == nil || disabled {
+			return
+		}
+		if first == nil || *ts < *first {
+			v := *ts
+			first = &v
+		}
+	}
+	if cfg, ok := c.GenesisPrecompiles[key]; ok {
+		consider(cfg.Timestamp(), cfg.IsDisabled())
+	}
+	for _, u := range c.PrecompileUpgrades {
+		if u.Key() == key {
+			consider(u.Timestamp(), u.IsDisabled())
+		}
+	}
+	return first
+}
+
+// verifyAgentRuleOrder refuses a config that activates rule v3 without rule v2, or before it. The
+// same timestamp is allowed: modules are configured in address order, so v2 (0x0300...02) is
+// configured before v3 (0x0300...03) in the same block.
+func (c *ChainConfig) verifyAgentRuleOrder() error {
+	t3 := c.firstActivation(AgentRuleV3ConfigKey)
+	if t3 == nil {
+		return nil
+	}
+	t2 := c.firstActivation(AgentRuleV2ConfigKey)
+	if t2 == nil || *t3 < *t2 {
+		return fmt.Errorf("%w: v3 at %d, v2 at %v", errAgentRuleOrder, *t3, t2)
+	}
+	return nil
+}
