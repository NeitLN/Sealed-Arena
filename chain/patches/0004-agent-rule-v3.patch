+
+func TestAgentPolicyV3DigestsMatchTypeScript(t *testing.T) {
+	path := os.Getenv("SEALED_TESTVECTORS")
+	require.NotEmpty(t, path, "chain/scripts/test.sh sets SEALED_TESTVECTORS")
+	raw, err := os.ReadFile(filepath.Join(filepath.Dir(path), "agentpolicy-v3.json"))
+	require.NoError(t, err)
+	var v struct {
+		Input struct {
+			Domain   string `json:"domain"`
+			Agent    string `json:"agent"`
+			Guardian string `json:"guardian"`
+			To       string `json:"to"`
+			Nonce    string `json:"nonce"`
+			Epoch    string `json:"epoch"`
+			Mandate  struct {
+				Payees            []string `json:"payees"`
+				PayeeDailyCaps    []string `json:"payeeDailyCaps"`
+				PerTxCap          string   `json:"perTxCap"`
+				DailyCap          string   `json:"dailyCap"`
+				DailyFeeCap       string   `json:"dailyFeeCap"`
+				MaxPaymentsPerDay uint32   `json:"maxPaymentsPerDay"`
+				Expiry            string   `json:"expiry"`
+			} `json:"mandate"`
+		} `json:"input"`
+		MandateHash, SetMandateV3, CancelPending, SetGuardian, Sweep, GuardianFreeze string
+	}
+	require.NoError(t, json.Unmarshal(raw, &v))
+	num := func(s string) *big.Int {
+		x, ok := new(big.Int).SetString(s, 10)
+		require.True(t, ok, s)
+		return x
+	}
+	in := v.Input
+	m := IAgentPolicyMandateV3{PerTxCap: num(in.Mandate.PerTxCap), DailyCap: num(in.Mandate.DailyCap), DailyFeeCap: num(in.Mandate.DailyFeeCap),
+		MaxPaymentsPerDay: in.Mandate.MaxPaymentsPerDay, Expiry: num(in.Mandate.Expiry).Uint64()}
+	for i, p := range in.Mandate.Payees {
+		m.Payees = append(m.Payees, common.HexToAddress(p))
+		m.PayeeDailyCaps = append(m.PayeeDailyCaps, num(in.Mandate.PayeeDailyCaps[i]))
+	}
+	domain := common.HexToHash(in.Domain)
+	agent := common.HexToAddress(in.Agent)
+	require.Equal(t, v.MandateHash, MandateV3Hash(m).Hex())
+	require.Equal(t, v.SetMandateV3, SetMandateV3Challenge(domain, agent, m, num(in.Nonce)).Hex())
+	require.Equal(t, v.CancelPending, CancelPendingChallenge(domain, agent, num(in.Nonce)).Hex())
+	require.Equal(t, v.SetGuardian, SetGuardianChallenge(domain, agent, common.HexToAddress(in.Guardian), num(in.Nonce)).Hex())
+	require.Equal(t, v.Sweep, SweepChallenge(domain, agent, common.HexToAddress(in.To), num(in.Nonce), num(in.Epoch)).Hex())
+	require.Equal(t, v.GuardianFreeze, GuardianFreezeDigest(domain, agent, num(in.Epoch)).Hex())
+}
