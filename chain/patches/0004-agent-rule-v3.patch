+// ---- differential harness: strict (v3) against legacy (v1/v2) ------------------------------
+
+type cdVerdict struct {
+	ok             bool
+	typ, challenge string
+}
+
+func legacyVerdict(cd []byte) cdVerdict {
+	typ, ch, err := parseClientDataLegacy(cd)
+	if err != nil {
+		return cdVerdict{}
+	}
+	return cdVerdict{true, typ, ch}
+}
+
+func strictVerdict(cd []byte) cdVerdict {
+	typ, ch, err := scanClientDataV3(cd)
+	if err != nil {
+		return cdVerdict{}
+	}
+	return cdVerdict{true, string(typ), string(ch)}
+}
+
+// checkSound is property 1: strict accepts => legacy accepts with the same type and challenge.
+func checkSound(t testing.TB, cd []byte) {
+	t.Helper()
+	s := strictVerdict(cd)
+	if !s.ok {
+		return
+	}
+	l := legacyVerdict(cd)
+	if !l.ok || l.typ != s.typ || l.challenge != s.challenge {
+		t.Fatalf("strict accepts but legacy differs: %q strict=%+v legacy=%+v", cd, s, l)
+	}
+}
+
+// genClientData emits clientDataJSON the way browsers, password managers and native clients
+// serialize it: type, challenge, origin, crossOrigin, optional topOrigin and Chrome's extra key,
+// in shuffled orders, with escaped origins.
+func genClientData(r *mrand.Rand, challenge common.Hash) []byte {
+	c := base64.RawURLEncoding.EncodeToString(challenge[:])
+	origins := []string{`"https://sealed.example"`, `"https:\/\/sealed.example"`, `"android:apk-key-hash:Ab_cD-e"`, `"https://xn--sealed-5ya.example:8443"`, `"https://s\u00e9aled.example"`}
+	kv := []string{`"type":"webauthn.get"`, `"challenge":"` + c + `"`, `"origin":` + origins[r.Intn(len(origins))]}
+	if r.Intn(2) == 0 {
+		kv = append(kv, `"crossOrigin":`+[]string{"false", "true"}[r.Intn(2)])
+	}
+	if r.Intn(3) == 0 {
+		kv = append(kv, `"topOrigin":"https://top.example"`)
+	}
+	if r.Intn(3) == 0 {
+		kv = append(kv, `"other_keys_can_be_added_here":"do not compare clientDataJSON against a template. See https://goo.gl/yabPex"`)
+	}
+	if r.Intn(4) == 0 {
+		kv = append(kv, `"tokenBinding":{"status":"supported"}`)
+	}
+	if r.Intn(2) == 0 {
+		r.Shuffle(len(kv), func(i, j int) { kv[i], kv[j] = kv[j], kv[i] })
+	}
+	return []byte("{" + strings.Join(kv, ",") + "}")
+}
+
+// clientDataCase is one entry of chain/testvectors/clientdata-v3.json: the legacy parser accepts
+// every entry; Strict is the rule v3 verdict (packages/shared checks the same file).
+type clientDataCase struct {
+	Category string `json:"category"`
+	Hex      string `json:"hex"`
+	Strict   bool   `json:"strict"`
+}
+
+func loadClientDataCases(t testing.TB) []clientDataCase {
+	path := os.Getenv("SEALED_TESTVECTORS")
+	require.NotEmpty(t, path, "chain/scripts/test.sh sets SEALED_TESTVECTORS")
+	raw, err := os.ReadFile(filepath.Join(filepath.Dir(path), "clientdata-v3.json"))
+	require.NoError(t, err)
+	var f struct {
+		Cases []clientDataCase `json:"cases"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &f))
+	return f.Cases
+}
+
+var divergenceCategories = map[string]bool{
+	"whitespace": true, "escaped-key": true, "escape-in-type": true, "escape-in-challenge": true,
+	"invalid-utf8": true, "exotic-number": true, "depth": true, "too-many-keys": true, "control-in-key": true,
+}
+
+func TestAgentPolicyClientDataDifferential(t *testing.T) {
+	r := mrand.New(mrand.NewSource(1))
+	var ch common.Hash
+	t.Run("completeness: generated clients pass both", func(t *testing.T) {
+		for i := 0; i < 5000; i++ {
+			r.Read(ch[:])
+			cd := genClientData(r, ch)
+			s, l := strictVerdict(cd), legacyVerdict(cd)
+			require.True(t, s.ok, "strict refuses %s", cd)
+			require.True(t, l.ok, "legacy refuses %s", cd)
+			require.Equal(t, l, s)
+		}
+	})
+	t.Run("soundness: mutated corpus", func(t *testing.T) {
+		alphabet := []byte(` {}[]:,"\\/ut0-1.e9naflsr` + "\x00\x1f\x7f\xc3\xa9\xff")
+		for i := 0; i < 50000; i++ {
+			r.Read(ch[:])
+			cd := genClientData(r, ch)
+			for k := r.Intn(4); k >= 0; k-- {
+				p := r.Intn(len(cd) + 1)
+				switch r.Intn(3) {
+				case 0: // insert
+					cd = append(cd[:p], append([]byte{alphabet[r.Intn(len(alphabet))]}, cd[p:]...)...)
+				case 1: // delete
+					if p < len(cd) {
+						cd = append(cd[:p], cd[p+1:]...)
+					}
+				default: // replace
+					if p < len(cd) {
+						cd[p] = alphabet[r.Intn(len(alphabet))]
+					}
+				}
+			}
+			checkSound(t, cd)
+		}
+	})
+	t.Run("shared vectors: golden divergences and accepted clients", func(t *testing.T) {
+		cases := loadClientDataCases(t)
+		require.NotEmpty(t, cases)
+		seen := map[string]int{}
+		for _, e := range cases {
+			cd, err := hex.DecodeString(e.Hex)
+			require.NoError(t, err)
+			require.True(t, legacyVerdict(cd).ok, "legacy must accept %s (%s)", cd, e.Category)
+			if e.Strict {
+				require.Equal(t, legacyVerdict(cd), strictVerdict(cd), "%s", cd)
+				continue
+			}
+			require.True(t, divergenceCategories[e.Category], "uncategorised divergence %q", e.Category)
+			require.False(t, strictVerdict(cd).ok, "strict must refuse %s (%s)", cd, e.Category)
+			seen[e.Category]++
+		}
+		for c := range divergenceCategories {
+			require.Positive(t, seen[c], "no golden entry for category %s", c)
+		}
+	})
+}
+
+func FuzzAgentPolicyClientDataDifferential(f *testing.F) {
+	r := mrand.New(mrand.NewSource(2))
+	var ch common.Hash
+	for i := 0; i < 16; i++ {
+		r.Read(ch[:])
+		f.Add(genClientData(r, ch))
+	}
+	for _, d := range loadClientDataCases(f) {
+		cd, err := hex.DecodeString(d.Hex)
+		require.NoError(f, err)
+		f.Add(cd)
+	}
+	f.Fuzz(func(t *testing.T, cd []byte) {
+		checkSound(t, cd)
+		// The divergence rule in the other direction is allowed (strict refuses more), but the
+		// strict checker must never panic and must agree with checkClientDataV3.
+		var want [43]byte
+		_ = checkClientDataV3(cd, &want)
+	})
+}
