+}
+
+// TestAgentPolicyLegacyParserFujiCorpus replays every clientDataJSON sent to AgentPolicy on Fuji
+// before v3 (exported by services/attacks/src/export-clientdata-corpus.ts) through the legacy
+// parser against its recorded outcome, and records how the strict parser judges it.
+func TestAgentPolicyLegacyParserFujiCorpus(t *testing.T) {
