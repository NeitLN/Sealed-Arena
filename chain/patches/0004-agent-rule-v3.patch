@@ -0,0 +1,294 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package core
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/rawdb"
+	"github.com/ava-labs/libevm/core/types"
+	"github.com/ava-labs/libevm/core/vm"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/evm/utils"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/consensus/dummy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentrulev3"
+)
+
+const arLoosenDelay uint64 = 60
+
+// arConfigV3At schedules rule v2 at t2 and rule v3 at t3 (loosening delay 60 s).
+func arConfigV3At(t2, t3 uint64) *params.ChainConfig {
+	c := arConfigV2At(t2)
+	params.GetExtra(c).GenesisPrecompiles[agentrulev3.ConfigKey] = agentrulev3.NewConfig(utils.PointerTo(t3), arLoosenDelay)
+	return c
+}
+
+func arMandateV3(payees []common.Address, caps []*big.Int, perTx, daily, fee *big.Int, maxPay uint32, expiry uint64) agentpolicy.IAgentPolicyMandateV3 {
+	if caps == nil {
+		caps = make([]*big.Int, len(payees))
+		for i := range caps {
+			caps[i] = agentpolicy.NoPayeeCap
+		}
+	}
+	return agentpolicy.IAgentPolicyMandateV3{Payees: payees, PayeeDailyCaps: caps, PerTxCap: perTx, DailyCap: daily, DailyFeeCap: fee, MaxPaymentsPerDay: maxPay, Expiry: expiry}
+}
+
+func (e *arEnv) setMandateV3Data(m agentpolicy.IAgentPolicyMandateV3) []byte {
+	nonce := new(big.Int).SetUint64(e.ownerNo)
+	auth := e.assertion(agentpolicy.SetMandateV3Challenge(e.domain(), arAgent, m, nonce))
+	data, err := agentpolicy.PackSetMandateV3(agentpolicy.SetMandateV3Input{Agent: arAgent, M: m, Nonce: nonce, Auth: auth})
+	require.NoError(e.t, err)
+	e.ownerNo++
+	return data
+}
+
+// setV3 includes a setMandateV3 in a block `gap` seconds after the head and checks it succeeded.
+func (e *arEnv) setV3(gap uint64, m agentpolicy.IAgentPolicyMandateV3) {
+	e.t.Helper()
+	r := e.good(gap, e.relayerCall(e.setMandateV3Data(m), 2_000_000))
+	require.Equal(e.t, types.ReceiptStatusSuccessful, r[0].Status, "setMandateV3 reverted")
+}
+
+func (e *arEnv) state() *stateReader {
+	st, err := e.chain.State()
+	require.NoError(e.t, err)
+	return &stateReader{st}
+}
+
+type stateReader struct{ AgentRuleState }
+
+func (s *stateReader) payments(ts uint64) uint64 { return agentpolicy.PaymentsToday(s, arAgent, ts) }
+
+func (s *stateReader) payee(p common.Address, ts uint64) *big.Int {
+	return agentpolicy.PayeeSpentToday(s, arAgent, p, ts)
+}
+
+var arBigDaily = new(big.Int).Mul(arCoin, big.NewInt(5))
+
+// newArEnvV3 is a chain with rules v2 and v3 from genesis and the agent registered (no mandate).
+func newArEnvV3(t *testing.T) *arEnv {
+	return newArEnvWith(t, nil, arConfigV3At(0, 0), dummy.NewCoinbaseFaker())
+}
+
+func TestAgentRuleVersionAtV3(t *testing.T) {
+	c := arConfigV3At(20, 40)
+	require.Equal(t, AgentRuleV1, AgentRuleVersionAt(c, 19))
+	require.Equal(t, AgentRuleV2, AgentRuleVersionAt(c, 39))
+	require.Equal(t, AgentRuleV3, AgentRuleVersionAt(c, 40))
+	// A v3 entry without v2 does not make the rule v3 (the config check refuses it anyway).
+	noV2 := arConfig()
+	params.GetExtra(noV2).GenesisPrecompiles[agentrulev3.ConfigKey] = agentrulev3.NewConfig(utils.PointerTo[uint64](0), arLoosenDelay)
+	require.Equal(t, AgentRuleV1, AgentRuleVersionAt(noV2, 100))
+	require.Error(t, params.GetExtra(noV2).Verify())
+}
+
+func TestAgentRuleV3ActivationMarker(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV3At(0, 40), dummy.NewCoinbaseFaker())
+	version := func() uint64 { return agentpolicy.RuleVersion(e.state()) }
+	require.Equal(t, uint64(2), version())
+	e.good(10, e.pay(1)) // t = 20
+	e.good(10, e.pay(1)) // t = 30
+	require.Equal(t, uint64(2), version())
+	require.Zero(t, agentpolicy.LoosenDelay(e.state()))
+	e.good(10, e.pay(1)) // t = 40: activation
+	require.Equal(t, uint64(3), version())
+	require.Equal(t, arLoosenDelay, agentpolicy.LoosenDelay(e.state()))
+	e.checkInvariant()
+}
+
+// v2 and v3 scheduled at the same time: v2 (…02) is configured before v3 (…03) in the block.
+func TestAgentRuleV3SameTimestampAsV2(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV3At(40, 40), dummy.NewCoinbaseFaker())
+	require.Equal(t, uint64(1), agentpolicy.RuleVersion(e.state()))
+	e.good(10, e.pay(1))
+	e.good(10, e.pay(1))
+	e.good(10, e.pay(1)) // t = 40
+	require.Equal(t, uint64(3), agentpolicy.RuleVersion(e.state()))
+}
+
+// A v2 mandate keeps working across the switch, and no v3 counter is written for it.
+func TestAgentRuleV3V2MandateUnchangedAcrossSwitch(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV3At(0, 40), dummy.NewCoinbaseFaker())
+	e.good(10, e.pay(5)) // t = 20, v2
+	e.good(10, e.pay(5)) // t = 30, v2
+	e.good(10, e.pay(5)) // t = 40, v3
+	e.good(10, e.pay(5)) // t = 50, v3
+	st := e.state()
+	require.Zero(t, st.payments(e.head.Time()))
+	require.Zero(t, st.payee(arPayee, e.head.Time()).Sign())
+	require.Equal(t, big.NewInt(20), e.balance(arPayee))
+	e.checkInvariant()
+}
+
+func TestAgentRuleV3PaymentCount(t *testing.T) {
+	e := newArEnvV3(t)
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, nil, arCoin, arBigDaily, arBigDaily, 3, arFarFuture))
+	e.good(10, e.pay(1), e.pay(1), e.pay(1))
+	require.Equal(t, uint64(3), e.state().payments(e.head.Time()))
+	require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentPaymentCountExceeded)
+	// Next UTC day: the count starts again.
+	e.good(86_400, e.pay(1))
+	require.Equal(t, uint64(1), e.state().payments(e.head.Time()))
+	e.checkInvariant()
+
+	// A hand-built block with one payment too many is invalid.
+	e2 := newArEnvV3(t)
+	e2.setV3(10, arMandateV3([]common.Address{arPayee}, nil, arCoin, arBigDaily, arBigDaily, 3, arFarFuture))
+	require.ErrorIs(t, e2.bad(e2.pay(1), e2.pay(1), e2.pay(1), e2.pay(1)), ErrAgentPaymentCountExceeded)
+}
+
+func TestAgentRuleV3PayeeCap(t *testing.T) {
+	e := newArEnvV3(t)
+	e.setV3(10, arMandateV3([]common.Address{arPayee, arStranger}, []*big.Int{big.NewInt(1000), agentpolicy.NoPayeeCap}, arCoin, arBigDaily, arBigDaily, agentpolicy.UnlimitedPayments, arFarFuture))
+	e.good(10, e.pay(600))
+	e.good(10, e.pay(400)) // at the cap
+	require.Equal(t, big.NewInt(1000), e.state().payee(arPayee, e.head.Time()))
+	require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentPayeeBudgetExceeded)
+	// Another payee is unaffected, and an uncapped payee writes no counter.
+	e.good(10, e.agentTx(&arStranger, big.NewInt(5000), arTransfer, nil))
+	require.Zero(t, e.state().payee(arStranger, e.head.Time()).Sign())
+	// Unlimited payments write no count either.
+	require.Zero(t, e.state().payments(e.head.Time()))
+	e.checkInvariant()
+}
+
+// The payee cap counts value only (fees go to the block producer); a zero-value payment counts
+// toward the payment limit.
+func TestAgentRuleV3PayeeCapCountsValueOnly(t *testing.T) {
+	e := newArEnvV3(t)
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, []*big.Int{big.NewInt(1000)}, arCoin, arBigDaily, arBigDaily, 3, arFarFuture))
+	e.good(10, e.pay(1000)) // value 1000 + gas fees: still at the cap
+	require.Equal(t, big.NewInt(1000), e.state().payee(arPayee, e.head.Time()))
+	e.good(10, e.pay(0), e.pay(0))
+	require.Equal(t, uint64(3), e.state().payments(e.head.Time()))
+	require.ErrorIs(t, e.bad(e.pay(0)), ErrAgentPaymentCountExceeded)
+}
+
+// A loosening scheduled for eta applies to the block at eta, with no owner call in between;
+// the day's counters carry over.
+func TestAgentRuleV3PendingAppliesAtEta(t *testing.T) {
+	e := newArEnvV3(t)
+	small := new(big.Int).Div(arCoin, big.NewInt(10))                                                       // perTxCap 0.1 coin
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, nil, small, arBigDaily, arBigDaily, 5, arFarFuture)) // first: at once
+	e.good(10, e.pay(1))
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, nil, arCoin, arBigDaily, arBigDaily, 6, arFarFuture)) // loosening
+	eta := e.head.Time() + arLoosenDelay
+	for e.head.Time()+20 < eta {
+		e.good(10, e.pay(1))
+	}
+	require.Equal(t, uint64(5), e.state().payments(e.head.Time()))
+	over := new(big.Int).Sub(new(big.Int).Mul(small, big.NewInt(2)), arGasCharge)                 // charge = 2 x old perTxCap
+	require.ErrorIs(t, e.bad(e.agentTx(&arPayee, over, arTransfer, nil)), ErrAgentBudgetExceeded) // block at eta-10
+	e.good(10)                                                                                    // head at eta-10
+	r := e.good(10, e.agentTx(&arPayee, over, arTransfer, nil))                                   // block at eta
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	require.Equal(t, eta, e.head.Time())
+	// The day's count carried over: the 6th payment fit the new limit, a 7th does not.
+	require.Equal(t, uint64(6), e.state().payments(e.head.Time()))
+	require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentPaymentCountExceeded)
+	e.checkInvariant()
+}
+
+func TestAgentRuleV3RefusalOrder(t *testing.T) {
+	e := newArEnvV3(t)
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, []*big.Int{big.NewInt(1)}, arCoin, arBigDaily, arBigDaily, 1, arFarFuture))
+	e.good(10, e.pay(1))
+	// Breaks the v2 tip cap, the v3 count and the v3 payee cap: the v2 reason is reported.
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, big.NewInt(5), arTransfer, arFiveGwei, nil, nil)), ErrAgentTipTooHigh)
+	// Breaks the count and the payee cap: the count is checked first.
+	require.ErrorIs(t, e.bad(e.pay(5)), ErrAgentPaymentCountExceeded)
+}
+
+// A node syncing from genesis re-executes blocks from both sides of both switches.
+func TestAgentRuleV3GenesisReplay(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV3At(20, 40), dummy.NewCoinbaseFaker())
+	e.good(10, e.pay(1))                                                                                                             // t = 20 (v2)
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, AgentMaxTip, nil, nil))                                                 // t = 30
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, []*big.Int{big.NewInt(100)}, arCoin, arBigDaily, arBigDaily, 4, arFarFuture)) // t = 40 (v3): tightening
+	e.good(10, e.pay(10), e.pay(10))
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, []*big.Int{big.NewInt(500)}, arCoin, arBigDaily, arBigDaily, 9, arFarFuture)) // loosening
+	e.good(arLoosenDelay)                                                                                                            // the loosening is in force from here
+	for i := 0; i < 7; i++ {
+		e.good(10, e.pay(10))
+	}
+	fresh, err := NewBlockChain(rawdb.NewMemoryDatabase(), DefaultCacheConfig, e.gspec, dummy.NewCoinbaseFaker(), vm.Config{}, common.Hash{}, false)
+	require.NoError(t, err)
+	defer fresh.Stop()
+	var blocks types.Blocks
+	for n := uint64(1); n <= e.head.NumberU64(); n++ {
+		blocks = append(blocks, e.chain.GetBlockByNumber(n))
+	}
+	_, err = fresh.InsertChain(blocks)
+	require.NoError(t, err)
+	require.Equal(t, e.head.Hash(), fresh.CurrentBlock().Hash())
+	st, err := fresh.State()
+	require.NoError(t, err)
+	require.Equal(t, uint64(3), agentpolicy.RuleVersion(st))
+}
+
+// A reorg across a block that charged the v3 counters restores them.
+func TestAgentRuleV3Reorg(t *testing.T) {
+	e := newArEnvV3(t)
+	e.setV3(10, arMandateV3([]common.Address{arPayee}, []*big.Int{big.NewInt(100)}, arCoin, arBigDaily, arBigDaily, 2, arFarFuture))
+	parent := e.head
+	ts := parent.Time() + 10
+	a, _, err := GenerateChain(e.gspec.Config, parent, dummy.NewCoinbaseFaker(), e.gendb, 1, 10, func(_ int, b *BlockGen) { b.AddTx(e.pay(60)) })
+	require.NoError(t, err)
+	e.nonces[arAgent]--
+	b, _, err := GenerateChain(e.gspec.Config, parent, dummy.NewCoinbaseFaker(), e.gendb, 1, 10, func(_ int, b *BlockGen) { b.AddTx(e.pay(30)) })
+	require.NoError(t, err)
+	_, err = e.chain.InsertChain(types.Blocks{a[0]})
+	require.NoError(t, err)
+	_, err = e.chain.InsertChain(types.Blocks{b[0]})
+	require.NoError(t, err)
+
+	require.NoError(t, e.chain.SetPreference(a[0]))
+	require.Equal(t, big.NewInt(60), e.state().payee(arPayee, ts))
+	require.Equal(t, uint64(1), e.state().payments(ts))
+	require.NoError(t, e.chain.SetPreference(b[0]))
+	require.Equal(t, big.NewInt(30), e.state().payee(arPayee, ts))
+	require.NoError(t, e.chain.SetPreference(parent))
+	require.Zero(t, e.state().payee(arPayee, ts).Sign())
+	require.Zero(t, e.state().payments(ts))
+}
+
+// CheckAgentTx calls the pool's Reserved callback only for a registered agent.
+func TestAgentRuleV3ReservedCallbackIsLazy(t *testing.T) {
+	e := newArEnvV3(t)
+	called := 0
+	reserved := func() AgentReserved { called++; return AgentReserved{} }
+	_, applies, err := CheckAgentTx(e.state(), e.head.Time(), AgentTx{From: arStranger, To: &arPayee, Value: common.Big1, GasLimit: arTransfer, GasFeeCap: arFeeCap, Plain: true, Reserved: reserved, Version: AgentRuleV3})
+	require.NoError(t, err)
+	require.False(t, applies)
+	require.Zero(t, called)
+	_, applies, _ = CheckAgentTx(e.state(), e.head.Time(), AgentTx{From: arAgent, To: &arPayee, Value: common.Big1, GasLimit: arTransfer, GasFeeCap: arFeeCap, Plain: true, Reserved: reserved, Version: AgentRuleV3})
+	require.True(t, applies)
+	require.Equal(t, 1, called)
+}
+
+// The pool's pooled transactions count toward every v3 limit (pool only: preCheck has none).
+func TestAgentRuleV3ReservedCountsTowardLimits(t *testing.T) {
+	e := newArEnvV3(t)
+	e.setV3(10, arMandateV3([]common.Address{arPayee, arStranger}, []*big.Int{big.NewInt(100), agentpolicy.NoPayeeCap}, arCoin, arBigDaily, arBigDaily, 3, arFarFuture))
+	ts := e.head.Time() + 1
+	tx := func(to *common.Address, value int64, r AgentReserved) error {
+		_, _, err := CheckAgentTx(e.state(), ts, AgentTx{From: arAgent, To: to, Value: big.NewInt(value), GasLimit: arTransfer, GasFeeCap: arFeeCap, GasTipCap: arTip, TxType: 2, Plain: true, Version: AgentRuleV3,
+			Reserved: func() AgentReserved { return r }})
+		return err
+	}
+	require.NoError(t, tx(&arPayee, 40, AgentReserved{Count: 2, ToPayee: big.NewInt(60)}))
+	require.ErrorIs(t, tx(&arPayee, 41, AgentReserved{Count: 2, ToPayee: big.NewInt(60)}), ErrAgentPayeeBudgetExceeded)
+	require.ErrorIs(t, tx(&arPayee, 1, AgentReserved{Count: 3}), ErrAgentPaymentCountExceeded)
+	require.NoError(t, tx(&arStranger, 1_000, AgentReserved{Count: 2, ToPayee: big.NewInt(1_000_000)}))
+	// The pooled fees count toward the daily fee cap (a pool-only change that also covers v2).
+	fee := new(big.Int).Mul(big.NewInt(int64(arTransfer)), arFeeCap)
+	feeCap := new(big.Int).Sub(arBigDaily, fee)
+	require.NoError(t, tx(&arStranger, 1, AgentReserved{Fee: feeCap, Charge: big.NewInt(1)}))
+	feeCap.Add(feeCap, common.Big1)
+	require.ErrorIs(t, tx(&arStranger, 1, AgentReserved{Fee: feeCap, Charge: big.NewInt(1)}), ErrAgentFeeBudgetExceeded)
+}
