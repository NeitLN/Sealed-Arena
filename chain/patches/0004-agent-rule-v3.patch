+// ---- toolchain ----------------------------------------------------------------------------
+
+// The legacy parser runs on replay of every block before v3, so the encoding/json it is built
+// with must not move: Go 1.26.10, without the jsonv2 experiment.
+func TestAgentPolicyToolchainPinned(t *testing.T) {
