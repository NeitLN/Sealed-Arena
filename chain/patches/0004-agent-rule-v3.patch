+func TestAgentPolicyV3SweepSchedule(t *testing.T) {
+	e := newV3Env(t, true)
+	require.ErrorIs(t, e.sweepWith(v3Rescue, flagsUPUV), ErrNotFrozen)
+	require.NoError(t, e.freezeWith(flagsUP, nil))
+	for _, bad := range []common.Address{
+		{}, e.agent,
+		common.HexToAddress("0x0000000000000000000000000000000000000001"),
+		common.HexToAddress("0x000000000000000000000000000000000000000a"),
+		common.HexToAddress("0x0000000000000000000000000000000000000100"),
+		common.HexToAddress("0x0100000000000000000000000000000000000000"),
+		common.HexToAddress("0x0200000000000000000000000000000000000005"),
+		ContractAddress,
+		common.HexToAddress("0x0300000000000000000000000000000000000003"),
+	} {
+		require.ErrorIs(t, e.sweepWith(bad, flagsUPUV), ErrBadSweepTarget, bad.Hex())
+	}
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	to, eta := pendingSweep(e.db, e.agent)
+	require.Equal(t, v3Rescue, to)
+	require.Equal(t, e.ts+v3Delay, eta)
+	e.ts += 5
+	require.NoError(t, e.sweepWith(v3PayeeB, flagsUPUV))
+	to, eta = pendingSweep(e.db, e.agent)
+	require.Equal(t, v3PayeeB, to, "a second call replaces the first")
+	require.Equal(t, e.ts+v3Delay, eta)
+	p := e.viewPending()
+	require.Equal(t, v3PayeeB, p.SweepTo)
+	require.Equal(t, eta, p.SweepEta)
+}
