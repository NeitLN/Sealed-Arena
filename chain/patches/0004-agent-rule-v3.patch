+
+// ---- harness ---------------------------------------------------------------------------
+
+var (
+	v3NetworkID    uint32 = 12345
+	v3BlockchainID        = [32]byte{0x5e, 0xa1, 0xed}
+	v3PayeeA              = common.HexToAddress("0x00000000000000000000000000000000000000A1")
+	v3PayeeB              = common.HexToAddress("0x00000000000000000000000000000000000000B2")
+	v3PayeeC              = common.HexToAddress("0x00000000000000000000000000000000000000C3")
+	v3Rescue              = common.HexToAddress("0x000000000000000000000000000000000000B0B0")
+	v3Far          uint64 = 4_102_444_800
+	v3Delay        uint64 = 60
+)
+
+// SnowIDs gives the precompile the Avalanche ids of the v2 signing domain in these tests.
+func (*testEnv) SnowIDs() (uint32, [32]byte) { return v3NetworkID, v3BlockchainID }
+
+type v3Env struct {
+	*testEnv
+	t        *testing.T
+	owner    *ecdsa.PrivateKey
+	agentKey *ecdsa.PrivateKey
+	agent    common.Address
+}
+
+// newV3Env registers an agent under rule v2 (marker 2) and, when v3 is set, then activates rule v3
+// (marker 3, loosening delay 60 s) as agentrulev3.Configure does.
+func newV3Env(t *testing.T, v3 bool) *v3Env {
+	t.Helper()
+	e := &v3Env{testEnv: newEnv(t, big.NewInt(261126)), t: t}
+	SetRuleVersion(e.db, 2)
+	owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	e.owner = owner
+	e.agentKey, err = crypto.HexToECDSA(strings.Repeat("11", 32))
+	require.NoError(t, err)
+	e.agent = crypto.PubkeyToAddress(e.agentKey.PublicKey)
+	x, y := p256Pub(owner)
+	sig, err := crypto.Sign(RegisterDigestV2(e.domain(), e.agent, x, y).Bytes(), e.agentKey)
+	require.NoError(t, err)
+	_, err = e.call(t, registerInput(t, e.agent, x, y, sig), false)
+	require.NoError(t, err)
+	if v3 {
+		e.activateV3()
+	}
+	return e
+}
+
+func (e *v3Env) activateV3() {
+	SetLoosenDelay(e.db, v3Delay)
+	SetRuleVersion(e.db, 3)
+}
+
+func (e *v3Env) domain() common.Hash { return DomainV2(v3NetworkID, v3BlockchainID, e.chainID) }
+
+func (e *v3Env) nonce() *big.Int {
+	return new(big.Int).SetUint64(ownerNonceOf(e.t, e.testEnv, e.agent))
+}
+
+func (e *v3Env) epoch() *big.Int { return new(big.Int).SetUint64(FreezeEpoch(e.db, e.agent)) }
+
+func stdClientData(challenge common.Hash) []byte {
+	return []byte(`{"type":"webauthn.get","challenge":"` + base64.RawURLEncoding.EncodeToString(challenge[:]) + `","origin":"https://sealed.example","crossOrigin":false}`)
+}
+
+// signAssertion signs authData || sha256(clientData) with key, s in the lower half.
+func signAssertion(t *testing.T, key *ecdsa.PrivateKey, authData, clientData []byte) []byte {
+	t.Helper()
+	ch := sha256.Sum256(clientData)
+	digest := sha256.Sum256(append(append([]byte{}, authData...), ch[:]...))
+	r, s, err := ecdsa.Sign(rand.Reader, key, digest[:])
+	require.NoError(t, err)
+	if s.Cmp(p256HalfN) > 0 {
+		s.Sub(elliptic.P256().Params().N, s)
+	}
+	return mustPack(authArgs, authData, clientData, [32]byte(common.BigToHash(r)), [32]byte(common.BigToHash(s)))
+}
+
+const (
+	flagsUP   byte = 0x01
+	flagsUPUV byte = 0x05
+)
+
+// authWith signs `challenge` with the owner passkey, the given authenticator flags and (when cd is
+// nil) a standard clientDataJSON.
+func (e *v3Env) authWith(challenge common.Hash, flags byte, cd []byte) []byte {
+	if cd == nil {
+		cd = stdClientData(challenge)
+	}
+	return signAssertion(e.t, e.owner, append(make([]byte, 32), flags, 0, 0, 0, 1), cd)
+}
+
+func (e *v3Env) auth(challenge common.Hash) []byte { return e.authWith(challenge, flagsUPUV, nil) }
+
+func (e *v3Env) run(in []byte, err error) error {
+	require.NoError(e.t, err)
+	_, err = e.call(e.t, in, false)
+	return err
+}
+
+func mv3(payees []common.Address, caps []*big.Int, perTx, daily, fee int64, maxPay uint32, expiry uint64) IAgentPolicyMandateV3 {
+	if caps == nil {
+		caps = make([]*big.Int, len(payees))
+		for i := range caps {
+			caps[i] = NoPayeeCap
+		}
+	}
+	return IAgentPolicyMandateV3{Payees: payees, PayeeDailyCaps: caps, PerTxCap: big.NewInt(perTx), DailyCap: big.NewInt(daily), DailyFeeCap: big.NewInt(fee), MaxPaymentsPerDay: maxPay, Expiry: expiry}
+}
+
+func (e *v3Env) setV3With(m IAgentPolicyMandateV3, flags byte) error {
+	n := e.nonce()
+	return e.run(PackSetMandateV3(SetMandateV3Input{Agent: e.agent, M: m, Nonce: n, Auth: e.authWith(SetMandateV3Challenge(e.domain(), e.agent, m, n), flags, nil)}))
+}
+
+func (e *v3Env) setV3(m IAgentPolicyMandateV3) error { return e.setV3With(m, flagsUPUV) }
+
+func (e *v3Env) setV2(m IAgentPolicyMandateV2) error {
+	n := e.nonce()
+	return e.run(PackSetMandateV2(SetMandateV2Input{Agent: e.agent, M: m, Nonce: n, Auth: e.auth(SetMandateV2Challenge(e.domain(), e.agent, m, n))}))
+}
+
+func (e *v3Env) cancelWith(flags byte) error {
+	n := e.nonce()
+	return e.run(PackCancelPending(CancelPendingInput{Agent: e.agent, Nonce: n, Auth: e.authWith(CancelPendingChallenge(e.domain(), e.agent, n), flags, nil)}))
+}
+
+func (e *v3Env) setGuardianWith(g common.Address, flags byte) error {
+	n := e.nonce()
+	return e.run(PackSetGuardian(SetGuardianInput{Agent: e.agent, Guardian: g, Nonce: n, Auth: e.authWith(SetGuardianChallenge(e.domain(), e.agent, g, n), flags, nil)}))
+}
+
+func (e *v3Env) freezeWith(flags byte, cd func(common.Hash) []byte) error {
+	ep := e.epoch()
+	ch := FreezeChallengeV2(e.domain(), e.agent, ep)
+	var c []byte
+	if cd != nil {
+		c = cd(ch)
+	}
+	return e.run(PackFreeze(FreezeInput{Agent: e.agent, Nonce: ep, Auth: e.authWith(ch, flags, c)}))
+}
+
+func (e *v3Env) unfreezeWith(flags byte) error {
+	n := e.nonce()
+	return e.run(PackUnfreeze(UnfreezeInput{Agent: e.agent, Nonce: n, Auth: e.authWith(UnfreezeChallengeV2(e.domain(), e.agent, n, e.epoch()), flags, nil)}))
+}
+
+func (e *v3Env) sweepWith(to common.Address, flags byte) error {
+	n := e.nonce()
+	return e.run(PackSweep(SweepInput{Agent: e.agent, To: to, Nonce: n, Auth: e.authWith(SweepChallenge(e.domain(), e.agent, to, n, e.epoch()), flags, nil)}))
+}
+
+func (e *v3Env) executeSweep() error { return e.run(PackExecuteSweep(e.agent)) }
+
+func (e *v3Env) guardianFreeze(key *ecdsa.PrivateKey, epoch *big.Int) error {
+	sig, err := crypto.Sign(GuardianFreezeDigest(e.domain(), e.agent, epoch).Bytes(), key)
+	require.NoError(e.t, err)
+	return e.run(PackGuardianFreeze(GuardianFreezeInput{Agent: e.agent, Epoch: epoch, Sig: sig}))
+}
+
+func (e *v3Env) viewM() GetMandateV3Output {
+	in, err := PackGetMandateV3(e.agent)
+	require.NoError(e.t, err)
+	ret, err := e.call(e.t, in, true)
+	require.NoError(e.t, err)
+	out, err := UnpackGetMandateV3Output(ret)
+	require.NoError(e.t, err)
+	return out
+}
+
+func (e *v3Env) viewPending() GetPendingOutput {
+	in, err := PackGetPending(e.agent)
+	require.NoError(e.t, err)
+	ret, err := e.call(e.t, in, true)
+	require.NoError(e.t, err)
+	out, err := UnpackGetPendingOutput(ret)
+	require.NoError(e.t, err)
+	return out
+}
+
+func (e *v3Env) viewCounters() GetCountersOutput {
+	in, err := PackGetCounters(e.agent)
+	require.NoError(e.t, err)
+	ret, err := e.call(e.t, in, true)
+	require.NoError(e.t, err)
+	out, err := UnpackGetCountersOutput(ret)
+	require.NoError(e.t, err)
+	return out
+}
+
+func (e *v3Env) spend() GetSpendOutput {
+	in, err := PackGetSpend(e.agent)
+	require.NoError(e.t, err)
+	ret, err := e.call(e.t, in, true)
+	require.NoError(e.t, err)
+	out, err := UnpackGetSpendOutput(ret)
+	require.NoError(e.t, err)
+	return out
+}
+
+func (e *v3Env) frozen() bool { return isFrozen(e.db, e.agent) }
+
+func requireMandate(t *testing.T, want, got IAgentPolicyMandateV3) {
+	t.Helper()
+	require.Equal(t, want.Payees, got.Payees)
+	require.Len(t, got.PayeeDailyCaps, len(want.PayeeDailyCaps))
+	for i := range want.PayeeDailyCaps {
+		require.Zero(t, want.PayeeDailyCaps[i].Cmp(got.PayeeDailyCaps[i]), "cap %d: want %s got %s", i, want.PayeeDailyCaps[i], got.PayeeDailyCaps[i])
+	}
+	require.Zero(t, want.PerTxCap.Cmp(got.PerTxCap), "perTx")
+	require.Zero(t, want.DailyCap.Cmp(got.DailyCap), "daily")
+	require.Zero(t, want.DailyFeeCap.Cmp(got.DailyFeeCap), "fee")
+	require.Equal(t, want.MaxPaymentsPerDay, got.MaxPaymentsPerDay)
+	require.Equal(t, want.Expiry, got.Expiry)
+}
+
+// ---- activation, views ------------------------------------------------------------------
+
+func TestAgentPolicyV3SelectorsInactiveBeforeMarker3(t *testing.T) {
+	e := newV3Env(t, false)
+	names := []string{"setMandateV3", "cancelPending", "setGuardian", "guardianFreeze", "sweep", "executeSweep",
+		"getMandateV3", "getPending", "getCounters", "getPayeeSpend", "guardian", "loosenDelay"}
+	require.Len(t, v3Functions, len(names))
+	for _, name := range names {
+		m, ok := AgentPolicyABI.Methods[name]
+		require.True(t, ok, name)
+		input := append(append([]byte{}, m.ID...), make([]byte, 32*8)...)
+		_, err := e.call(t, input, false)
+		require.ErrorIs(t, err, contract.ErrInvalidNonActivatedFunctionSelector, name)
+	}
+	e.activateV3()
+	in, err := PackLoosenDelay()
+	require.NoError(t, err)
+	ret, err := e.call(t, in, true)
+	require.NoError(t, err)
+	require.Equal(t, v3Delay, new(big.Int).SetBytes(ret).Uint64())
+}
+
+func TestAgentPolicyV3SetMandateV2Refused(t *testing.T) {
+	e := newV3Env(t, false)
+	m2 := IAgentPolicyMandateV2{Payees: []common.Address{v3PayeeA}, PerTxCap: big.NewInt(10), DailyCap: big.NewInt(100), DailyFeeCap: big.NewInt(50), Expiry: v3Far}
+	require.NoError(t, e.setV2(m2))
+	e.activateV3()
+	require.ErrorIs(t, e.setV2(m2), ErrUseSetMandateV3)
+}
+
+func TestAgentPolicyV3GetMandateProjections(t *testing.T) {
+	e := newV3Env(t, true)
+	m := mv3([]common.Address{v3PayeeA, v3PayeeB}, []*big.Int{big.NewInt(40), NoPayeeCap}, 10, 100, 50, 7, v3Far)
+	require.NoError(t, e.setV3(m))
+	requireMandate(t, m, e.viewM().M)
+	v1 := mandateOf(t, e.testEnv, e.agent)
+	require.Equal(t, m.Payees, v1.M.Payees)
+	require.Equal(t, int64(100), v1.M.DailyCap.Int64())
+	in, err := PackGetMandateV2(e.agent)
+	require.NoError(t, err)
+	ret, err := e.call(t, in, true)
+	require.NoError(t, err)
+	v2, err := UnpackGetMandateV2Output(ret)
+	require.NoError(t, err)
+	require.True(t, v2.FeeCapSet)
+	require.Equal(t, int64(50), v2.M.DailyFeeCap.Int64())
+
+	// A v2 mandate seen through getMandateV3: no payee caps, unlimited payments.
+	e2 := newV3Env(t, false)
+	require.NoError(t, e2.setV2(IAgentPolicyMandateV2{Payees: []common.Address{v3PayeeA}, PerTxCap: big.NewInt(10), DailyCap: big.NewInt(100), DailyFeeCap: big.NewInt(30), Expiry: v3Far}))
+	e2.activateV3()
+	requireMandate(t, mv3([]common.Address{v3PayeeA}, nil, 10, 100, 30, UnlimitedPayments, v3Far), e2.viewM().M)
+}
+
+// ---- mandate and timelock ---------------------------------------------------------------
+
+func TestAgentPolicyV3SetMandateValidation(t *testing.T) {
+	e := newV3Env(t, true)
+	many := make([]common.Address, MaxPayees+1)
+	for i := range many {
+		many[i] = common.BigToAddress(big.NewInt(int64(0x1000 + i)))
+	}
+	for _, tc := range []struct {
+		name string
+		m    IAgentPolicyMandateV3
+		err  error
+	}{
+		{"too many payees", mv3(many, nil, 1, 1, 1, 1, v3Far), ErrTooManyPayees},
+		{"caps length", mv3([]common.Address{v3PayeeA}, []*big.Int{}, 1, 1, 1, 1, v3Far), ErrPayeeCapsLength},
+		{"duplicate payee", mv3([]common.Address{v3PayeeA, v3PayeeA}, nil, 1, 1, 1, 1, v3Far), ErrDuplicatePayee},
+		{"perTx above daily", mv3([]common.Address{v3PayeeA}, nil, 2, 1, 1, 1, v3Far), ErrPerTxAboveDaily},
+		{"fee above daily", mv3([]common.Address{v3PayeeA}, nil, 1, 1, 2, 1, v3Far), ErrFeeCapAboveDaily},
+		{"payee cap above daily", mv3([]common.Address{v3PayeeA}, []*big.Int{big.NewInt(101)}, 1, 100, 1, 1, v3Far), ErrPayeeCapTooLarge},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			require.ErrorIs(t, e.setV3(tc.m), tc.err)
+			require.Equal(t, uint64(0), e.nonce().Uint64())
+		})
+	}
