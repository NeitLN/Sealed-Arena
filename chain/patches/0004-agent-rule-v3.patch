+func TestAgentPolicyV3GetSpendIncludesSwept(t *testing.T) {
+	e := newV3Env(t, true)
+	require.NoError(t, ChargeSpend(e.db, e.agent, big.NewInt(300), e.ts))
+	e.fund(700)
+	require.Equal(t, int64(300), e.spend().TotalCharged.Int64())
+	require.NoError(t, e.freezeWith(flagsUP, nil))
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	e.ts += v3Delay
+	require.NoError(t, e.executeSweep())
+	require.Equal(t, int64(1_000), e.spend().TotalCharged.Int64(), "getSpend third value = charged + swept")
+	c := e.viewCounters()
+	require.Equal(t, int64(300), c.TotalCharged.Int64())
+	require.Equal(t, int64(700), c.TotalSwept.Int64())
+}
+
+func TestAgentPolicyV3SweepInvariant(t *testing.T) {
+	e := newV3Env(t, true)
+	funded := uint64(0)
+	check := func() {
+		t.Helper()
+		floor := new(big.Int).Sub(new(big.Int).SetUint64(funded), e.spend().TotalCharged)
+		require.GreaterOrEqual(t, new(big.Int).SetUint64(e.bal(e.agent)).Cmp(floor), 0)
+	}
+	e.fund(1_000)
+	funded += 1_000
+	check()
+	// pay 200 (charged 250: the gas is counted at its cap, 30 refunded later)
+	require.NoError(t, ChargeSpend(e.db, e.agent, big.NewInt(250), e.ts))
+	e.db.SubBalance(e.agent, uint256.NewInt(220))
+	check()
+	require.NoError(t, e.freezeWith(flagsUP, nil))
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	e.ts += v3Delay
+	require.NoError(t, e.executeSweep())
+	check()
+	e.fund(30) // a refund arrives
+	funded += 30
+	check()
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	e.ts += v3Delay
+	require.NoError(t, e.executeSweep())
+	check()
+	require.Equal(t, uint64(810), e.bal(v3Rescue))
+}
