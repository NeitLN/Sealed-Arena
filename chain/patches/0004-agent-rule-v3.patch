@@ -0,0 +1,85 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentrulev3
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/rawdb"
+	"github.com/ava-labs/libevm/core/state"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/evm/utils"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/core/extstate"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params/extras"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentrulev2"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/modules"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+func TestAgentRuleV3ConfigVerify(t *testing.T) {
+	require.NoError(t, NewConfig(utils.PointerTo[uint64](100), 86400).Verify(nil))
+	require.NoError(t, NewConfig(utils.PointerTo[uint64](100), MinLoosenDelay).Verify(nil))
+	require.NoError(t, NewConfig(utils.PointerTo[uint64](100), MaxLoosenDelay).Verify(nil))
+	require.ErrorIs(t, NewConfig(utils.PointerTo[uint64](100), MinLoosenDelay-1).Verify(nil), ErrLoosenDelay)
+	require.ErrorIs(t, NewConfig(utils.PointerTo[uint64](100), MaxLoosenDelay+1).Verify(nil), ErrLoosenDelay)
+	require.ErrorIs(t, NewConfig(utils.PointerTo[uint64](100), 0).Verify(nil), ErrLoosenDelay, "loosenDelay is required")
+	disable := &Config{Upgrade: precompileconfig.Upgrade{BlockTimestamp: utils.PointerTo[uint64](200), Disable: true}, LoosenDelay: 86400}
+	require.ErrorIs(t, disable.Verify(nil), ErrDisableNotAllowed)
+}
+
+func TestAgentRuleV3ConfigEqual(t *testing.T) {
+	a := NewConfig(utils.PointerTo[uint64](100), 86400)
+	require.True(t, a.Equal(NewConfig(utils.PointerTo[uint64](100), 86400)))
+	require.False(t, a.Equal(NewConfig(utils.PointerTo[uint64](101), 86400)))
+	require.False(t, a.Equal(NewConfig(utils.PointerTo[uint64](100), 86401)))
+	require.Equal(t, ConfigKey, a.Key())
+
+	var c Config
+	require.NoError(t, json.Unmarshal([]byte(`{"blockTimestamp":1795086000,"loosenDelay":86400}`), &c))
+	require.Equal(t, uint64(86400), c.LoosenDelay)
+	require.Equal(t, uint64(1795086000), *c.BlockTimestamp)
+}
+
+func newState(t *testing.T) *extstate.StateDB {
+	raw, err := state.New(common.Hash{}, state.NewDatabase(rawdb.NewMemoryDatabase()), nil)
+	require.NoError(t, err)
+	return extstate.New(raw)
+}
+
+func TestAgentRuleV3ConfigureRequiresV2(t *testing.T) {
+	st := newState(t)
+	cfg := NewConfig(utils.PointerTo[uint64](0), 120)
+	require.ErrorIs(t, Module.Configure(nil, cfg, st, nil), ErrV2NotActive, "marker 1")
+	require.Equal(t, uint64(1), agentpolicy.RuleVersion(st))
+	require.Zero(t, agentpolicy.LoosenDelay(st))
+
+	agentpolicy.SetRuleVersion(st, 2)
+	require.NoError(t, Module.Configure(nil, cfg, st, nil))
+	require.Equal(t, uint64(3), agentpolicy.RuleVersion(st))
+	require.Equal(t, uint64(120), agentpolicy.LoosenDelay(st))
+	require.ErrorIs(t, Module.Configure(nil, cfg, st, nil), ErrV2NotActive, "marker 3 is not re-activated")
+}
+
+// params/extras checks the order with the keys written out; they must match the modules'.
+func TestAgentRuleV3ConfigKeysMatchExtras(t *testing.T) {
+	require.Equal(t, agentrulev2.ConfigKey, extras.AgentRuleV2ConfigKey)
+	require.Equal(t, ConfigKey, extras.AgentRuleV3ConfigKey)
+}
+
+// Activation configures modules in address order, so rule v2 (…02) is configured before rule v3
+// (…03) when both activate in the same block.
+func TestAgentRuleV3ModuleOrder(t *testing.T) {
+	idx := map[common.Address]int{}
+	for i, m := range modules.RegisteredModules() {
+		idx[m.Address] = i
+	}
+	i2, ok2 := idx[agentrulev2.ContractAddress]
+	i3, ok3 := idx[ContractAddress]
+	require.True(t, ok2)
+	require.True(t, ok3)
+	require.Less(t, i2, i3)
+}
diff --git a/graft/subnet-evm/precompile/contracts/agentrulev3/module.go b/graft/subnet-evm/precompile/contracts/agentrulev3/module.go
new file mode 100644
index 0000000..39bdf61
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentrulev3/module.go
@@ -0,0 +1,88 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+// Package agentrulev3 activates version 3 of the Sealed Arena agent rule. Like agentrulev2 it is
+// a config-only precompile with no functions: scheduling "agentRuleV3Config" in
+// precompileUpgrades at a timestamp T makes the rule v3 from T on, so blocks before T keep their
+// v2 meaning when a node re-executes history. It carries one parameter, loosenDelay (seconds), the
+// delay before a loosening of a mandate takes effect. Activation is one-way and requires rule v2
+// to be active first (params/extras checks the order in the config; Configure checks the marker).
+package agentrulev3
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/ava-labs/libevm/common"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/modules"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+var _ contract.Configurator = (*configurator)(nil)
+
+// ConfigKey is the key used in json config files to schedule rule v3.
+const ConfigKey = "agentRuleV3Config"
+
+// ContractAddress is the address of the marker precompile, after agentrulev2's. Modules are
+// configured in address order, so at a shared timestamp rule v2 is configured first.
+var ContractAddress = common.HexToAddress("0x0300000000000000000000000000000000000003")
+
+var (
+	// ErrDisableNotAllowed is returned by Verify for an upgrade that disables rule v3.
+	ErrDisableNotAllowed = errors.New("agentrulev3: rule v3 cannot be disabled once scheduled")
+	// ErrLoosenDelay is returned by Verify for a loosening delay outside [MinLoosenDelay, MaxLoosenDelay].
+	ErrLoosenDelay = errors.New("agentrulev3: loosenDelay out of range")
+	// ErrV2NotActive is returned by Configure when the rule v2 marker is not in state.
+	ErrV2NotActive = errors.New("agentrulev3: rule v2 is not active")
+)
+
+// Bounds of the loosening delay (seconds).
+const (
+	MinLoosenDelay uint64 = 60
+	MaxLoosenDelay uint64 = 30 * 24 * 3600
+)
+
+// Contract has no functions; any call to it fails.
+var Contract = func() contract.StatefulPrecompiledContract {
+	c, err := contract.NewStatefulPrecompileContract(nil, nil)
+	if err != nil {
+		panic(err)
+	}
+	return c
+}()
+
+// Module registers the precompile.
+var Module = modules.Module{
+	ConfigKey:    ConfigKey,
+	Address:      ContractAddress,
+	Contract:     Contract,
+	Configurator: &configurator{},
+}
+
+type configurator struct{}
+
+func init() {
+	if err := modules.RegisterModule(Module); err != nil {
+		panic(err)
+	}
+}
+
+func (*configurator) MakeConfig() precompileconfig.Config { return new(Config) }
+
+// Configure writes the loosening delay and then the rule version 3 into AgentPolicy's storage at
+// activation, before any transaction of the activating block. It refuses (and so halts the block)
+// unless the rule v2 marker is already there: the last guard behind the config order check.
+func (*configurator) Configure(_ precompileconfig.ChainConfig, cfg precompileconfig.Config, state contract.StateDB, _ contract.ConfigurationBlockContext) error {
+	c, ok := cfg.(*Config)
+	if !ok {
+		return fmt.Errorf("expected config type %T, got %T: %v", &Config{}, cfg, cfg)
+	}
+	if agentpolicy.RuleVersion(state) != 2 {
+		return ErrV2NotActive
+	}
+	agentpolicy.SetLoosenDelay(state, c.LoosenDelay)
+	agentpolicy.SetRuleVersion(state, 3)
+	return nil
+}
