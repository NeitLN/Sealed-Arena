+func FuzzAgentPolicyMeet(f *testing.F) {
+	f.Add(make([]byte, 24), true)
+	f.Add([]byte("0123456789abcdefghijklmn"), false)
+	f.Fuzz(func(t *testing.T, seed []byte, ev3 bool) {
+		if len(seed) < 24 {
+			return
+		}
+		checkMeetProperties(t, randMandate(nil, seed[:12], ev3), randMandate(nil, seed[12:24], true))
+	})
+}
