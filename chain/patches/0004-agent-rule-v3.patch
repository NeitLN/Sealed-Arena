@@ -0,0 +1,55 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package extras
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/evm/utils"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+// orderTestConfig is a minimal config with a key: the order check reads only Key, Timestamp and
+// IsDisabled.
+type orderTestConfig struct {
+	precompileconfig.Upgrade
+	key string
+}
+
+func (c *orderTestConfig) Key() string                             { return c.key }
+func (*orderTestConfig) Verify(precompileconfig.ChainConfig) error { return nil }
+func (c *orderTestConfig) Equal(o precompileconfig.Config) bool    { return false }
+func at(key string, ts uint64) *orderTestConfig {
+	return &orderTestConfig{Upgrade: precompileconfig.Upgrade{BlockTimestamp: utils.PointerTo(ts)}, key: key}
+}
+
+func TestAgentRuleOrder(t *testing.T) {
+	cases := []struct {
+		name     string
+		genesis  Precompiles
+		upgrades []PrecompileUpgrade
+		ok       bool
+	}{
+		{"v2 only", Precompiles{AgentRuleV2ConfigKey: at(AgentRuleV2ConfigKey, 10)}, nil, true},
+		{"neither", Precompiles{}, nil, true},
+		{"v3 without v2", Precompiles{AgentRuleV3ConfigKey: at(AgentRuleV3ConfigKey, 10)}, nil, false},
+		{"v3 before v2", Precompiles{AgentRuleV2ConfigKey: at(AgentRuleV2ConfigKey, 20)}, []PrecompileUpgrade{{Config: at(AgentRuleV3ConfigKey, 10)}}, false},
+		{"equal timestamps", Precompiles{AgentRuleV2ConfigKey: at(AgentRuleV2ConfigKey, 0), AgentRuleV3ConfigKey: at(AgentRuleV3ConfigKey, 0)}, nil, true},
+		{"v3 after v2 in upgrades", nil, []PrecompileUpgrade{{Config: at(AgentRuleV2ConfigKey, 10)}, {Config: at(AgentRuleV3ConfigKey, 30)}}, true},
+		{"v3 upgrade, v2 genesis", Precompiles{AgentRuleV2ConfigKey: at(AgentRuleV2ConfigKey, 0)}, []PrecompileUpgrade{{Config: at(AgentRuleV3ConfigKey, 30)}}, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c := &ChainConfig{GenesisPrecompiles: tc.genesis}
+			c.PrecompileUpgrades = tc.upgrades
+			err := c.verifyAgentRuleOrder()
+			if tc.ok {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, errAgentRuleOrder)
+			}
+		})
+	}
+}
