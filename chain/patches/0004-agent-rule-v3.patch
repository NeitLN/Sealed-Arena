+func TestAgentPolicyV3SettleFlipsGeneration(t *testing.T) {
+	e := newV3Env(t, true)
+	base := mv3([]common.Address{v3PayeeA}, nil, 10, 100, 50, 5, v3Far)
+	require.NoError(t, e.setV3(base))
+	looser := mv3([]common.Address{v3PayeeA, v3PayeeB}, nil, 10, 200, 50, 5, v3Far)
+	require.NoError(t, e.setV3(looser))
+	e.ts += v3Delay
+	before := e.viewM().M
+	requireMandate(t, looser, before)
+	_, activeBefore := readLifecycle(e.db, e.agent)
+
+	// The settle a later owner call does is one lifecycle write, and reads stay the same.
+	cs := &countingState{StateDB: e.db}
+	flags := getUint64(cs, e.agent, fieldFlags)
+	eta, active, due := lifecycleAt(cs, e.agent, flags, e.ts)
+	require.True(t, due)
+	writeLifecycle(cs, e.agent, eta, active)
+	require.Equal(t, 1, cs.writes)
+	require.Equal(t, 1-activeBefore, active)
+	requireMandate(t, before, e.viewM().M)
+	require.Zero(t, e.viewPending().MandateEta)
+}
