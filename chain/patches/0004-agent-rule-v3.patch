+		{"literals and ints", `{"type":"webauthn.get","challenge":"` + c + `","a":true,"b":false,"c":null,"d":-0,"e":123456789012345}`, nil},
+		{"wrong type", `{"type":"webauthn.create","challenge":"` + c + `"}`, ErrBadClientDataType},
+		{"wrong challenge", `{"type":"webauthn.get","challenge":"` + strings.Repeat("A", 43) + `"}`, ErrChallengeMismatch},
+		{"padded challenge", `{"type":"webauthn.get","challenge":"` + padded + `"}`, ErrChallengeMismatch},
+		{"leading whitespace", ` {"type":"webauthn.get","challenge":"` + c + `"}`, ErrBadClientData},
+		{"whitespace between tokens", `{"type": "webauthn.get","challenge":"` + c + `"}`, ErrBadClientData},
+		{"trailing bytes", `{"type":"webauthn.get","challenge":"` + c + `"}x`, ErrBadClientData},
+		{"trailing newline", `{"type":"webauthn.get","challenge":"` + c + `"}` + "\n", ErrBadClientData},
+		{"duplicate key", `{"type":"webauthn.get","challenge":"` + c + `","type":"webauthn.get"}`, ErrBadClientData},
