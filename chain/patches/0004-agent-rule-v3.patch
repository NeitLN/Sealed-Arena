+		{"too deep", `{"type":"webauthn.get","challenge":"` + c + `","x":{"a":[{"b":[1]}]}}`, ErrBadClientData},
+		{"17 keys", `{"type":"webauthn.get","challenge":"` + c + `","a":1,"b":1,"c":1,"d":1,"e":1,"f":1,"g":1,"h":1,"i":1,"j":1,"k":1,"l":1,"m":1,"n":1,"o":1}`, ErrBadClientData},
+		{"16 keys", `{"type":"webauthn.get","challenge":"` + c + `","a":1,"b":1,"c":1,"d":1,"e":1,"f":1,"g":1,"h":1,"i":1,"j":1,"k":1,"l":1,"m":1,"n":1}`, nil},
+		{"key with non-ascii", "{\"t\xc3\xa9\":1,\"type\":\"webauthn.get\",\"challenge\":\"" + c + "\"}", ErrBadClientData},
