+func TestAgentPolicyV3PendingReplacedAndCancelled(t *testing.T) {
+	e := newV3Env(t, true)
+	base := mv3([]common.Address{v3PayeeA}, nil, 10, 100, 50, 5, v3Far)
+	require.NoError(t, e.setV3(base))
+	require.ErrorIs(t, e.cancelWith(flagsUPUV), ErrNoPending)
+
+	l1 := mv3(base.Payees, nil, 10, 200, 50, 5, v3Far)
+	require.NoError(t, e.setV3(l1))
+	e.ts += 10
+	l2 := mv3(base.Payees, nil, 10, 300, 50, 5, v3Far)
+	require.NoError(t, e.setV3(l2))
+	p := e.viewPending()
+	require.Equal(t, e.ts+v3Delay, p.MandateEta, "a second set replaces the first and restarts the delay")
+	requireMandate(t, l2, p.M)
+
+	// A pure tightening clears the pending loosening.
+	tight := mv3(base.Payees, nil, 10, 90, 50, 5, v3Far)
+	require.NoError(t, e.setV3(tight))
+	require.Zero(t, e.viewPending().MandateEta)
+	e.ts += 2 * v3Delay
+	requireMandate(t, tight, e.viewM().M)
+
+	// cancelPending clears a loosening; nothing pending after.
+	require.NoError(t, e.setV3(l1))
+	require.NoError(t, e.cancelWith(flagsUPUV))
+	require.Zero(t, e.viewPending().MandateEta)
+	e.ts += 2 * v3Delay
+	requireMandate(t, tight, e.viewM().M)
+	require.ErrorIs(t, e.cancelWith(flagsUPUV), ErrNoPending)
+
+	// A loosening already in force cannot be cancelled.
+	require.NoError(t, e.setV3(l1))
+	e.ts += v3Delay
+	require.ErrorIs(t, e.cancelWith(flagsUPUV), ErrNoPending)
+	requireMandate(t, l1, e.viewM().M)
+}
