+func TestAgentPolicyV3UnfreezeAndCancelClearSweep(t *testing.T) {
+	e := newV3Env(t, true)
+	e.fund(10)
+	require.NoError(t, e.freezeWith(flagsUP, nil))
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	require.NoError(t, e.unfreezeWith(flagsUPUV))
+	_, eta := pendingSweep(e.db, e.agent)
+	require.Zero(t, eta, "unfreeze clears the sweep")
+	require.NoError(t, e.freezeWith(flagsUP, nil))
+	e.ts += v3Delay
+	require.ErrorIs(t, e.executeSweep(), ErrNoPendingSweep)
+
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	require.NoError(t, e.cancelWith(flagsUPUV))
+	_, eta = pendingSweep(e.db, e.agent)
+	require.Zero(t, eta, "cancelPending clears the sweep")
+}
