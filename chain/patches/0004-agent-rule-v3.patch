+func TestAgentPolicyV3MeetAndSchedule(t *testing.T) {
+	base := mv3([]common.Address{v3PayeeA, v3PayeeB}, []*big.Int{big.NewInt(40), NoPayeeCap}, 10, 100, 50, 5, v3Far)
+	for _, tc := range []struct {
+		name    string
+		n       IAgentPolicyMandateV3
+		now     IAgentPolicyMandateV3 // in force right after the call
+		pending bool
+	}{
+		{"pure tightening", mv3([]common.Address{v3PayeeA}, []*big.Int{big.NewInt(30)}, 5, 90, 40, 4, v3Far-1),
+			mv3([]common.Address{v3PayeeA}, []*big.Int{big.NewInt(30)}, 5, 90, 40, 4, v3Far-1), false},
+		{"same mandate", base, base, false},
+		{"pure loosening: dailyCap", mv3(base.Payees, base.PayeeDailyCaps, 10, 200, 50, 5, v3Far), base, true},
+		{"loosening: perTx", mv3(base.Payees, base.PayeeDailyCaps, 11, 100, 50, 5, v3Far), base, true},
+		{"loosening: fee cap", mv3(base.Payees, base.PayeeDailyCaps, 10, 100, 60, 5, v3Far), base, true},
+		{"loosening: expiry", mv3(base.Payees, base.PayeeDailyCaps, 10, 100, 50, 5, v3Far+1), base, true},
+		{"loosening: payment count", mv3(base.Payees, base.PayeeDailyCaps, 10, 100, 50, 6, v3Far), base, true},
+		{"added payee waits", mv3([]common.Address{v3PayeeA, v3PayeeB, v3PayeeC}, []*big.Int{big.NewInt(40), NoPayeeCap, NoPayeeCap}, 10, 100, 50, 5, v3Far), base, true},
+		{"payee cap finite to max waits", mv3(base.Payees, []*big.Int{NoPayeeCap, NoPayeeCap}, 10, 100, 50, 5, v3Far), base, true},
+		{"payee cap max to finite now", mv3(base.Payees, []*big.Int{big.NewInt(40), big.NewInt(20)}, 10, 100, 50, 5, v3Far),
+			mv3(base.Payees, []*big.Int{big.NewInt(40), big.NewInt(20)}, 10, 100, 50, 5, v3Far), false},
+		{"mixed: lower daily, higher perTx", mv3(base.Payees, base.PayeeDailyCaps, 20, 80, 50, 5, v3Far),
+			mv3(base.Payees, base.PayeeDailyCaps, 10, 80, 50, 5, v3Far), true},
+		{"mixed: drop payee B, raise A's cap", mv3([]common.Address{v3PayeeA}, []*big.Int{big.NewInt(90)}, 10, 100, 50, 5, v3Far),
+			mv3([]common.Address{v3PayeeA}, []*big.Int{big.NewInt(40)}, 10, 100, 50, 5, v3Far), true},
