+func TestAgentPolicyV3ExecuteSweep(t *testing.T) {
+	e := newV3Env(t, true)
+	e.fund(1_000)
+	require.ErrorIs(t, e.executeSweep(), ErrNoPendingSweep)
+	require.NoError(t, e.freezeWith(flagsUP, nil))
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	e.ts += v3Delay - 1
+	require.ErrorIs(t, e.executeSweep(), ErrTimelockActive)
+	e.ts++
+
+	// Out of gas at the event: nothing written.
+	in, err := PackExecuteSweep(e.agent)
+	require.NoError(t, err)
+	_, _, err = AgentPolicyPrecompile.Run(e, common.Address{0xaa}, ContractAddress, in, ExecuteSweepGasCost, false)
+	require.ErrorIs(t, err, vm.ErrOutOfGas)
+	require.Equal(t, uint64(1_000), e.bal(e.agent))
+	_, eta := pendingSweep(e.db, e.agent)
+	require.NotZero(t, eta)
+	require.Zero(t, TotalSwept(e.db, e.agent).Sign())
+
+	// Read-only refused.
+	_, err = e.call(t, in, true)
+	require.ErrorIs(t, err, vm.ErrWriteProtection)
+
+	require.NoError(t, e.executeSweep())
+	require.Equal(t, uint64(0), e.bal(e.agent))
+	require.Equal(t, uint64(1_000), e.bal(v3Rescue))
+	require.Equal(t, int64(1_000), TotalSwept(e.db, e.agent).Int64())
+	require.Equal(t, AgentPolicyABI.Events["Swept"].ID, e.db.raw.Logs()[len(e.db.raw.Logs())-1].Topics[0])
+	require.ErrorIs(t, e.executeSweep(), ErrNoPendingSweep)
+	require.Equal(t, int64(1_000), e.viewCounters().TotalSwept.Int64())
+
+	// Zero balance.
+	require.NoError(t, e.sweepWith(v3Rescue, flagsUPUV))
+	e.ts += v3Delay
+	require.ErrorIs(t, e.executeSweep(), ErrNothingToSweep)
+
+	// Unfrozen after scheduling (state edited directly; unfreeze would also clear it).
+	e.fund(5)
+	setFlag(e.db, e.agent, flagFrozen, false)
+	require.ErrorIs(t, e.executeSweep(), ErrNotFrozen)
+}
