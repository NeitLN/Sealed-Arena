+		{"bad escape", `{"type":"webauthn.get","challenge":"` + c + `","o":"\x"}`, ErrBadClientData},
+		{"fraction", `{"type":"webauthn.get","challenge":"` + c + `","n":1.5}`, ErrBadClientData},
