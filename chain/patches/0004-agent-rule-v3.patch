+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/v3.go
@@ -0,0 +1,657 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"errors"
+	"math"
+	"math/big"
+
+	"github.com/ava-labs/libevm/accounts/abi"
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/vm"
+	"github.com/ava-labs/libevm/crypto"
+	"github.com/holiman/uint256"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+)
+
+// Rule v3 (activated by agentRuleV3Config): a strict clientDataJSON parser and the user-verified
+// flag for owner proofs, a guardian key that can freeze, a timelocked sweep of a frozen agent's
+// balance, and v3 mandates (per-payee daily caps, a payment count per UTC day, loosening only
+// after a delay). Owner proofs keep the v2 signing domain; the new actions have new type strings.
+
+var (
+	ErrUseSetMandateV3      = errors.New("agentpolicy: setMandateV2 is replaced by setMandateV3 under rule v3")
+	ErrPayeeCapsLength      = errors.New("agentpolicy: payeeDailyCaps length differs from payees")
+	ErrPayeeCapTooLarge     = errors.New("agentpolicy: payee daily cap above dailyCap or 2^192")
+	ErrDuplicatePayee       = errors.New("agentpolicy: payee listed twice")
+	ErrNoPending            = errors.New("agentpolicy: nothing pending")
+	ErrTimelockActive       = errors.New("agentpolicy: timelock not over")
+	ErrNotFrozen            = errors.New("agentpolicy: agent not frozen")
+	ErrNoPendingSweep       = errors.New("agentpolicy: no sweep scheduled")
+	ErrNothingToSweep       = errors.New("agentpolicy: nothing to sweep")
+	ErrBadSweepTarget       = errors.New("agentpolicy: sweep target not allowed")
+	ErrNoGuardian           = errors.New("agentpolicy: no guardian set")
+	ErrBadGuardianSignature = errors.New("agentpolicy: guardian signature invalid")
+	ErrNoBalanceAccess      = errors.New("agentpolicy: state cannot move balances")
+)
+
+// Gas costs of the v3 functions (consensus constants; see BenchmarkAgentPolicySetMandateV3).
+const (
+	SetMandateV3GasCost   uint64 = 1_700_000 // calibrated: 79 writes at 16 payees (TestAgentPolicyV3SetMandateGasCalibration)
+	CancelPendingGasCost  uint64 = FreezeGasCost + 20_000
+	SetGuardianGasCost    uint64 = FreezeGasCost + 20_000
+	SweepGasCost          uint64 = FreezeGasCost + 20_000
+	GuardianFreezeGasCost uint64 = 60_000
+	ExecuteSweepGasCost   uint64 = 80_000
+	GetMandateV3GasCost   uint64 = 40_000
+	GetPendingGasCost     uint64 = 40_000
+	V3ViewGasCost         uint64 = 5_000
+)
+
+// IAgentPolicyMandateV3 is the mandate of rule v3.
+type IAgentPolicyMandateV3 struct {
+	Payees            []common.Address
+	PayeeDailyCaps    []*big.Int
+	PerTxCap          *big.Int
+	DailyCap          *big.Int
+	DailyFeeCap       *big.Int
+	MaxPaymentsPerDay uint32
+	Expiry            uint64
+}
+
+type SetMandateV3Input struct {
+	Agent common.Address
+	M     IAgentPolicyMandateV3
+	Nonce *big.Int
+	Auth  []byte
+}
+
+type CancelPendingInput struct {
+	Agent common.Address
+	Nonce *big.Int
+	Auth  []byte
+}
+
+type SetGuardianInput struct {
+	Agent    common.Address
+	Guardian common.Address
+	Nonce    *big.Int
+	Auth     []byte
+}
+
+type GuardianFreezeInput struct {
+	Agent common.Address
+	Epoch *big.Int
+	Sig   []byte
+}
+
+type SweepInput struct {
+	Agent common.Address
+	To    common.Address
+	Nonce *big.Int
+	Auth  []byte
+}
+
+type GetPayeeSpendInput struct {
+	Agent common.Address
+	Payee common.Address
+}
+
+type GetMandateV3Output struct {
+	M      IAgentPolicyMandateV3
+	Frozen bool
+}
+
+type GetPendingOutput struct {
+	M          IAgentPolicyMandateV3
+	MandateEta uint64
+	SweepTo    common.Address
+	SweepEta   uint64
+}
+
+type GetCountersOutput struct {
+	PaymentsToday uint32
+	DayIndex      uint64
+	TotalCharged  *big.Int
+	TotalSwept    *big.Int
+}
+
+type GetPayeeSpendOutput struct {
+	SpentToday *big.Int
+	DayIndex   uint64
+}
+
+var tMandateV3, _ = abi.NewType("tuple", "", []abi.ArgumentMarshaling{
+	{Name: "payees", Type: "address[]"},
+	{Name: "payeeDailyCaps", Type: "uint256[]"},
+	{Name: "perTxCap", Type: "uint256"},
+	{Name: "dailyCap", Type: "uint256"},
+	{Name: "dailyFeeCap", Type: "uint256"},
+	{Name: "maxPaymentsPerDay", Type: "uint32"},
+	{Name: "expiry", Type: "uint64"},
+})
+
+// ---- digests -----------------------------------------------------------------------------
+
+// MandateV3Hash is keccak256(abi.encode(m)).
+func MandateV3Hash(m IAgentPolicyMandateV3) common.Hash {
+	return crypto.Keccak256Hash(mustPack(abi.Arguments{{Type: tMandateV3}}, m))
+}
+
+// SetMandateV3Challenge is what the owner signs to set a v3 mandate.
+func SetMandateV3Challenge(domain common.Hash, agent common.Address, m IAgentPolicyMandateV3, nonce *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tBytes32}, {Type: tUint256}},
+		"SealedArena:setMandateV3", [32]byte(domain), agent, [32]byte(MandateV3Hash(m)), nonce,
+	))
+}
+
+// CancelPendingChallenge is what the owner signs to cancel a scheduled mandate and sweep.
+func CancelPendingChallenge(domain common.Hash, agent common.Address, nonce *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tUint256}},
+		"SealedArena:cancelPending", [32]byte(domain), agent, nonce,
+	))
+}
+
+// SetGuardianChallenge is what the owner signs to set, rotate or clear (zero address) the guardian.
+func SetGuardianChallenge(domain common.Hash, agent, guardian common.Address, nonce *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tAddress}, {Type: tUint256}},
+		"SealedArena:setGuardian", [32]byte(domain), agent, guardian, nonce,
+	))
+}
+
+// SweepChallenge is what the owner signs to schedule a sweep; it is bound to the freeze epoch.
+func SweepChallenge(domain common.Hash, agent, to common.Address, nonce, epoch *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tAddress}, {Type: tUint256}, {Type: tUint256}},
+		"SealedArena:sweep", [32]byte(domain), agent, to, nonce, epoch,
+	))
+}
+
+// GuardianFreezeDigest is what the guardian key (secp256k1) signs to freeze during `epoch`.
+func GuardianFreezeDigest(domain common.Hash, agent common.Address, epoch *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tUint256}},
+		"SealedArena:guardianFreeze", [32]byte(domain), agent, epoch,
+	))
+}
+
+// newEvent packs an event and its gas: the log base cost, per topic, and per byte of data.
+func newEvent(name string, args ...any) (event, error) {
+	topics, data, err := AgentPolicyABI.PackEvent(name, args...)
+	if err != nil {
+		return event{}, err
+	}
+	return event{contract.LogGas + contract.LogTopicGas*uint64(len(topics)) + contract.LogDataGas*uint64(len(data)), topics, data}, nil
+}
+
+func mandateSetEvent(agent common.Address, m Mandate) (event, error) {
+	data := MandateSetEventData{PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, Expiry: m.Expiry, PayeeCount: big.NewInt(int64(len(m.Payees)))}
+	topics, packed, err := PackMandateSetEvent(agent, data)
+	if err != nil {
+		return event{}, err
+	}
+	return event{GetMandateSetEventGasCost(data), topics, packed}, nil
+}
+
+// lifecycleAt returns the lifecycle as a settle at `now` would leave it (no write).
+func lifecycleAt(st contract.StateReader, agent common.Address, flags uint64, now uint64) (eta uint64, active byte, due bool) {
+	if flags&flagMandateEver == 0 {
+		return 0, 0, false
+	}
+	eta, active = readLifecycle(st, agent)
+	if eta != 0 && now >= eta {
+		return 0, 1 - active, true
+	}
+	return eta, active, false
+}
+
+func addSaturating(a, b uint64) uint64 {
+	if a > math.MaxUint64-b {
+		return math.MaxUint64
+	}
+	return a + b
+}
+
+// ---- owner actions -----------------------------------------------------------------------
+
+// doSetMandateV3: the latest signed mandate N is the target. The part of N that tightens the
+// mandate in force E applies at once (meet(E, N)); if N loosens anything, N itself is scheduled
+// to apply loosenDelay seconds later. Any earlier scheduled mandate is replaced. The first mandate
+// of an agent (nothing to protect yet) applies at once.
+func doSetMandateV3(as contract.AccessibleState, remainingGas *uint64, in SetMandateV3Input) error {
+	if err := validateMandateV3(in.M); err != nil {
+		return err
+	}
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	current, err := checkOwner(st, in.Agent, in.Nonce, in.Auth, SetMandateV3Challenge(domain, in.Agent, in.M, in.Nonce), policyFor(st, false))
+	if err != nil {
+		return err
+	}
+	now := as.GetBlockContext().Timestamp()
+	flags := getUint64(st, in.Agent, fieldFlags)
+	_, active, _ := lifecycleAt(st, in.Agent, flags, now)
+	n := mandateFromV3(in.M)
+	write, pending := n, false
+	if mandateEver(st, in.Agent, flags) {
+		write = meet(readMandateGen(st, in.Agent, active, flags), n)
+		pending = !equalMandate(write, n)
+	}
+	setEv, err := mandateSetEvent(in.Agent, write)
+	if err != nil {
+		return err
+	}
+	if err := chargeEvent(remainingGas, setEv); err != nil {
+		return err
+	}
+	var eta uint64
+	var schedEv event
+	if pending {
+		eta = addSaturating(now, LoosenDelay(st))
+		if schedEv, err = newEvent("MandateScheduled", in.Agent, [32]byte(MandateV3Hash(in.M)), eta); err != nil {
+			return err
+		}
+		if err := chargeEvent(remainingGas, schedEv); err != nil {
+			return err
+		}
+	}
+
+	bumpNonce(st, in.Agent, current)
+	flags = writeMandateGen(st, in.Agent, active, write, flags) | flagMandateEver
+	if pending {
+		flags = writeMandateGen(st, in.Agent, 1-active, n, flags)
+	}
+	writeLifecycle(st, in.Agent, eta, active) // eta 0 clears any earlier scheduled mandate
+	setUint64(st, in.Agent, fieldFlags, flags)
+	addLog(as, setEv)
+	if pending {
+		addLog(as, schedEv)
+	}
+	return nil
+}
+
+// doCancelPending clears a scheduled mandate (one not yet in force) and a scheduled sweep.
+func doCancelPending(as contract.AccessibleState, remainingGas *uint64, in CancelPendingInput) error {
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	current, err := checkOwner(st, in.Agent, in.Nonce, in.Auth, CancelPendingChallenge(domain, in.Agent, in.Nonce), policyFor(st, false))
+	if err != nil {
+		return err
+	}
+	flags := getUint64(st, in.Agent, fieldFlags)
+	eta, active, due := lifecycleAt(st, in.Agent, flags, as.GetBlockContext().Timestamp())
+	_, sweepEta := pendingSweep(st, in.Agent)
+	if eta == 0 && sweepEta == 0 {
+		return ErrNoPending
+	}
+	ev, err := newEvent("PendingCancelled", in.Agent)
+	if err != nil {
+		return err
+	}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	bumpNonce(st, in.Agent, current)
+	if eta != 0 || due {
+		writeLifecycle(st, in.Agent, 0, active)
+	}
+	if sweepEta != 0 {
+		clearPendingSweep(st, in.Agent)
+	}
+	addLog(as, ev)
+	return nil
+}
+
+// doSetGuardian sets, rotates or (zero address) clears the guardian, at once.
+func doSetGuardian(as contract.AccessibleState, remainingGas *uint64, in SetGuardianInput) error {
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	current, err := checkOwner(st, in.Agent, in.Nonce, in.Auth, SetGuardianChallenge(domain, in.Agent, in.Guardian, in.Nonce), policyFor(st, false))
+	if err != nil {
+		return err
+	}
+	ev, err := newEvent("GuardianSet", in.Agent, in.Guardian)
+	if err != nil {
+		return err
+	}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	bumpNonce(st, in.Agent, current)
+	setWord(st, in.Agent, fieldGuardian, common.BytesToHash(in.Guardian.Bytes()))
+	addLog(as, ev)
+	return nil
+}
+
+// doGuardianFreeze freezes the agent on a guardian signature for the current freeze epoch. It
+// uses no nonce and is idempotent, like an owner freeze; an unfreeze or a new guardian makes
+// older signatures useless.
+func doGuardianFreeze(as contract.AccessibleState, remainingGas *uint64, in GuardianFreezeInput) error {
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	if !isRegistered(st, in.Agent) {
+		return ErrNotRegistered
+	}
+	g := guardianOf(st, in.Agent)
+	if g == (common.Address{}) {
+		return ErrNoGuardian
+	}
+	if in.Epoch == nil || !in.Epoch.IsUint64() || in.Epoch.Uint64() != FreezeEpoch(st, in.Agent) {
+		return ErrBadFreezeEpoch
+	}
+	if verifyAgentSignature(g, GuardianFreezeDigest(domain, in.Agent, in.Epoch), in.Sig) != nil {
+		return ErrBadGuardianSignature
+	}
+	if isFrozen(st, in.Agent) {
+		return nil
+	}
+	topics, packed, err := PackFrozenEvent(in.Agent)
+	if err != nil {
+		return err
+	}
+	ev := event{GetFrozenEventGasCost(), topics, packed}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	setFlag(st, in.Agent, flagFrozen, true)
+	addLog(as, ev)
+	return nil
+}
+
+// validSweepTarget refuses the zero address, the agent itself, the EVM's native precompiles and
+// the address ranges reserved for Avalanche precompiles (0x01..., 0x02..., 0x03...).
+func validSweepTarget(agent, to common.Address) bool {
+	if to == (common.Address{}) || to == agent {
+		return false
+	}
+	for _, b := range to[1:18] {
+		if b != 0 {
+			return true
+		}
+	}
+	if to[0] == 0x01 || to[0] == 0x02 || to[0] == 0x03 {
+		return false // reserved ranges 0x0X00...0000 to 0x0X00...ffff
+	}
+	if to[0] != 0 {
+		return true
+	}
+	v := uint16(to[18])<<8 | uint16(to[19])
+	return !((v >= 0x01 && v <= 0x0a) || v == 0x100)
+}
+
+// doSweep schedules moving a frozen agent's whole balance to `to` after loosenDelay. The proof is
+// bound to the freeze epoch; a second call replaces the first.
+func doSweep(as contract.AccessibleState, remainingGas *uint64, in SweepInput) error {
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	if !isRegistered(st, in.Agent) {
+		return ErrNotRegistered
+	}
+	if !validSweepTarget(in.Agent, in.To) {
+		return ErrBadSweepTarget
+	}
+	if !isFrozen(st, in.Agent) {
+		return ErrNotFrozen
+	}
+	epoch := new(big.Int).SetUint64(FreezeEpoch(st, in.Agent))
+	current, err := checkOwner(st, in.Agent, in.Nonce, in.Auth, SweepChallenge(domain, in.Agent, in.To, in.Nonce, epoch), policyFor(st, false))
+	if err != nil {
+		return err
+	}
+	eta := addSaturating(as.GetBlockContext().Timestamp(), LoosenDelay(st))
+	ev, err := newEvent("SweepScheduled", in.Agent, in.To, eta)
+	if err != nil {
+		return err
+	}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	bumpNonce(st, in.Agent, current)
+	writePendingSweep(st, in.Agent, in.To, eta)
+	addLog(as, ev)
+	return nil
+}
+
+// doExecuteSweep moves the whole balance of a still-frozen agent to the scheduled target once the
+// timelock is over. Anyone may call it. totalSwept records the amount, and getSpend adds it to
+// totalCharged, so balance >= funded - getSpend().total still holds.
+func doExecuteSweep(as contract.AccessibleState, remainingGas *uint64, agent common.Address) error {
+	st := as.GetStateDB()
+	to, eta := pendingSweep(st, agent)
+	switch now := as.GetBlockContext().Timestamp(); {
+	case eta == 0:
+		return ErrNoPendingSweep
+	case now < eta:
+		return ErrTimelockActive
+	case !isFrozen(st, agent):
+		return ErrNotFrozen
+	}
+	mover, ok := st.(balanceMover)
+	if !ok {
+		return ErrNoBalanceAccess
+	}
+	amt := new(uint256.Int).Set(st.GetBalance(agent))
+	if amt.IsZero() {
+		return ErrNothingToSweep
+	}
+	total := new(big.Int).Add(TotalSwept(st, agent), amt.ToBig())
+	if total.BitLen() > 256 {
+		return ErrCounterOverflow
+	}
+	ev, err := newEvent("Swept", agent, to, amt.ToBig())
+	if err != nil {
+		return err
+	}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	clearPendingSweep(st, agent)
+	setBig(st, agent, fieldTotalSwept, total)
+	mover.SubBalance(agent, amt)
+	mover.AddBalance(to, amt)
+	addLog(as, ev)
+	return nil
+}
+
+// ---- views --------------------------------------------------------------------------------
+
+func viewMandateV3(st contract.StateReader, agent common.Address, ts uint64) GetMandateV3Output {
+	registered, m, frozen, _ := GetMandateForRuleAt(st, agent, ts)
+	if !registered {
+		return GetMandateV3Output{M: mandateToV3(m)}
+	}
+	return GetMandateV3Output{M: mandateToV3(m), Frozen: frozen}
+}
+
+func viewPending(st contract.StateReader, agent common.Address, ts uint64) GetPendingOutput {
+	out := GetPendingOutput{M: mandateToV3(Mandate{PerTxCap: new(big.Int), DailyCap: new(big.Int)})}
+	if isRegistered(st, agent) {
+		flags := getUint64(st, agent, fieldFlags)
+		if eta, active, _ := lifecycleAt(st, agent, flags, ts); eta != 0 {
+			out.M = mandateToV3(readMandateGen(st, agent, 1-active, flags))
+			out.MandateEta = eta
+		}
+	}
+	out.SweepTo, out.SweepEta = pendingSweep(st, agent)
+	return out
+}
+
+func viewCounters(st contract.StateReader, agent common.Address, ts uint64) GetCountersOutput {
+	n := PaymentsToday(st, agent, ts)
+	if n > math.MaxUint32 {
+		n = math.MaxUint32
+	}
+	return GetCountersOutput{
+		PaymentsToday: uint32(n),
+		DayIndex:      ts / 86400,
+		TotalCharged:  readSpend(st, agent).TotalCharged,
+		TotalSwept:    TotalSwept(st, agent),
+	}
+}
+
+// ---- ABI functions -----------------------------------------------------------------------
+
+// write wraps a state-changing v3 function: fixed gas first, then read-only refusal, then unpack.
+func write[T any](name string, cost uint64, do func(contract.AccessibleState, *uint64, T) error) contract.RunStatefulPrecompileFunc {
+	return func(as contract.AccessibleState, _ common.Address, _ common.Address, input []byte, suppliedGas uint64, readOnly bool) ([]byte, uint64, error) {
+		remainingGas, err := contract.DeductGas(suppliedGas, cost)
+		if err != nil {
+			return nil, 0, err
+		}
+		if readOnly {
+			return nil, remainingGas, vm.ErrWriteProtection
+		}
+		var in T
+		if err := AgentPolicyABI.UnpackInputIntoInterface(&in, name, input); err != nil {
+			return nil, remainingGas, err
+		}
+		if err := do(as, &remainingGas, in); err != nil {
+			return nil, remainingGas, err
+		}
+		return []byte{}, remainingGas, nil
+	}
+}
+
+// view wraps a read-only v3 function: fixed gas, unpack, pack the outputs.
+func view[T any](name string, cost uint64, read func(contract.AccessibleState, T) []any) contract.RunStatefulPrecompileFunc {
+	return func(as contract.AccessibleState, _ common.Address, _ common.Address, input []byte, suppliedGas uint64, _ bool) ([]byte, uint64, error) {
+		remainingGas, err := contract.DeductGas(suppliedGas, cost)
+		if err != nil {
+			return nil, 0, err
+		}
+		var in T
+		if len(AgentPolicyABI.Methods[name].Inputs) > 0 {
+			if err := AgentPolicyABI.UnpackInputIntoInterface(&in, name, input); err != nil {
+				return nil, remainingGas, err
+			}
+		}
+		packed, err := AgentPolicyABI.PackOutput(name, read(as, in)...)
+		return packed, remainingGas, err
+	}
+}
+
+func blockTime(as contract.AccessibleState) uint64 { return as.GetBlockContext().Timestamp() }
+
+// v3Functions are added to the precompile, active only under rule v3.
+var v3Functions = map[string]contract.RunStatefulPrecompileFunc{
+	"setMandateV3":   write("setMandateV3", SetMandateV3GasCost, doSetMandateV3),
+	"cancelPending":  write("cancelPending", CancelPendingGasCost, doCancelPending),
+	"setGuardian":    write("setGuardian", SetGuardianGasCost, doSetGuardian),
+	"guardianFreeze": write("guardianFreeze", GuardianFreezeGasCost, doGuardianFreeze),
+	"sweep":          write("sweep", SweepGasCost, doSweep),
+	"executeSweep":   write("executeSweep", ExecuteSweepGasCost, doExecuteSweep),
+	"getMandateV3": view("getMandateV3", GetMandateV3GasCost, func(as contract.AccessibleState, agent common.Address) []any {
+		out := viewMandateV3(as.GetStateDB(), agent, blockTime(as))
+		return []any{out.M, out.Frozen}
+	}),
+	"getPending": view("getPending", GetPendingGasCost, func(as contract.AccessibleState, agent common.Address) []any {
+		out := viewPending(as.GetStateDB(), agent, blockTime(as))
+		return []any{out.M, out.MandateEta, out.SweepTo, out.SweepEta}
+	}),
+	"getCounters": view("getCounters", V3ViewGasCost, func(as contract.AccessibleState, agent common.Address) []any {
+		out := viewCounters(as.GetStateDB(), agent, blockTime(as))
+		return []any{out.PaymentsToday, out.DayIndex, out.TotalCharged, out.TotalSwept}
+	}),
+	"getPayeeSpend": view("getPayeeSpend", V3ViewGasCost, func(as contract.AccessibleState, in GetPayeeSpendInput) []any {
+		ts := blockTime(as)
+		return []any{PayeeSpentToday(as.GetStateDB(), in.Agent, in.Payee, ts), ts / 86400}
+	}),
+	"guardian": view("guardian", V3ViewGasCost, func(as contract.AccessibleState, agent common.Address) []any {
+		return []any{guardianOf(as.GetStateDB(), agent)}
+	}),
+	"loosenDelay": view("loosenDelay", V3ViewGasCost, func(as contract.AccessibleState, _ struct{}) []any {
+		return []any{LoosenDelay(as.GetStateDB())}
+	}),
+}
+
+// ---- packers (clients and tests) ----------------------------------------------------------
+
+func PackSetMandateV3(in SetMandateV3Input) ([]byte, error) {
