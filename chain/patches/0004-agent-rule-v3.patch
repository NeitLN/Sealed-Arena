diff --git a/graft/subnet-evm/precompile/contracts/agentpolicy/mandate_v3.go b/graft/subnet-evm/precompile/contracts/agentpolicy/mandate_v3.go
new file mode 100644
index 0000000..34e349a
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/mandate_v3.go
@@ -0,0 +1,175 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"math/big"
+	"slices"
+
+	"github.com/ava-labs/libevm/common"
+)
+
+// Mandate order of rule v3. N is at least as tight as E (N ⊑ E) when, field by field:
+//
+//	payees            N.payees ⊆ E.payees
+//	perTxCap, dailyCap N <= E
+//	dailyFeeCap       N <= E.EffFeeCap()
+//	expiry            N <= E (extending an expired mandate is a loosening)
+//	maxPaymentsPerDay N <= E (a mandate from before v3 counts as unlimited)
+//	per-payee cap     for each payee in both, capN(p) <= capE(p) (before v3: no cap)
+//
+// setMandateV3 applies meet(E, N), the tightest mandate looser than neither, at once, and
+// schedules N after the loosening delay when N is not itself the meet.
+
+func minBig(a, b *big.Int) *big.Int {
+	if a.Cmp(b) <= 0 {
+		return new(big.Int).Set(a)
+	}
+	return new(big.Int).Set(b)
+}
+
+// capOf returns the per-payee cap of `p` in m (NoPayeeCap when m has none for it), and whether
+// p is a payee of m. The first occurrence counts, as in the validity rule.
+func capOf(m Mandate, p common.Address) (*big.Int, bool) {
+	i := slices.Index(m.Payees, p)
+	if i < 0 {
+		return nil, false
+	}
+	if c := m.PayeeCap(i); c != nil {
+		return c, true
+	}
+	return NoPayeeCap, true
+}
+
+// meet returns the field-wise meet of E and N: the payees of N that E also has (in N's order),
+// each field's minimum. It is always a v3 mandate. A finite per-payee cap above the meet's daily
+// cap is lowered to it, so the meet keeps every validation bound.
+func meet(e, n Mandate) Mandate {
+	m := Mandate{
+		PerTxCap:          minBig(e.PerTxCap, n.PerTxCap),
+		DailyCap:          minBig(e.DailyCap, n.DailyCap),
+		DailyFeeCap:       minBig(e.EffFeeCap(), n.EffFeeCap()),
+		FeeCapSet:         true,
+		Expiry:            min(e.Expiry, n.Expiry),
+		IsV3:              true,
+		MaxPaymentsPerDay: min(e.MaxPayments(), n.MaxPayments()),
+		Payees:            []common.Address{},
+		PayeeCaps:         []*big.Int{},
+	}
+	for _, p := range n.Payees {
+		capE, inE := capOf(e, p)
+		if !inE {
+			continue
+		}
+		capN, _ := capOf(n, p)
+		c := minBig(capE, capN)
+		if c.Cmp(NoPayeeCap) != 0 && c.Cmp(m.DailyCap) > 0 {
+			c = new(big.Int).Set(m.DailyCap)
+		}
+		m.Payees = append(m.Payees, p)
+		m.PayeeCaps = append(m.PayeeCaps, c)
+	}
+	return m
+}
+
+// equalMandate compares two v3 mandates field by field (payee order included).
+func equalMandate(a, b Mandate) bool {
+	if a.IsV3 != b.IsV3 || a.FeeCapSet != b.FeeCapSet || a.Expiry != b.Expiry || a.MaxPayments() != b.MaxPayments() ||
+		a.PerTxCap.Cmp(b.PerTxCap) != 0 || a.DailyCap.Cmp(b.DailyCap) != 0 || a.EffFeeCap().Cmp(b.EffFeeCap()) != 0 ||
+		!slices.Equal(a.Payees, b.Payees) {
+		return false
+	}
+	for i := range a.Payees {
+		ca, cb := a.PayeeCap(i), b.PayeeCap(i)
+		if (ca == nil) != (cb == nil) || (ca != nil && ca.Cmp(cb) != 0) {
+			return false
+		}
+	}
+	return true
+}
+
+// tighterOrEqual is the direct definition of N ⊑ E (used by tests to check meet).
+func tighterOrEqual(n, e Mandate) bool {
+	if n.PerTxCap.Cmp(e.PerTxCap) > 0 || n.DailyCap.Cmp(e.DailyCap) > 0 || n.EffFeeCap().Cmp(e.EffFeeCap()) > 0 ||
+		n.Expiry > e.Expiry || n.MaxPayments() > e.MaxPayments() {
+		return false
+	}
+	for _, p := range n.Payees {
+		capE, ok := capOf(e, p)
+		if !ok {
+			return false
+		}
+		capN, _ := capOf(n, p)
+		if capN.Cmp(capE) > 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// mandateFromV3 converts the ABI mandate into the internal form.
+func mandateFromV3(in IAgentPolicyMandateV3) Mandate {
+	return Mandate{
+		Payees:            in.Payees,
+		PayeeCaps:         in.PayeeDailyCaps,
+		PerTxCap:          in.PerTxCap,
+		DailyCap:          in.DailyCap,
+		DailyFeeCap:       in.DailyFeeCap,
+		FeeCapSet:         true,
+		Expiry:            in.Expiry,
+		IsV3:              true,
+		MaxPaymentsPerDay: in.MaxPaymentsPerDay,
+	}
+}
+
+// mandateToV3 projects any mandate into the v3 ABI shape (a mandate from before v3 shows no
+// per-payee caps, unlimited payments, and its effective fee cap).
+func mandateToV3(m Mandate) IAgentPolicyMandateV3 {
+	out := IAgentPolicyMandateV3{
+		Payees:            m.Payees,
+		PayeeDailyCaps:    make([]*big.Int, len(m.Payees)),
+		PerTxCap:          m.PerTxCap,
+		DailyCap:          m.DailyCap,
+		DailyFeeCap:       m.EffFeeCap(),
+		MaxPaymentsPerDay: m.MaxPayments(),
+		Expiry:            m.Expiry,
+	}
+	if out.Payees == nil {
+		out.Payees = []common.Address{}
+	}
+	for i := range out.PayeeDailyCaps {
+		if c := m.PayeeCap(i); c != nil {
+			out.PayeeDailyCaps[i] = c
+		} else {
+			out.PayeeDailyCaps[i] = NoPayeeCap
+		}
+	}
+	return out
+}
+
+// validateMandateV3 checks a mandate given to setMandateV3.
+func validateMandateV3(m IAgentPolicyMandateV3) error {
+	if len(m.Payees) > MaxPayees {
+		return ErrTooManyPayees
+	}
+	if len(m.PayeeDailyCaps) != len(m.Payees) {
+		return ErrPayeeCapsLength
+	}
+	for i, p := range m.Payees {
+		if slices.Contains(m.Payees[:i], p) {
+			return ErrDuplicatePayee
+		}
+	}
+	if m.PerTxCap == nil || m.DailyCap == nil || m.DailyFeeCap == nil || m.PerTxCap.Cmp(m.DailyCap) > 0 {
+		return ErrPerTxAboveDaily
+	}
+	if m.DailyFeeCap.Cmp(m.DailyCap) > 0 {
+		return ErrFeeCapAboveDaily
+	}
+	for _, c := range m.PayeeDailyCaps {
+		if c == nil || (c.Cmp(NoPayeeCap) != 0 && (c.Cmp(m.DailyCap) > 0 || c.Cmp(payeeCapBound) >= 0)) {
+			return ErrPayeeCapTooLarge
+		}
+	}
+	return nil
+}
diff --git a/graft/subnet-evm/precompile/contracts/agentpolicy/storage.go b/graft/subnet-evm/precompile/contracts/agentpolicy/storage.go
index 23a886e..ca756bb 100644
--- a/graft/subnet-evm/precompile/contracts/agentpolicy/storage.go
+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/storage.go
@@ -100,6 +100,38 @@ type Mandate struct {
 	// (setMandate); then only DailyCap limits fees, as in v1.
 	DailyFeeCap *big.Int
 	FeeCapSet   bool
+
+	// Rule v3: set for a mandate written by setMandateV3. PayeeCaps has one entry per payee
+	// (NoPayeeCap = no per-payee cap) and MaxPaymentsPerDay limits the payments per UTC day
+	// (UnlimitedPayments = no limit). A mandate from before v3 has neither limit.
+	IsV3              bool
+	PayeeCaps         []*big.Int
+	MaxPaymentsPerDay uint32
+}
+
+// EffFeeCap is the daily fee limit in force: DailyFeeCap for a mandate with a fee cap, DailyCap
+// for a mandate from before v2 (where only the daily cap limits fees).
+func (m Mandate) EffFeeCap() *big.Int {
+	if m.FeeCapSet {
+		return m.DailyFeeCap
+	}
+	return m.DailyCap
+}
+
+// MaxPayments returns the payment limit per UTC day (UnlimitedPayments before v3).
+func (m Mandate) MaxPayments() uint32 {
+	if !m.IsV3 {
+		return UnlimitedPayments
+	}
+	return m.MaxPaymentsPerDay
+}
+
+// PayeeCap returns the per-payee daily value cap of payee index i, or nil when it has none.
+func (m Mandate) PayeeCap(i int) *big.Int {
+	if !m.IsV3 || i < 0 || i >= len(m.PayeeCaps) || m.PayeeCaps[i].Cmp(NoPayeeCap) == 0 {
+		return nil
+	}
+	return m.PayeeCaps[i]
 }
 
 // FeeSpendForDay returns the fees counted for the agent on the UTC day of `timestamp`
diff --git a/graft/subnet-evm/precompile/contracts/agentpolicy/storage_v3.go b/graft/subnet-evm/precompile/contracts/agentpolicy/storage_v3.go
new file mode 100644
index 0000000..9d567f6
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/storage_v3.go
@@ -0,0 +1,283 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"encoding/binary"
+	"math"
+	"math/big"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/holiman/uint256"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+)
+
+// Rule v3 storage. Fields 1-16 are those of rules v1 and v2 (storage.go). A mandate lives in one
+// of two generations: generation 0 is the v1/v2 slots, generation 1 the mirror below. The
+// lifecycle word says which generation is active and, when a loosening is scheduled, the time it
+// takes effect; the other generation then holds the pending mandate. Until an agent's first
+// setMandateV3 nothing here is written and every read path reads the same slots as before v3.
+const (
+	fieldLifecycle    byte = 17 // packed: pendingEta u64 (bytes 16-23) | activeGen (byte 31)
+	fieldPayCount     byte = 18 // packed: day u64 (bytes 16-23) | count u64 (bytes 24-31)
+	fieldPayeeSpent   byte = 19 // + payee (20 bytes); packed: day u64 (bytes 0-7) | spent u192
+	fieldGuardian     byte = 20
+	fieldTotalSwept   byte = 21
+	fieldPendingSweep byte = 22 // packed: eta u64 (bytes 4-11) | to (bytes 12-31)
+	fieldMaxPayments  byte = 23 // + gen
+	fieldPayeeCap     byte = 24 // + gen + index
+
+	// Generation 1 of the mandate (generation 0 is fields 5-8, 12 and 13).
+	fieldG1PayeeCount  byte = 25
+	fieldG1PerTxCap    byte = 26
+	fieldG1DailyCap    byte = 27
+	fieldG1Expiry      byte = 28
+	fieldG1DailyFeeCap byte = 29
+	fieldG1Payee       byte = 30 // + index
+)
+
+const (
+	flagMandateEver uint64 = 1 << 4 // setMandateV3 has run for this agent
+	flagGen0IsV3    uint64 = 1 << 5 // generation 0 holds a v3 mandate (which has a fee cap)
+	flagGen1IsV3    uint64 = 1 << 6 // generation 1 holds a v3 mandate
+)
+
+// NoPayeeCap is the per-payee cap value meaning "no per-payee cap" (type(uint256).max).
+var NoPayeeCap = new(big.Int).Sub(new(big.Int).Lsh(common.Big1, 256), common.Big1)
+
+// UnlimitedPayments is the maxPaymentsPerDay value meaning "no limit" (type(uint32).max).
+const UnlimitedPayments = math.MaxUint32
+
+// payeeCapBound: a finite per-payee cap must be below 2^192 (the size of its counter).
+var payeeCapBound = new(big.Int).Lsh(common.Big1, 192)
+
+// loosenDelayKey holds rule v3's loosening delay in seconds (written by agentrulev3.Configure).
+var loosenDelayKey = common.BytesToHash([]byte("sealed-arena.loosen-delay"))
+
+// isV3 reports whether rule v3 is active (the marker agentrulev3 writes at activation).
+func isV3(s contract.StateReader) bool { return RuleVersion(s) >= 3 }
+
+// v3Only activates the v3 functions; before rule v3 their selectors behave as unknown ones.
+func v3Only(as contract.AccessibleState) bool { return isV3(as.GetStateDB()) }
+
+// LoosenDelay returns rule v3's loosening delay in seconds (0 before rule v3).
+func LoosenDelay(s contract.StateReader) uint64 {
+	return s.GetState(ContractAddress, loosenDelayKey).Big().Uint64()
+}
+
+// SetLoosenDelay writes the loosening delay (called at rule v3 activation only).
+func SetLoosenDelay(s contract.StateDB, d uint64) {
+	s.SetState(ContractAddress, loosenDelayKey, common.BigToHash(new(big.Int).SetUint64(d)))
+}
+
+// ---- lifecycle -----------------------------------------------------------------------------
+
+func readLifecycle(s contract.StateReader, agent common.Address) (pendingEta uint64, activeGen byte) {
+	h := getWord(s, agent, fieldLifecycle)
+	return binary.BigEndian.Uint64(h[16:24]), h[31] & 1
+}
+
+func writeLifecycle(s StateReadWriter, agent common.Address, pendingEta uint64, activeGen byte) {
+	var h common.Hash
+	binary.BigEndian.PutUint64(h[16:24], pendingEta)
+	h[31] = activeGen & 1
+	setWord(s, agent, fieldLifecycle, h)
+}
+
+// effectiveGen is the generation whose mandate applies at `ts`: the pending one once its time
+// has come, the active one otherwise. It reads the lifecycle word only for an agent that has had
+// a v3 mandate, so agents from before v3 read the same slots as before.
+func effectiveGen(s contract.StateReader, agent common.Address, flags uint64, ts uint64) byte {
+	if flags&flagMandateEver == 0 {
+		return 0
+	}
+	eta, active := readLifecycle(s, agent)
+	if eta != 0 && ts >= eta {
+		return 1 - active
+	}
+	return active
+}
+
+// ---- mandate generations -------------------------------------------------------------------
+
+func readCaps(s contract.StateReader, agent common.Address, gen byte, n int) ([]*big.Int, uint32) {
+	caps := make([]*big.Int, n)
+	for i := range caps {
+		caps[i] = getWord(s, agent, fieldPayeeCap, gen, byte(i)).Big()
+	}
+	h := getWord(s, agent, fieldMaxPayments, gen)
+	return caps, binary.BigEndian.Uint32(h[28:])
+}
+
+// readMandateGen reads the mandate of generation `gen`. Generation 0 without a v3 mandate reads
+// exactly what readMandate read before v3.
+func readMandateGen(s contract.StateReader, agent common.Address, gen byte, flags uint64) Mandate {
+	if gen == 0 {
+		m := readMandate(s, agent)
+		if flags&flagGen0IsV3 != 0 {
+			m.IsV3 = true
+			m.PayeeCaps, m.MaxPaymentsPerDay = readCaps(s, agent, 0, len(m.Payees))
+		}
+		return m
+	}
+	n := int(getUint64(s, agent, fieldG1PayeeCount))
+	if n > MaxPayees {
+		n = MaxPayees
+	}
+	payees := make([]common.Address, n)
+	for i := range payees {
+		payees[i] = common.BytesToAddress(getWord(s, agent, fieldG1Payee, byte(i)).Bytes())
+	}
+	m := Mandate{
+		Payees:      payees,
+		PerTxCap:    getBig(s, agent, fieldG1PerTxCap),
+		DailyCap:    getBig(s, agent, fieldG1DailyCap),
+		Expiry:      getUint64(s, agent, fieldG1Expiry),
+		DailyFeeCap: getBig(s, agent, fieldG1DailyFeeCap),
+		FeeCapSet:   true,
+		IsV3:        flags&flagGen1IsV3 != 0,
+	}
+	m.PayeeCaps, m.MaxPaymentsPerDay = readCaps(s, agent, 1, n)
+	return m
+}
+
+// writeMandateGen stores v3 mandate m in generation `gen` and returns the updated flags word
+// (the caller writes it).
+func writeMandateGen(s StateReadWriter, agent common.Address, gen byte, m Mandate, flags uint64) uint64 {
+	if gen == 0 {
+		writeMandate(s, agent, m)
+		setBig(s, agent, fieldDailyFeeCap, m.DailyFeeCap)
+		flags |= flagFeeCapSet | flagGen0IsV3
+	} else {
+		old := int(getUint64(s, agent, fieldG1PayeeCount))
+		for i := 0; i < MaxPayees; i++ {
+			var v common.Hash
+			if i < len(m.Payees) {
+				v = common.BytesToHash(m.Payees[i].Bytes())
+			} else if i >= old {
+				continue
+			}
+			setWord(s, agent, fieldG1Payee, v, byte(i))
+		}
+		setUint64(s, agent, fieldG1PayeeCount, uint64(len(m.Payees)))
+		setBig(s, agent, fieldG1PerTxCap, m.PerTxCap)
+		setBig(s, agent, fieldG1DailyCap, m.DailyCap)
+		setUint64(s, agent, fieldG1Expiry, m.Expiry)
+		setBig(s, agent, fieldG1DailyFeeCap, m.DailyFeeCap)
+		flags |= flagGen1IsV3
+	}
+	for i, c := range m.PayeeCaps {
+		setWord(s, agent, fieldPayeeCap, common.BigToHash(c), gen, byte(i))
+	}
+	var h common.Hash
+	binary.BigEndian.PutUint32(h[28:], m.MaxPaymentsPerDay)
+	setWord(s, agent, fieldMaxPayments, h, gen)
+	return flags
+}
+
+// mandateEver reports whether the agent has had a mandate an owner could rely on: set by
+// setMandateV3, and derived for agents from before v3 from their v1/v2 mandate.
+func mandateEver(s contract.StateReader, agent common.Address, flags uint64) bool {
+	if flags&(flagMandateEver|flagFeeCapSet) != 0 {
+		return true
+	}
+	return getUint64(s, agent, fieldPayeeCount) > 0 || getBig(s, agent, fieldDailyCap).Sign() > 0 || getUint64(s, agent, fieldExpiry) > 0
+}
+
+// GetMandateForRuleAt is GetMandateForRule for the mandate in force at `ts` (rule v3: a pending
+// loosening applies from its time on, without any write).
+func GetMandateForRuleAt(s contract.StateReader, agent common.Address, ts uint64) (registered bool, m Mandate, frozen bool, spend Spend) {
+	if !isRegistered(s, agent) {
+		return GetMandateForRule(s, agent)
+	}
+	flags := getUint64(s, agent, fieldFlags)
+	return true, readMandateGen(s, agent, effectiveGen(s, agent, flags, ts), flags), flags&flagFrozen != 0, readSpend(s, agent)
+}
+
+// ---- rule v3 counters ----------------------------------------------------------------------
+
+// PaymentsToday returns the agent's payment count on the UTC day of `ts` (counted only while the
+// mandate in force limits it).
+func PaymentsToday(s contract.StateReader, agent common.Address, ts uint64) uint64 {
+	h := getWord(s, agent, fieldPayCount)
+	if binary.BigEndian.Uint64(h[16:24]) != ts/86400 {
+		return 0
+	}
+	return binary.BigEndian.Uint64(h[24:])
+}
+
+// PayeeSpentToday returns the value paid to `payee` on the UTC day of `ts` (counted only while
+// the mandate in force caps that payee).
+func PayeeSpentToday(s contract.StateReader, agent, payee common.Address, ts uint64) *big.Int {
+	h := getWord(s, agent, fieldPayeeSpent, payee.Bytes()...)
+	if binary.BigEndian.Uint64(h[:8]) != ts/86400 {
+		return new(big.Int)
+	}
+	return new(big.Int).SetBytes(h[8:])
+}
+
+// ChargeV3 records an included agent payment under a v3 mandate (preCheck, after ChargeFee):
+// one payment on the day's count when `count` is set, and `value` on the payee's daily counter
+// when `capped` is set. It writes nothing otherwise, and nothing when a counter would overflow.
+func ChargeV3(s StateReadWriter, agent, payee common.Address, value *big.Int, ts uint64, count, capped bool) error {
+	day := ts / 86400
+	var spent *big.Int
+	if capped {
+		spent = new(big.Int).Add(PayeeSpentToday(s, agent, payee, ts), value)
+		if value.Sign() < 0 || spent.Cmp(payeeCapBound) >= 0 {
+			return ErrCounterOverflow
+		}
+	}
+	n := PaymentsToday(s, agent, ts)
+	if count && n == math.MaxUint64 {
+		return ErrCounterOverflow
+	}
+	if count {
+		var h common.Hash
+		binary.BigEndian.PutUint64(h[16:24], day)
+		binary.BigEndian.PutUint64(h[24:], n+1)
+		setWord(s, agent, fieldPayCount, h)
+	}
+	if capped {
+		var h common.Hash
+		binary.BigEndian.PutUint64(h[:8], day)
+		spent.FillBytes(h[8:])
+		setWord(s, agent, fieldPayeeSpent, h, payee.Bytes()...)
+	}
+	return nil
+}
+
+// ---- guardian, sweep ---------------------------------------------------------------------------
+
+func guardianOf(s contract.StateReader, agent common.Address) common.Address {
+	return common.BytesToAddress(getWord(s, agent, fieldGuardian).Bytes())
+}
+
+// TotalSwept returns what sweeps have moved out of the agent's account (rule v3).
+func TotalSwept(s contract.StateReader, agent common.Address) *big.Int {
+	return getBig(s, agent, fieldTotalSwept)
+}
+
+func pendingSweep(s contract.StateReader, agent common.Address) (to common.Address, eta uint64) {
+	h := getWord(s, agent, fieldPendingSweep)
+	return common.BytesToAddress(h[12:]), binary.BigEndian.Uint64(h[4:12])
+}
+
+func writePendingSweep(s StateReadWriter, agent, to common.Address, eta uint64) {
+	var h common.Hash
+	binary.BigEndian.PutUint64(h[4:12], eta)
+	copy(h[12:], to.Bytes())
+	setWord(s, agent, fieldPendingSweep, h)
+}
+
+func clearPendingSweep(s StateReadWriter, agent common.Address) {
+	setWord(s, agent, fieldPendingSweep, common.Hash{})
+}
+
+// balanceMover is the balance access a sweep needs. The concrete state behind contract.StateDB
+// has SubBalance; the interface does not, and a state without it makes the sweep fail closed.
+type balanceMover interface {
+	SubBalance(common.Address, *uint256.Int)
+	AddBalance(common.Address, *uint256.Int)
+}
