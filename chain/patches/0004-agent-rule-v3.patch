+// meet properties on random mandates.
+func randMandate(r *big.Int, seed []byte, v3 bool) Mandate {
+	pick := func(i int) int64 { return int64(seed[i%len(seed)]) }
+	all := []common.Address{v3PayeeA, v3PayeeB, v3PayeeC}
+	m := Mandate{PerTxCap: big.NewInt(pick(0)), DailyCap: big.NewInt(pick(0) + pick(1)), Expiry: uint64(pick(2)), IsV3: v3}
+	m.DailyFeeCap = big.NewInt(pick(3) % (m.DailyCap.Int64() + 1))
+	m.FeeCapSet = v3 || pick(4)%2 == 0
+	if v3 {
+		m.MaxPaymentsPerDay = uint32(pick(5) % 4)
+		if pick(5)%5 == 0 {
+			m.MaxPaymentsPerDay = UnlimitedPayments
+		}
+	}
+	for i, p := range all {
+		if pick(6+i)%2 == 0 {
+			continue
+		}
+		m.Payees = append(m.Payees, p)
+		c := NoPayeeCap
+		if v3 && pick(9+i)%3 != 0 {
+			c = big.NewInt(pick(9+i) % (m.DailyCap.Int64() + 1))
+		}
+		m.PayeeCaps = append(m.PayeeCaps, c)
+	}
+	_ = r
+	return m
+}
+
+func checkMeetProperties(t *testing.T, e, n Mandate) {
+	t.Helper()
+	m := meet(e, n)
+	require.True(t, tighterOrEqual(m, e), "meet ⊑ E")
+	require.True(t, tighterOrEqual(m, n), "meet ⊑ N")
+	require.True(t, equalMandate(meet(m, m), m), "idempotent")
+	require.NoError(t, validateMandateV3(mandateToV3(m)), "keeps the validation bounds")
+	if n.IsV3 && validateMandateV3(mandateToV3(n)) == nil {
+		require.Equal(t, tighterOrEqual(n, e), equalMandate(m, n), "meet == N iff N ⊑ E")
+	}
+}
+
+func TestAgentPolicyV3MeetProperties(t *testing.T) {
+	seed := make([]byte, 24)
+	for i := 0; i < 3000; i++ {
+		_, err := rand.Read(seed)
+		require.NoError(t, err)
+		e := randMandate(nil, seed[:12], i%3 != 0)
+		n := randMandate(nil, seed[12:], true)
+		checkMeetProperties(t, e, n)
+	}
+}
