diff --git a/graft/subnet-evm/plugin/evm/agent_rule_v3_vm_test.go b/graft/subnet-evm/plugin/evm/agent_rule_v3_vm_test.go
new file mode 100644
index 0000000..1ffac25
--- /dev/null
+++ b/graft/subnet-evm/plugin/evm/agent_rule_v3_vm_test.go
@@ -0,0 +1,213 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package evm
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/types"
+	"github.com/ava-labs/libevm/crypto"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/evm/utils"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/core"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/core/txpool"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params/extras"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params/paramstest"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/plugin/evm/extension"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentrulev2"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentrulev3"
+	"github.com/ava-labs/avalanchego/upgrade/upgradetest"
+	"github.com/ava-labs/avalanchego/vms/components/chain"
+)
+
+const poolLoosenDelay uint64 = 60
+
+// v3PoolEnv is a VM with rules v2 and v3 from genesis, the agent registered and given `m`.
+type v3PoolEnv struct {
+	*agentPoolEnv
+	domain common.Hash
+	feeCap *big.Int
+}
+
+func newV3PoolEnv(t *testing.T, m func(e *v3PoolEnv) agentpolicy.IAgentPolicyMandateV3) *v3PoolEnv {
+	genesis := &core.Genesis{}
+	require.NoError(t, genesis.UnmarshalJSON([]byte(toGenesisJSON(paramstest.ForkToChainConfig[upgradetest.Latest]))))
+	params.GetExtra(genesis.Config).GenesisPrecompiles = extras.Precompiles{
+		agentpolicy.ConfigKey: agentpolicy.NewConfig(utils.PointerTo[uint64](0)),
+		agentrulev2.ConfigKey: agentrulev2.NewConfig(utils.PointerTo[uint64](0)),
+		agentrulev3.ConfigKey: agentrulev3.NewConfig(utils.PointerTo[uint64](0), poolLoosenDelay),
+	}
+	genesisJSON, err := genesis.MarshalJSON()
+	require.NoError(t, err)
+	fork := upgradetest.Latest
+	tvm := newVM(t, testVMConfig{fork: &fork, genesisJSON: string(genesisJSON)})
+	t.Cleanup(func() { require.NoError(t, tvm.vm.Shutdown(t.Context())) })
+	// The pool reads the VM's (mock) clock.
+	prevNow := txpool.Now
+	txpool.Now = tvm.vm.clock.Time
+	t.Cleanup(func() { txpool.Now = prevNow })
+
+	base := &agentPoolEnv{
+		t: t, tvm: tvm, chainID: tvm.vm.chainConfig.ChainID,
+		relayer: testKeys[0].ToECDSA(), agentKey: testKeys[1].ToECDSA(), agent: testEthAddrs[1],
+		payee: common.HexToAddress("0x00000000000000000000000000000000000000A1"),
+		value: new(big.Int).Exp(big.NewInt(10), big.NewInt(17), nil), gasPrice: big.NewInt(testMinGasPrice), nonces: map[common.Address]uint64{},
+	}
+	base.signer = types.LatestSignerForChainID(base.chainID)
+	base.nextBlock = func() { tvm.vm.clock.Set(tvm.vm.clock.Time().Add(5 * time.Second)) }
+	base.owner, err = ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	e := &v3PoolEnv{agentPoolEnv: base, domain: agentpolicy.DomainV2(tvm.vm.ctx.NetworkID, tvm.vm.ctx.ChainID, base.chainID)}
+	e.feeCap = new(big.Int).Mul(tvm.vm.blockChain.CurrentBlock().BaseFee, big.NewInt(4))
+
+	x, y := [32]byte(common.BigToHash(e.owner.X)), [32]byte(common.BigToHash(e.owner.Y))
+	sig, err := crypto.Sign(agentpolicy.RegisterDigestV2(e.domain, e.agent, x, y).Bytes(), e.agentKey)
+	require.NoError(t, err)
+	regData, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: e.agent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(t, err)
+	e.block(e.relayerTx(regData, 300_000), e.relayerTx(e.setMandateV3Data(m(e)), 2_000_000))
+	return e
+}
+
+func (e *v3PoolEnv) setMandateV3Data(m agentpolicy.IAgentPolicyMandateV3) []byte {
+	n := big.NewInt(e.ownerNo)
+	auth := agentAssertion(e.t, e.owner, agentpolicy.SetMandateV3Challenge(e.domain, e.agent, m, n))
+	data, err := agentpolicy.PackSetMandateV3(agentpolicy.SetMandateV3Input{Agent: e.agent, M: m, Nonce: n, Auth: auth})
+	require.NoError(e.t, err)
+	e.ownerNo++
+	return data
+}
+
+// charge of one v3 payment of e.value: value + 21000 x feeCap.
+func (e *v3PoolEnv) charge3() *big.Int {
+	return new(big.Int).Add(e.value, new(big.Int).Mul(big.NewInt(21_000), e.feeCap))
+}
+
+// pay3 is a rule v2/v3 valid payment (type 2, tip at the cap).
+func (e *v3PoolEnv) pay3(nonce uint64, to common.Address, value *big.Int, feeCap *big.Int) *types.Transaction {
+	return e.pay3t(nonce, to, value, feeCap, big.NewInt(500_000_000))
+}
+
+func (e *v3PoolEnv) pay3t(nonce uint64, to common.Address, value *big.Int, feeCap *big.Int, tip *big.Int) *types.Transaction {
+	tx, err := types.SignNewTx(e.agentKey, e.signer, &types.DynamicFeeTx{
+		ChainID: e.chainID, Nonce: nonce, GasTipCap: tip, GasFeeCap: feeCap, Gas: 21_000, To: &to, Value: value,
+	})
+	require.NoError(e.t, err)
+	return tx
+}
+
+func (e *v3PoolEnv) add(tx *types.Transaction) error {
+	return e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{tx})[0]
+}
+
+func capsOf(caps ...*big.Int) []*big.Int { return caps }
+
+var poolStranger = common.HexToAddress("0x00000000000000000000000000000000000000B2")
+
+// Pooled transactions with a lower nonce count toward the payment count, the payee's cap and the
+// fee cap; a same-nonce replacement counts once; another payee does not add to the payee's value.
+func TestAgentRulePoolReservedV3(t *testing.T) {
+	e := newV3PoolEnv(t, func(e *v3PoolEnv) agentpolicy.IAgentPolicyMandateV3 {
+		daily := new(big.Int).Mul(e.charge3(), big.NewInt(100))
+		payeeCap := new(big.Int).Mul(e.value, big.NewInt(2)) // two payments of e.value
+		return agentpolicy.IAgentPolicyMandateV3{
+			Payees: []common.Address{e.payee, poolStranger}, PayeeDailyCaps: capsOf(payeeCap, agentpolicy.NoPayeeCap),
+			PerTxCap: daily, DailyCap: daily, DailyFeeCap: daily, MaxPaymentsPerDay: 4, Expiry: 4_102_444_800,
+		}
+	})
+	require.NoError(t, e.add(e.pay3(0, e.payee, e.value, e.feeCap)))
+	require.NoError(t, e.add(e.pay3(1, e.payee, e.value, e.feeCap)))
+	require.ErrorIs(t, e.add(e.pay3(2, e.payee, e.value, e.feeCap)), core.ErrAgentPayeeBudgetExceeded)
+	// A replacement of nonce 1 (higher fee) counts once, not on top of the original.
+	bumped := new(big.Int).Div(new(big.Int).Mul(e.feeCap, big.NewInt(12)), big.NewInt(10))
+	require.NoError(t, e.add(e.pay3t(1, e.payee, e.value, bumped, core.AgentMaxTip)))
+	// Another payee is not limited by the first one's pooled value.
+	require.NoError(t, e.add(e.pay3(2, poolStranger, e.value, e.feeCap)))
+	require.NoError(t, e.add(e.pay3(3, poolStranger, e.value, e.feeCap)))
+	// Four pooled: the fifth is over the payment count.
+	require.ErrorIs(t, e.add(e.pay3(4, poolStranger, e.value, e.feeCap)), core.ErrAgentPaymentCountExceeded)
+	// The block takes all four.
+	e.block()
+	st, err := e.tvm.vm.blockChain.State()
+	require.NoError(t, err)
+	require.Equal(t, uint64(4), st.GetNonce(e.agent))
+	head := e.tvm.vm.blockChain.CurrentBlock()
+	require.Equal(t, uint64(4), agentpolicy.PaymentsToday(st, e.agent, head.Time))
+}
+
+// A tightening in a block drops the pooled payments that no longer fit; a guardian freeze drops
+// every pooled payment.
+func TestAgentRulePoolPruneV3(t *testing.T) {
+	m := func(maxPay uint32) func(e *v3PoolEnv) agentpolicy.IAgentPolicyMandateV3 {
+		return func(e *v3PoolEnv) agentpolicy.IAgentPolicyMandateV3 {
+			daily := new(big.Int).Mul(e.charge3(), big.NewInt(100))
+			return agentpolicy.IAgentPolicyMandateV3{
+				Payees: []common.Address{e.payee}, PayeeDailyCaps: capsOf(agentpolicy.NoPayeeCap),
+				PerTxCap: daily, DailyCap: daily, DailyFeeCap: daily, MaxPaymentsPerDay: maxPay, Expiry: 4_102_444_800,
+			}
+		}
+	}
+	e := newV3PoolEnv(t, m(5))
+	// Nonces 1..3 wait behind a gap (queued, not built).
+	for n := uint64(1); n <= 3; n++ {
+		require.NoError(t, e.add(e.pay3(n, e.payee, e.value, e.feeCap)))
+	}
+	_, queued := e.tvm.vm.txPool.ContentFrom(e.agent)
+	require.Len(t, queued, 3)
+	// Tighten to one payment a day: only the first queued one still fits.
+	e.block(e.relayerTx(e.setMandateV3Data(m(1)(e)), 2_000_000))
+	_, queued = e.tvm.vm.txPool.ContentFrom(e.agent)
+	require.Len(t, queued, 1)
+
+	// A guardian freeze drops the rest.
+	gKey, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	g := crypto.PubkeyToAddress(gKey.PublicKey)
+	n := big.NewInt(e.ownerNo)
+	auth := agentAssertion(t, e.owner, agentpolicy.SetGuardianChallenge(e.domain, e.agent, g, n))
+	setG, err := agentpolicy.PackSetGuardian(agentpolicy.SetGuardianInput{Agent: e.agent, Guardian: g, Nonce: n, Auth: auth})
+	require.NoError(t, err)
+	e.ownerNo++
+	sig, err := crypto.Sign(agentpolicy.GuardianFreezeDigest(e.domain, e.agent, common.Big0).Bytes(), gKey)
+	require.NoError(t, err)
+	gf, err := agentpolicy.PackGuardianFreeze(agentpolicy.GuardianFreezeInput{Agent: e.agent, Epoch: common.Big0, Sig: sig})
+	require.NoError(t, err)
+	e.block(e.relayerTx(setG, 300_000), e.relayerTx(gf, 300_000))
+	pending, queued := e.tvm.vm.txPool.ContentFrom(e.agent)
+	require.Empty(t, pending)
+	require.Empty(t, queued)
+}
+
+// On an idle chain, once the pool's clock passes the eta of a loosening, a payment the old
+// mandate refuses is admitted, and the next block (at a time past the eta) includes it.
+func TestAgentRulePoolAdmitsAtEtaOnIdleChain(t *testing.T) {
+	mk := func(e *v3PoolEnv, perTx *big.Int) agentpolicy.IAgentPolicyMandateV3 {
+		daily := new(big.Int).Mul(e.charge3(), big.NewInt(100))
+		return agentpolicy.IAgentPolicyMandateV3{
+			Payees: []common.Address{e.payee}, PayeeDailyCaps: capsOf(agentpolicy.NoPayeeCap),
+			PerTxCap: perTx, DailyCap: daily, DailyFeeCap: daily, MaxPaymentsPerDay: agentpolicy.UnlimitedPayments, Expiry: 4_102_444_800,
+		}
+	}
+	e := newV3PoolEnv(t, func(e *v3PoolEnv) agentpolicy.IAgentPolicyMandateV3 { return mk(e, e.charge3()) })
+	bigPay := e.pay3(0, e.payee, new(big.Int).Mul(e.value, big.NewInt(2)), e.feeCap)
+	require.ErrorIs(t, e.add(bigPay), core.ErrAgentBudgetExceeded)
+	// Loosen perTxCap: scheduled for head time + 60.
+	e.block(e.relayerTx(e.setMandateV3Data(mk(e, new(big.Int).Mul(e.charge3(), big.NewInt(3)))), 2_000_000))
+	require.ErrorIs(t, e.add(bigPay), core.ErrAgentBudgetExceeded)
+	// No block, the clock passes the eta.
+	e.tvm.vm.clock.Set(e.tvm.vm.clock.Time().Add(time.Duration(poolLoosenDelay+5) * time.Second))
+	require.NoError(t, e.add(bigPay))
+	blk := issueAndAccept(t, e.tvm.vm)
+	ethBlock := blk.(*chain.BlockWrapper).Block.(extension.ExtendedBlock).GetEthBlock()
+	require.Len(t, ethBlock.Transactions(), 1)
+	require.Equal(t, bigPay.Hash(), ethBlock.Transactions()[0].Hash())
+}
diff --git a/graft/subnet-evm/precompile/contracts/agentpolicy/clientdata_v3.go b/graft/subnet-evm/precompile/contracts/agentpolicy/clientdata_v3.go
new file mode 100644
index 0000000..a073d85
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/clientdata_v3.go
@@ -0,0 +1,287 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"bytes"
+	"unicode/utf8"
+)
+
+// Strict clientDataJSON checker of rule v3. It accepts a subset of JSON that every decoder reads
+// the same way, in one pass and without allocating:
+//
+//   - exactly one object, nothing before or after it, no whitespace outside strings;
+//   - at most 16 top-level keys, each made of bytes 0x20-0x7e other than '"' and '\', none
+//     repeated (byte comparison);
+//   - "type" and "challenge" exactly once each, as strings without escapes; challenge is compared
+//     bytewise to the 43-character unpadded base64url encoding of the expected hash, never
+//     decoded;
+//   - other values are skipped by syntax: strings (bytes >= 0x20, valid UTF-8, RFC 8259 escapes),
+//     true, false, null, integers -?(0|[1-9][0-9]{0,14}) and objects or arrays nested at most 4
+//     deep (counting the top-level object).
+//
+// Key order is free. Every input it accepts is also accepted by parseClientDataLegacy with the
+// same type and challenge (FuzzAgentPolicyClientDataDifferential).
+
+const (
+	cdMaxKeys  = 16
+	cdMaxDepth = 4
+	cdMaxInt   = 15 // digits after a leading non-zero digit: [1-9][0-9]{0,14}
+)
+
+var (
+	cdKeyType      = []byte("type")
+	cdKeyChallenge = []byte("challenge")
+	cdTypeGet      = []byte("webauthn.get")
+)
+
+type cdScanner struct {
+	b []byte
+	i int
+}
+
+func (p *cdScanner) eat(c byte) bool {
+	if p.i < len(p.b) && p.b[p.i] == c {
+		p.i++
+		return true
+	}
+	return false
+}
+
+func (p *cdScanner) atEnd() bool { return p.i == len(p.b) }
+
+// plainString reads a string of bytes 0x20-0x7e without '"' or '\' and returns its content.
+func (p *cdScanner) plainString() ([]byte, bool) {
+	if !p.eat('"') {
+		return nil, false
+	}
+	start := p.i
+	for p.i < len(p.b) {
+		c := p.b[p.i]
+		switch {
+		case c == '"':
+			s := p.b[start:p.i]
+			p.i++
+			return s, true
+		case c < 0x20 || c > 0x7e || c == '\\':
+			return nil, false
+		}
+		p.i++
+	}
+	return nil, false
+}
+
+func isHex(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+}
+
+// skipString skips a JSON string: bytes >= 0x20, valid UTF-8, RFC 8259 escapes.
+func (p *cdScanner) skipString() bool {
+	if !p.eat('"') {
+		return false
+	}
+	for p.i < len(p.b) {
+		c := p.b[p.i]
+		switch {
+		case c == '"':
+			p.i++
+			return true
+		case c < 0x20:
+			return false
+		case c == '\\':
+			if p.i+1 >= len(p.b) {
+				return false
+			}
+			switch p.b[p.i+1] {
+			case '"', '\\', '/', 'b', 'f', 'n', 'r', 't':
+				p.i += 2
+			case 'u':
+				if p.i+6 > len(p.b) || !isHex(p.b[p.i+2]) || !isHex(p.b[p.i+3]) || !isHex(p.b[p.i+4]) || !isHex(p.b[p.i+5]) {
+					return false
+				}
+				p.i += 6
+			default:
+				return false
+			}
+		case c < utf8.RuneSelf:
+			p.i++
+		default:
+			r, size := utf8.DecodeRune(p.b[p.i:])
+			if r == utf8.RuneError && size <= 1 {
+				return false
+			}
+			p.i += size
+		}
+	}
+	return false
+}
+
+func (p *cdScanner) lit(s string) bool {
+	if len(p.b)-p.i < len(s) || string(p.b[p.i:p.i+len(s)]) != s {
+		return false
+	}
+	p.i += len(s)
+	return true
+}
+
+// skipInt skips -?(0|[1-9][0-9]{0,14}); a fraction or an exponent is refused.
+func (p *cdScanner) skipInt() bool {
+	p.eat('-')
+	if p.i >= len(p.b) {
+		return false
+	}
+	switch c := p.b[p.i]; {
+	case c == '0':
+		p.i++
+	case c >= '1' && c <= '9':
+		p.i++
+		n := 0
+		for p.i < len(p.b) && p.b[p.i] >= '0' && p.b[p.i] <= '9' {
+			if n == cdMaxInt-1 {
+				return false
+			}
+			n++
+			p.i++
+		}
+	default:
+		return false
+	}
+	// The next byte must end the number (a ',' '}' or ']' checked by the caller); a digit after a
+	// leading zero, '.', 'e' or 'E' is refused here.
+	if p.i < len(p.b) {
+		if c := p.b[p.i]; (c >= '0' && c <= '9') || c == '.' || c == 'e' || c == 'E' {
+			return false
+		}
+	}
+	return true
+}
+
+// skipValue skips one value at nesting `depth` (the top-level object is depth 1, so values of its
+// keys are skipped at depth 1 and a container there opens depth 2).
+func (p *cdScanner) skipValue(depth int) bool {
+	if p.i >= len(p.b) {
+		return false
+	}
+	switch c := p.b[p.i]; {
+	case c == '"':
+		return p.skipString()
+	case c == 't':
+		return p.lit("true")
+	case c == 'f':
+		return p.lit("false")
+	case c == 'n':
+		return p.lit("null")
+	case c == '-' || (c >= '0' && c <= '9'):
+		return p.skipInt()
+	case c == '{':
+		if depth+1 > cdMaxDepth {
+			return false
+		}
+		p.i++
+		if p.eat('}') {
+			return true
+		}
+		for {
+			if !p.skipString() || !p.eat(':') || !p.skipValue(depth+1) {
+				return false
+			}
+			if p.eat('}') {
+				return true
+			}
+			if !p.eat(',') {
+				return false
+			}
+		}
+	case c == '[':
+		if depth+1 > cdMaxDepth {
+			return false
+		}
+		p.i++
+		if p.eat(']') {
+			return true
+		}
+		for {
+			if !p.skipValue(depth + 1) {
+				return false
+			}
+			if p.eat(']') {
+				return true
+			}
+			if !p.eat(',') {
+				return false
+			}
+		}
+	}
+	return false
+}
+
+func containsKey(seen [][]byte, k []byte) bool {
+	for _, s := range seen {
+		if bytes.Equal(s, k) {
+			return true
+		}
+	}
+	return false
+}
+
+// scanClientDataV3 checks the grammar and returns the raw "type" and "challenge" values (slices
+// of cd, without escapes by construction).
+func scanClientDataV3(cd []byte) (typ, chal []byte, err error) {
+	p := cdScanner{b: cd}
+	if !p.eat('{') {
+		return nil, nil, ErrBadClientData
+	}
+	var seen [cdMaxKeys][]byte
+	n := 0
+	var gotType, gotChal bool
+	for {
+		k, ok := p.plainString()
+		if !ok || !p.eat(':') || n == len(seen) || containsKey(seen[:n], k) {
+			return nil, nil, ErrBadClientData
+		}
+		seen[n] = k
+		n++
+		switch {
+		case bytes.Equal(k, cdKeyType):
+			if typ, ok = p.plainString(); !ok {
+				return nil, nil, ErrBadClientData
+			}
+			gotType = true
+		case bytes.Equal(k, cdKeyChallenge):
+			if chal, ok = p.plainString(); !ok {
+				return nil, nil, ErrBadClientData
+			}
+			gotChal = true
+		default:
+			if !p.skipValue(1) {
+				return nil, nil, ErrBadClientData
+			}
+		}
+		if p.eat('}') {
+			break
+		}
+		if !p.eat(',') {
+			return nil, nil, ErrBadClientData
+		}
+	}
+	if !p.atEnd() || !gotType || !gotChal {
+		return nil, nil, ErrBadClientData
+	}
+	return typ, chal, nil
+}
+
+// checkClientDataV3 checks clientDataJSON under rule v3 against the expected challenge, given as
+// its 43-character base64url encoding.
+func checkClientDataV3(cd []byte, want *[43]byte) error {
+	typ, chal, err := scanClientDataV3(cd)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(typ, cdTypeGet) {
+		return ErrBadClientDataType
+	}
+	if !bytes.Equal(chal, want[:]) {
+		return ErrChallengeMismatch
+	}
+	return nil
+}
