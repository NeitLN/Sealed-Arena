+// ---- Wycheproof ---------------------------------------------------------------------------
+
+const wycheproofFile = "testdata/wycheproof/ecdsa_secp256r1_sha256_p1363_test.json"
+const wycheproofSHA256 = "c60de693930e386c3a5472d08081623ef8504decc54b38ac01ec6b2a2575c986"
+
+func TestAgentPolicyWycheproofPinned(t *testing.T) {
+	raw, err := os.ReadFile(wycheproofFile)
+	require.NoError(t, err)
+	sum := sha256.Sum256(raw)
+	require.Equal(t, wycheproofSHA256, hex.EncodeToString(sum[:]))
+	src, err := os.ReadFile("testdata/wycheproof/SOURCE")
+	require.NoError(t, err)
+	require.Contains(t, string(src), wycheproofSHA256)
+	_, err = os.Stat("testdata/wycheproof/LICENSE")
+	require.NoError(t, err)
+}
+
+type wycheproofExpect struct {
+	Accepted        int               `json:"accepted"`
+	Rejected        int               `json:"rejected"`
+	HighSFlipped    int               `json:"highSFlipped"`
+	Unrepresentable int               `json:"unrepresentable"`
+	Acceptable      map[string]string `json:"acceptable"`
+}
+
+func to32(t *testing.T, h string) ([32]byte, bool) {
+	b, err := hex.DecodeString(h)
+	require.NoError(t, err)
+	v := new(big.Int).SetBytes(b)
+	if v.BitLen() > 256 {
+		return [32]byte{}, false
+	}
+	return [32]byte(common.BigToHash(v)), true
+}
+
+func TestAgentPolicyWycheproofP256(t *testing.T) {
+	raw, err := os.ReadFile(wycheproofFile)
+	require.NoError(t, err)
+	var file struct {
+		TestGroups []struct {
+			PublicKey struct{ Wx, Wy string } `json:"publicKey"`
+			Tests     []struct {
+				TcID   int    `json:"tcId"`
+				Msg    string `json:"msg"`
+				Sig    string `json:"sig"`
+				Result string `json:"result"`
+			} `json:"tests"`
+		} `json:"testGroups"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &file))
+	got := wycheproofExpect{Acceptable: map[string]string{}}
+	n := elliptic.P256().Params().N
+	for _, g := range file.TestGroups {
+		x, okx := to32(t, g.PublicKey.Wx)
+		y, oky := to32(t, g.PublicKey.Wy)
+		for _, tc := range g.Tests {
+			sig, err := hex.DecodeString(tc.Sig)
+			require.NoError(t, err)
+			if len(sig) != 64 || !okx || !oky {
+				got.Unrepresentable++
+				continue
+			}
+			msg, err := hex.DecodeString(tc.Msg)
+			require.NoError(t, err)
+			digest := sha256.Sum256(msg)
+			r, s := [32]byte(sig[:32]), [32]byte(sig[32:])
+			err = verifyP256(x, y, digest, r, s)
+			switch tc.Result {
+			case "invalid":
+				require.Error(t, err, "tcId %d must be rejected", tc.TcID)
+				got.Rejected++
+			case "valid":
+				if new(big.Int).SetBytes(s[:]).Cmp(p256HalfN) > 0 {
+					require.ErrorIs(t, err, ErrHighS, "tcId %d", tc.TcID)
+					flipped := [32]byte(common.BigToHash(new(big.Int).Sub(n, new(big.Int).SetBytes(s[:]))))
+					require.NoError(t, verifyP256(x, y, digest, r, flipped), "tcId %d with (r, n-s)", tc.TcID)
+					got.HighSFlipped++
+				} else {
+					require.NoError(t, err, "tcId %d must be accepted", tc.TcID)
+					got.Accepted++
+				}
+			default: // acceptable
+				v := "accept"
+				if err != nil {
+					v = "reject"
+				}
+				got.Acceptable[strconv(tc.TcID)] = v
+			}
+		}
+	}
+	t.Logf("wycheproof: accepted %d, rejected %d, high-s flipped %d, unrepresentable %d, acceptable %d",
+		got.Accepted, got.Rejected, got.HighSFlipped, got.Unrepresentable, len(got.Acceptable))
+	rawWant, err := os.ReadFile("testdata/wycheproof_expect.json")
+	require.NoError(t, err)
+	var want wycheproofExpect
+	require.NoError(t, json.Unmarshal(rawWant, &want))
+	if want.Acceptable == nil {
+		want.Acceptable = map[string]string{}
+	}
+	require.Equal(t, want, got)
+}
+
+func strconv(i int) string {
+	return big.NewInt(int64(i)).String()
+}
