+// Calibration of SetMandateV3GasCost: the worst case with 16 payees (a loosening that writes
+// both generations) must stay inside the fixed cost when every write is priced as a new slot
+// (20000) plus the P-256 verification (priced at 50000, above EIP-7951's 6900).
+func TestAgentPolicyV3SetMandateGasCalibration(t *testing.T) {
+	payees := make([]common.Address, MaxPayees)
+	caps := make([]*big.Int, MaxPayees)
+	for i := range payees {
+		payees[i] = common.BigToAddress(big.NewInt(int64(0x1000 + i)))
+		caps[i] = big.NewInt(50)
+	}
+	e := newV3Env(t, true)
+	require.NoError(t, e.setV3(mv3(payees, caps, 10, 100, 50, 5, v3Far)))
+	m := mv3(payees, caps, 10, 200, 50, 5, v3Far)
+	n := e.nonce()
+	in, err := PackSetMandateV3(SetMandateV3Input{Agent: e.agent, M: m, Nonce: n, Auth: e.auth(SetMandateV3Challenge(e.domain(), e.agent, m, n))})
+	require.NoError(t, err)
+	cs := &countingState{StateDB: e.db}
+	_, _, err = AgentPolicyPrecompile.Run(&countingEnv{testEnv: e.testEnv, st: cs}, common.Address{0xaa}, ContractAddress, in, callGas, false)
+	require.NoError(t, err)
+	worst := uint64(cs.writes)*20_000 + 50_000
+	t.Logf("setMandateV3 with %d payees: %d writes, worst-case price %d, fixed cost %d", MaxPayees, cs.writes, worst, SetMandateV3GasCost)
+	require.LessOrEqual(t, worst, SetMandateV3GasCost)
+}
+
+type countingEnv struct {
+	*testEnv
+	st *countingState
+}
+
+func (c *countingEnv) GetStateDB() contract.StateDB { return c.st }
