+// ---- WebAuthn verification fuzzing ------------------------------------------------------
+
+var fuzzKey = func() *ecdsa.PrivateKey {
+	d := new(big.Int).SetBytes(sha256.New().Sum([]byte("sealed-arena fuzz key")))
+	d.Mod(d, elliptic.P256().Params().N)
+	k := new(ecdsa.PrivateKey)
+	k.Curve = elliptic.P256()
+	k.D = d
+	k.X, k.Y = elliptic.P256().ScalarBaseMult(d.Bytes())
+	return k
+}()
+
+func FuzzAgentPolicyVerifyWebAuthn(f *testing.F) {
+	challenge := common.HexToHash("0x5ea1ed")
+	x, y := p256Pub(fuzzKey)
+	cd := stdClientData(challenge)
+	for _, flags := range []byte{0x00, 0x01, 0x04, 0x05, 0x45} {
+		authData := append(make([]byte, 32), flags, 0, 0, 0, 7)
+		ch := sha256.Sum256(cd)
+		digest := sha256.Sum256(append(append([]byte{}, authData...), ch[:]...))
+		r, s, err := ecdsa.Sign(bytes.NewReader(bytes.Repeat([]byte{flags + 1}, 512)), fuzzKey, digest[:])
+		require.NoError(f, err)
+		if s.Cmp(p256HalfN) > 0 {
+			s.Sub(elliptic.P256().Params().N, s)
+		}
+		f.Add(authData, cd, common.BigToHash(r).Bytes(), common.BigToHash(s).Bytes())
+	}
+	f.Fuzz(func(t *testing.T, authData, clientData, rb, sb []byte) {
+		if len(rb) != 32 || len(sb) != 32 {
+			return
+		}
+		auth := mustPack(authArgs, authData, clientData, [32]byte(rb), [32]byte(sb))
+		for _, p := range []proofPolicy{{}, {strict: true}, {strict: true, requireUV: true}} {
+			if verifyWebAuthn(auth, challenge, x, y, p) != nil {
+				continue
+			}
+			// Accepted: the signature must verify over exactly these bytes and s must be low.
+			ch := sha256.Sum256(clientData)
+			digest := sha256.Sum256(append(append([]byte{}, authData...), ch[:]...))
+			s := new(big.Int).SetBytes(sb)
+			pub := &ecdsa.PublicKey{Curve: elliptic.P256(), X: new(big.Int).SetBytes(x[:]), Y: new(big.Int).SetBytes(y[:])}
+			if s.Cmp(p256HalfN) > 0 || !ecdsa.Verify(pub, digest[:], new(big.Int).SetBytes(rb), s) {
+				t.Fatalf("accepted a proof that does not verify")
+			}
+			if len(authData) < 37 || authData[32]&1 == 0 || (p.requireUV && authData[32]&4 == 0) {
+				t.Fatalf("accepted without the required flags")
+			}
+		}
+	})
+}
+
+func FuzzAgentPolicyAuthDecode(f *testing.F) {
+	f.Add(mustPack(authArgs, []byte{1, 2, 3}, []byte("{}"), [32]byte{1}, [32]byte{2}))
+	f.Add([]byte{})
+	f.Fuzz(func(t *testing.T, auth []byte) {
+		authData, clientData, rb, sb, err := decodeAuth(auth)
+		if err != nil {
+			return
+		}
+		if !bytes.Equal(mustPack(authArgs, authData, clientData, rb, sb), auth) {
+			t.Fatalf("decode then encode changed the bytes")
+		}
+	})
+}
