+++ b/graft/subnet-evm/precompile/contracts/agentrulev3/config.go
@@ -0,0 +1,45 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentrulev3
+
+import (
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+var _ precompileconfig.Config = (*Config)(nil)
+
+// Config schedules rule v3. LoosenDelay is part of the config (not a constant of the version) so
+// a local network can exercise the timelock with a short delay; Equal compares it, so two nodes
+// with different delays refuse each other's config as incompatible.
+type Config struct {
+	precompileconfig.Upgrade
+	LoosenDelay uint64 `json:"loosenDelay"` // seconds, required
+}
+
+// NewConfig schedules rule v3 at blockTimestamp with the given loosening delay.
+func NewConfig(blockTimestamp *uint64, loosenDelay uint64) *Config {
+	return &Config{Upgrade: precompileconfig.Upgrade{BlockTimestamp: blockTimestamp}, LoosenDelay: loosenDelay}
+}
+
+func (*Config) Key() string { return ConfigKey }
+
+// Verify refuses disable (v3 changes what owners sign and cannot be undone) and a loosening delay
+// outside [MinLoosenDelay, MaxLoosenDelay].
+func (c *Config) Verify(precompileconfig.ChainConfig) error {
+	if c.Disable {
+		return ErrDisableNotAllowed
+	}
+	if c.LoosenDelay < MinLoosenDelay || c.LoosenDelay > MaxLoosenDelay {
+		return ErrLoosenDelay
+	}
+	return nil
+}
+
+// Equal returns true if s is a *Config scheduled identically with the same delay.
+func (c *Config) Equal(s precompileconfig.Config) bool {
+	other, ok := s.(*Config)
+	if !ok {
+		return false
+	}
+	return c.Upgrade.Equal(&other.Upgrade) && c.LoosenDelay == other.LoosenDelay
+}
