@@ -0,0 +1,109 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package core
+
+import (
+	"errors"
+	"fmt"
+	"math/big"
+	"slices"
+
+	"github.com/ava-labs/libevm/common"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+)
+
+// Sealed Arena validity rule (docs/ARCHITECTURE.md 3.1). A transaction whose sender is
+// a registered agent is valid only inside the agent's mandate. Violations are returned
+// from preCheck, which makes the transaction invalid (it cannot be part of a block),
+// and from the txpool, which refuses it.
+var (
+	ErrAgentContractCreation = errors.New("agent: contract creation not allowed")
+	ErrAgentPayeeNotAllowed  = errors.New("agent: payee not allowed")
+	ErrAgentPayeeHasCode     = errors.New("agent: payee has code")
+	ErrAgentFrozen           = errors.New("agent: frozen")
+	ErrAgentMandateExpired   = errors.New("agent: mandate expired")
+	ErrAgentBudgetExceeded   = errors.New("agent: budget exceeded")
+	ErrAgentTxTypeNotAllowed = errors.New("agent: transaction type not allowed")
+)
+
+// AgentRuleState is the read access the rule needs. Both the EVM state in preCheck
+// and the txpool state satisfy it.
+type AgentRuleState interface {
+	contract.StateReader
+	GetCodeSize(common.Address) int
+}
+
+// AgentTx is the part of a transaction the rule looks at.
+type AgentTx struct {
+	From      common.Address
+	To        *common.Address
+	Value     *big.Int
+	GasLimit  uint64
+	GasFeeCap *big.Int // legacy and access-list transactions: the gas price
+	// Plain is true for transaction types 0, 1 and 2, the only types an agent may send.
+	Plain bool
+}
+
+// AgentCharge returns value + gasLimit * gasFeeCap, the most the transaction can take
+// from the sender. The rule charges this amount, not the gas actually used.
+func AgentCharge(tx AgentTx) *big.Int {
+	charge := new(big.Int).SetUint64(tx.GasLimit)
+	if tx.GasFeeCap != nil {
+		charge.Mul(charge, tx.GasFeeCap)
+	} else {
+		charge.SetUint64(0)
+	}
+	if tx.Value != nil {
+		charge.Add(charge, tx.Value)
+	}
+	return charge
+}
+
+// CheckAgentTx applies the rule. It only reads state. `applies` is false when the
+// sender is not a registered agent, in which case the rule does not constrain the
+// transaction. When `applies` is true and err is nil, `charge` is the amount the
+// caller must record with agentpolicy.ChargeSpend (preCheck only).
+//
+// The caller decides whether the rule is active (AgentPolicy enabled at the block time).
+func CheckAgentTx(state AgentRuleState, timestamp uint64, tx AgentTx) (charge *big.Int, applies bool, err error) {
+	registered, m, frozen, _ := agentpolicy.GetMandateForRule(state, tx.From)
+	if !registered {
+		return nil, false, nil
+	}
+	if !tx.Plain {
+		return nil, true, ErrAgentTxTypeNotAllowed
+	}
+	// 1. no contract creation
+	if tx.To == nil {
+		return nil, true, ErrAgentContractCreation
+	}
+	// 2. payee in the mandate
+	if !slices.Contains(m.Payees, *tx.To) {
+		return nil, true, fmt.Errorf("%w: %s", ErrAgentPayeeNotAllowed, tx.To.Hex())
+	}
+	// 3. payee has no code
+	if state.GetCodeSize(*tx.To) > 0 {
+		return nil, true, fmt.Errorf("%w: %s", ErrAgentPayeeHasCode, tx.To.Hex())
+	}
+	// 4. not frozen
+	if frozen {
+		return nil, true, ErrAgentFrozen
+	}
+	// 5. block.timestamp < expiry
+	if timestamp >= m.Expiry {
+		return nil, true, ErrAgentMandateExpired
+	}
+	// 6. charge <= perTxCap
+	charge = AgentCharge(tx)
+	if charge.Cmp(m.PerTxCap) > 0 {
+		return nil, true, fmt.Errorf("%w: charge %s above perTxCap %s", ErrAgentBudgetExceeded, charge, m.PerTxCap)
+	}
+	// 7. spentToday + charge <= dailyCap (spentToday is zero on a new UTC day)
+	spent := agentpolicy.SpendForDay(state, tx.From, timestamp).SpentToday
+	if total := new(big.Int).Add(spent, charge); total.Cmp(m.DailyCap) > 0 {
+		return nil, true, fmt.Errorf("%w: spentToday %s + charge %s above dailyCap %s", ErrAgentBudgetExceeded, spent, charge, m.DailyCap)
+	}
+	return charge, true, nil
+}
diff --git a/graft/subnet-evm/core/agent_rule_test.go b/graft/subnet-evm/core/agent_rule_test.go
new file mode 100644
index 0000000..f280f75
--- /dev/null
+++ b/graft/subnet-evm/core/agent_rule_test.go
@@ -0,0 +1,443 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package core
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/ava-labs/libevm/accounts/abi"
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/rawdb"
+	"github.com/ava-labs/libevm/core/types"
+	"github.com/ava-labs/libevm/core/vm"
+	"github.com/ava-labs/libevm/crypto"
+	"github.com/ava-labs/libevm/ethdb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/evm/utils"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/consensus/dummy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params/extras"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+)
+
+// ---- fixtures ------------------------------------------------------------------
+
+var (
+	arAgentKey, _   = crypto.HexToECDSA(strings.Repeat("11", 32))
+	arAgent         = crypto.PubkeyToAddress(arAgentKey.PublicKey)
+	arRelayerKey, _ = crypto.HexToECDSA("b71c71a67e1177ad4e901695e1b4b9ee17ae16c6668d313eac2f96dbcda3f291")
+	arRelayer       = crypto.PubkeyToAddress(arRelayerKey.PublicKey)
+	arPayee         = common.HexToAddress("0x00000000000000000000000000000000000000A1")
+	arStranger      = common.HexToAddress("0x00000000000000000000000000000000000000B2")
+	arCodePayee     = common.HexToAddress("0x00000000000000000000000000000000000000C3")
+
+	arCoin       = new(big.Int).Exp(big.NewInt(10), big.NewInt(18), nil)
+	arFeeCap     = big.NewInt(1_000_000_000_000) // 1000 gwei, above any base fee in these tests
+	arTip        = big.NewInt(1_000_000_000)
+	arAgentFunds = new(big.Int).Mul(arCoin, big.NewInt(100))
+	arTransfer   = uint64(21_000)
+	// charge of a plain transfer with value v: v + 21000 * 1000 gwei
+	arGasCharge = new(big.Int).Mul(new(big.Int).SetUint64(arTransfer), arFeeCap)
+)
+
+func arCharge(value *big.Int, gas uint64) *big.Int {
+	return new(big.Int).Add(value, new(big.Int).Mul(new(big.Int).SetUint64(gas), arFeeCap))
+}
+
+func arConfig() *params.ChainConfig {
+	return params.WithExtra(
+		&params.ChainConfig{
+			ChainID:             big.NewInt(1),
+			HomesteadBlock:      big.NewInt(0),
+			EIP150Block:         big.NewInt(0),
+			EIP155Block:         big.NewInt(0),
+			EIP158Block:         big.NewInt(0),
+			ByzantiumBlock:      big.NewInt(0),
+			ConstantinopleBlock: big.NewInt(0),
+			PetersburgBlock:     big.NewInt(0),
+			IstanbulBlock:       big.NewInt(0),
+			MuirGlacierBlock:    big.NewInt(0),
+			BerlinBlock:         big.NewInt(0),
+			LondonBlock:         big.NewInt(0),
+		},
+		&extras.ChainConfig{
+			FeeConfig: params.DefaultFeeConfig,
+			NetworkUpgrades: extras.NetworkUpgrades{
+				SubnetEVMTimestamp: utils.PointerTo[uint64](0),
+			},
+			GenesisPrecompiles: extras.Precompiles{
+				agentpolicy.ConfigKey: agentpolicy.NewConfig(utils.PointerTo[uint64](0)),
+			},
+		},
+	)
+}
+
+// arEnv is a chain where block 1 registers the agent (and sets its mandate, if any),
+// with helpers to extend it by valid blocks and to try hand-built invalid blocks.
+type arEnv struct {
+	t       *testing.T
+	chain   *BlockChain
+	gspec   *Genesis
+	gendb   ethdb.Database
+	signer  types.Signer
+	owner   *ecdsa.PrivateKey
+	nonces  map[common.Address]uint64
+	ownerNo uint64
+	head    *types.Block
+}
+
+func newArEnv(t *testing.T, m *agentpolicy.IAgentPolicyMandate) *arEnv {
+	t.Helper()
+	config := arConfig()
+	gspec := &Genesis{
+		Config: config,
+		Alloc: types.GenesisAlloc{
+			arAgent:     {Balance: arAgentFunds},
+			arRelayer:   {Balance: new(big.Int).Mul(arCoin, big.NewInt(1000))},
+			arCodePayee: {Balance: common.Big0, Code: []byte{0x00}}, // STOP
+		},
+		GasLimit: params.GetExtra(config).FeeConfig.GasLimit.Uint64(),
+	}
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), DefaultCacheConfig, gspec, dummy.NewCoinbaseFaker(), vm.Config{}, common.Hash{}, false)
+	require.NoError(t, err)
+	t.Cleanup(chain.Stop)
+
+	owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	e := &arEnv{t: t, chain: chain, gspec: gspec, signer: types.LatestSigner(config), owner: owner, nonces: map[common.Address]uint64{}}
+
+	setup := []*types.Transaction{e.relayerCall(e.registerData(), 300_000)}
+	if m != nil {
+		setup = append(setup, e.relayerCall(e.setMandateData(*m), 1_000_000))
+	}
+	gendb, blocks, _, err := GenerateChainWithGenesis(gspec, dummy.NewCoinbaseFaker(), 1, 10, func(_ int, b *BlockGen) {
+		for _, tx := range setup {
+			b.AddTx(tx)
+		}
+	})
+	require.NoError(t, err)
+	e.gendb = gendb
+	e.insert(blocks[0])
+	return e
+}
+
+func (e *arEnv) chainID() *big.Int { return e.gspec.Config.ChainID }
+
+func (e *arEnv) sign(key *ecdsa.PrivateKey, to *common.Address, value *big.Int, gas uint64, data []byte) *types.Transaction {
+	from := crypto.PubkeyToAddress(key.PublicKey)
+	tx, err := types.SignNewTx(key, e.signer, &types.DynamicFeeTx{
+		ChainID: e.chainID(), Nonce: e.nonces[from], GasTipCap: arTip, GasFeeCap: arFeeCap,
+		Gas: gas, To: to, Value: value, Data: data,
+	})
+	require.NoError(e.t, err)
+	e.nonces[from]++ // undone by e.bad when the block is rejected
+	return tx
+}
+
+func (e *arEnv) agentTx(to *common.Address, value *big.Int, gas uint64, data []byte) *types.Transaction {
+	return e.sign(arAgentKey, to, value, gas, data)
+}
+
+func (e *arEnv) pay(value int64) *types.Transaction {
+	return e.agentTx(&arPayee, big.NewInt(value), arTransfer, nil)
+}
+
+func (e *arEnv) relayerCall(data []byte, gas uint64) *types.Transaction {
+	to := agentpolicy.ContractAddress
+	return e.sign(arRelayerKey, &to, common.Big0, gas, data)
+}
+
+func (e *arEnv) registerData() []byte {
+	x, y := [32]byte(common.BigToHash(e.owner.X)), [32]byte(common.BigToHash(e.owner.Y))
+	sig, err := crypto.Sign(agentpolicy.RegisterDigest(e.chainID(), arAgent, x, y).Bytes(), arAgentKey)
+	require.NoError(e.t, err)
+	data, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: arAgent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(e.t, err)
+	return data
+}
+
+// assertion signs `challenge` with the owner passkey as a WebAuthn authenticator would.
+func (e *arEnv) assertion(challenge common.Hash) []byte {
+	authData := append(make([]byte, 32), 0x05, 0, 0, 0, 1)
+	clientData := []byte(`{"type":"webauthn.get","challenge":"` + base64.RawURLEncoding.EncodeToString(challenge.Bytes()) + `"}`)
+	ch := sha256.Sum256(clientData)
+	digest := sha256.Sum256(append(append([]byte{}, authData...), ch[:]...))
+	r, s, err := ecdsa.Sign(rand.Reader, e.owner, digest[:])
+	require.NoError(e.t, err)
+	if half := new(big.Int).Rsh(elliptic.P256().Params().N, 1); s.Cmp(half) > 0 {
+		s.Sub(elliptic.P256().Params().N, s)
+	}
+	tBytes, _ := abi.NewType("bytes", "", nil)
+	tB32, _ := abi.NewType("bytes32", "", nil)
+	auth, err := abi.Arguments{{Type: tBytes}, {Type: tBytes}, {Type: tB32}, {Type: tB32}}.Pack(
+		authData, clientData, [32]byte(common.BigToHash(r)), [32]byte(common.BigToHash(s)))
+	require.NoError(e.t, err)
+	return auth
+}
+
+func (e *arEnv) setMandateData(m agentpolicy.IAgentPolicyMandate) []byte {
+	nonce := new(big.Int).SetUint64(e.ownerNo)
+	auth := e.assertion(agentpolicy.SetMandateChallenge(e.chainID(), arAgent, m, nonce))
+	data, err := agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: arAgent, M: m, Nonce: nonce, Auth: auth})
+	require.NoError(e.t, err)
+	e.ownerNo++
+	return data
+}
+
+func (e *arEnv) freezeData(freeze bool) []byte {
+	nonce := new(big.Int).SetUint64(e.ownerNo)
+	var data []byte
+	var err error
+	if freeze {
+		data, err = agentpolicy.PackFreeze(agentpolicy.FreezeInput{Agent: arAgent, Nonce: nonce, Auth: e.assertion(agentpolicy.FreezeChallenge(e.chainID(), arAgent, nonce))})
+	} else {
+		data, err = agentpolicy.PackUnfreeze(agentpolicy.UnfreezeInput{Agent: arAgent, Nonce: nonce, Auth: e.assertion(agentpolicy.UnfreezeChallenge(e.chainID(), arAgent, nonce))})
+	}
+	require.NoError(e.t, err)
+	e.ownerNo++
+	return data
+}
+
+func (e *arEnv) insert(b *types.Block) {
+	e.t.Helper()
+	_, err := e.chain.InsertChain(types.Blocks{b})
+	require.NoError(e.t, err)
+	e.head = b
+}
+
+// good builds and inserts one valid block `gap` seconds after the head; it returns the receipts.
+func (e *arEnv) good(gap uint64, txs ...*types.Transaction) types.Receipts {
+	e.t.Helper()
+	blocks, receipts, err := GenerateChain(e.gspec.Config, e.head, dummy.NewCoinbaseFaker(), e.gendb, 1, gap, func(_ int, b *BlockGen) {
+		for _, tx := range txs {
+			b.AddTx(tx)
+		}
+	})
+	require.NoError(e.t, err)
+	e.insert(blocks[0])
+	return receipts[0]
+}
+
+// bad builds a block by hand that contains `txs` (no validity check while building)
+// and returns the error from inserting it. The chain head must not move.
+func (e *arEnv) bad(txs ...*types.Transaction) error {
+	e.t.Helper()
+	block := GenerateBadBlock(e.head, dummy.NewCoinbaseFaker(), txs, e.gspec.Config)
+	_, err := e.chain.InsertChain(types.Blocks{block})
+	require.Equal(e.t, e.head.Hash(), e.chain.CurrentBlock().Hash(), "rejected block must not become head")
+	for _, tx := range txs {
+		from, _ := types.Sender(e.signer, tx)
+		e.nonces[from]--
+	}
+	return err
+}
+
+func (e *arEnv) spend() agentpolicy.Spend {
+	st, err := e.chain.State()
+	require.NoError(e.t, err)
+	return agentpolicy.SpendForDay(st, arAgent, e.head.Time())
+}
+
+func (e *arEnv) balance(a common.Address) *big.Int {
+	st, err := e.chain.State()
+	require.NoError(e.t, err)
+	return st.GetBalance(a).ToBig()
+}
+
+// checkInvariant: balance(agent) >= funded - totalCharged (docs/ARCHITECTURE.md 3.1).
+func (e *arEnv) checkInvariant() {
+	e.t.Helper()
+	floor := new(big.Int).Sub(arAgentFunds, e.spend().TotalCharged)
+	require.GreaterOrEqual(e.t, e.balance(arAgent).Cmp(floor), 0, "balance %s below funded - totalCharged %s", e.balance(arAgent), floor)
+}
+
+func arMandate(payees []common.Address, perTx, daily *big.Int, expiry uint64) *agentpolicy.IAgentPolicyMandate {
+	return &agentpolicy.IAgentPolicyMandate{Payees: payees, PerTxCap: perTx, DailyCap: daily, Expiry: expiry}
+}
+
+var arFarFuture = uint64(4_102_444_800)
+
+func arBigMandate() *agentpolicy.IAgentPolicyMandate {
+	return arMandate([]common.Address{arPayee, arCodePayee, agentpolicy.ContractAddress}, arCoin, new(big.Int).Mul(arCoin, big.NewInt(5)), arFarFuture)
+}
+
+// ---- tests -----------------------------------------------------------------------
+
+func TestAgentRuleRegisteredWithoutMandateRejectsEverything(t *testing.T) {
+	e := newArEnv(t, nil)
+	require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentPayeeNotAllowed)
+	require.ErrorIs(t, e.bad(e.agentTx(&arStranger, big.NewInt(1), arTransfer, nil)), ErrAgentPayeeNotAllowed)
+	require.ErrorIs(t, e.bad(e.agentTx(nil, common.Big0, 100_000, []byte{0x00})), ErrAgentContractCreation)
+	e.checkInvariant()
+}
+
+func TestAgentRuleAllowedPaymentIsChargedAtMaximum(t *testing.T) {
+	e := newArEnv(t, arBigMandate())
+	value := big.NewInt(12345)
+	receipts := e.good(10, e.pay(value.Int64()))
+	require.Equal(t, types.ReceiptStatusSuccessful, receipts[0].Status)
+	require.Equal(t, value, e.balance(arPayee))
+
+	want := arCharge(value, arTransfer)
+	sp := e.spend()
+	require.Equal(t, 0, want.Cmp(sp.SpentToday), "spentToday %s want %s", sp.SpentToday, want)
+	require.Equal(t, 0, want.Cmp(sp.TotalCharged))
+	// The counter is at least what really left the account (gas is charged at the cap).
+	left := new(big.Int).Sub(arAgentFunds, e.balance(arAgent))
+	require.GreaterOrEqual(t, sp.TotalCharged.Cmp(left), 0)
+	e.checkInvariant()
+}
+
+func TestAgentRuleConditions(t *testing.T) {
+	t.Run("1 contract creation", func(t *testing.T) {
+		e := newArEnv(t, arBigMandate())
+		require.ErrorIs(t, e.bad(e.agentTx(nil, common.Big0, 100_000, []byte{0x60, 0x00})), ErrAgentContractCreation)
+	})
+
+	t.Run("2 payee not in the mandate", func(t *testing.T) {
+		e := newArEnv(t, arBigMandate())
+		require.ErrorIs(t, e.bad(e.agentTx(&arStranger, big.NewInt(1), arTransfer, nil)), ErrAgentPayeeNotAllowed)
+		e.good(10, e.pay(1)) // a listed payee goes through
+	})
+
+	t.Run("3 listed payee with code", func(t *testing.T) {
+		e := newArEnv(t, arBigMandate())
+		require.ErrorIs(t, e.bad(e.agentTx(&arCodePayee, big.NewInt(1), 50_000, nil)), ErrAgentPayeeHasCode)
+	})
+
+	t.Run("5 expiry: valid before, rejected from timestamp == expiry", func(t *testing.T) {
+		// Block 1 is at t=10. Expiry 40: blocks at 20 and 30 pass, the block at 40 fails.
+		e := newArEnv(t, arMandate([]common.Address{arPayee}, arCoin, new(big.Int).Mul(arCoin, big.NewInt(5)), 40))
+		e.good(10, e.pay(1))
+		e.good(10, e.pay(1))
+		require.Equal(t, uint64(30), e.head.Time())
+		require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentMandateExpired) // GenerateBadBlock uses parent + 10 = 40
+	})
+
+	t.Run("6 perTxCap: charge == cap passes, cap + 1 fails", func(t *testing.T) {
+		perTx := new(big.Int).Mul(arCoin, big.NewInt(1))
+		e := newArEnv(t, arMandate([]common.Address{arPayee}, perTx, new(big.Int).Mul(arCoin, big.NewInt(5)), arFarFuture))
+		atCap := new(big.Int).Sub(perTx, arGasCharge)
+		over := new(big.Int).Add(atCap, common.Big1)
+		require.ErrorIs(t, e.bad(e.agentTx(&arPayee, over, arTransfer, nil)), ErrAgentBudgetExceeded)
+		e.good(10, e.agentTx(&arPayee, atCap, arTransfer, nil))
+		require.Equal(t, 0, perTx.Cmp(e.spend().SpentToday))
+	})
+
+	t.Run("7 dailyCap: spent + charge == cap passes, one more wei fails (hand-built block)", func(t *testing.T) {
+		value := big.NewInt(1000)
+		charge := arCharge(value, arTransfer)
+		daily := new(big.Int).Mul(charge, big.NewInt(3))
+		e := newArEnv(t, arMandate([]common.Address{arPayee}, charge, daily, arFarFuture))
+		e.good(10, e.pay(1000), e.pay(1000), e.pay(1000))
+		require.Equal(t, 0, daily.Cmp(e.spend().SpentToday))
+		require.ErrorIs(t, e.bad(e.pay(0)), ErrAgentBudgetExceeded)
+
+		// Same budget, but the third payment is 1 wei over: the block holding all three fails.
+		e2 := newArEnv(t, arMandate([]common.Address{arPayee}, new(big.Int).Add(charge, common.Big1), daily, arFarFuture))
+		require.ErrorIs(t, e2.bad(e2.pay(1000), e2.pay(1000), e2.pay(1001)), ErrAgentBudgetExceeded)
+		e2.checkInvariant()
+	})
+
+	t.Run("other transaction types", func(t *testing.T) {
+		e := newArEnv(t, arBigMandate())
+		st, err := e.chain.State()
+		require.NoError(t, err)
+		_, applies, err := CheckAgentTx(st, e.head.Time(), AgentTx{From: arAgent, To: &arPayee, Value: common.Big1, GasLimit: arTransfer, GasFeeCap: arFeeCap, Plain: false})
+		require.True(t, applies)
+		require.ErrorIs(t, err, ErrAgentTxTypeNotAllowed)
+	})
+}
+
+// Stateful precompiles (AgentPolicy and the other 0x02…/0x03… modules) carry
+// placeholder code, so they count as "payee has code" and are refused.
+func TestAgentRulePrecompileAddressesCountAsCode(t *testing.T) {
+	e := newArEnv(t, arBigMandate())
+	to := agentpolicy.ContractAddress
+	require.ErrorIs(t, e.bad(e.agentTx(&to, common.Big0, 60_000, []byte{0xde, 0xad, 0xbe, 0xef})), ErrAgentPayeeHasCode)
+	e.checkInvariant()
+}
+
+// Native precompiles (0x01–0x0a, 0x100) have no code in state, so an owner may
+// list one as a payee. A call to it with bad input fails during execution after
+// preCheck has recorded the spend: the transaction is included with a failed
+// receipt and the full charge stays on the counter.
+func TestAgentRuleRevertedExecutionIsStillCharged(t *testing.T) {
+	bn256Add := common.BytesToAddress([]byte{0x06})
+	m := arMandate([]common.Address{arPayee, bn256Add}, arCoin, new(big.Int).Mul(arCoin, big.NewInt(5)), arFarFuture)
+	e := newArEnv(t, m)
+	gas := uint64(100_000)
+	bad := make([]byte, 128)
+	for i := range bad {
+		bad[i] = 0xff // not points on the curve: the precompile returns an error
+	}
+	receipts := e.good(10, e.agentTx(&bn256Add, common.Big0, gas, bad))
+	require.Equal(t, types.ReceiptStatusFailed, receipts[0].Status)
+	want := arCharge(common.Big0, gas)
+	sp := e.spend()
+	require.Equal(t, 0, want.Cmp(sp.TotalCharged), "totalCharged %s want %s", sp.TotalCharged, want)
+	require.Equal(t, 0, want.Cmp(sp.SpentToday))
+	e.checkInvariant()
+}
+
+// Gas below the intrinsic cost is not a revert: the transaction is invalid, the
+// block holding it is rejected, and nothing is charged.
+func TestAgentRuleIntrinsicGasFailureIsInvalidNotCharged(t *testing.T) {
+	e := newArEnv(t, arBigMandate())
+	require.ErrorIs(t, e.bad(e.agentTx(&arPayee, big.NewInt(1), 20_000, nil)), ErrIntrinsicGas)
+	require.Equal(t, 0, e.spend().TotalCharged.Sign())
+}
+
+func TestAgentRuleNewDayResetsDailyBudget(t *testing.T) {
+	value := big.NewInt(1000)
+	charge := arCharge(value, arTransfer)
+	e := newArEnv(t, arMandate([]common.Address{arPayee}, charge, charge, arFarFuture))
+	e.good(10, e.pay(1000))
+	require.ErrorIs(t, e.bad(e.pay(1000)), ErrAgentBudgetExceeded)
+
+	e.good(86_400, e.pay(1000)) // next UTC day
+	sp := e.spend()
+	require.Equal(t, 0, charge.Cmp(sp.SpentToday))
+	require.Equal(t, 0, new(big.Int).Mul(charge, big.NewInt(2)).Cmp(sp.TotalCharged), "totalCharged keeps history")
+	e.checkInvariant()
+}
+
+func TestAgentRuleFreezeAndUnfreeze(t *testing.T) {
+	e := newArEnv(t, arBigMandate())
+	e.good(10, e.pay(1))
+	r := e.good(10, e.relayerCall(e.freezeData(true), 300_000)) // block N
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentFrozen) // block N+1
+
+	r = e.good(10, e.relayerCall(e.freezeData(false), 300_000))
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	e.good(10, e.pay(1))
+	e.checkInvariant()
+}
+
+func TestAgentRuleMandateChangeTakesEffectNextTx(t *testing.T) {
+	e := newArEnv(t, arBigMandate())
+	e.good(10, e.pay(1))
+	// The owner removes every payee; the agent's next payment is invalid.
+	e.good(10, e.relayerCall(e.setMandateData(*arMandate(nil, arCoin, arCoin, arFarFuture)), 1_000_000))
+	require.ErrorIs(t, e.bad(e.pay(1)), ErrAgentPayeeNotAllowed)
+}
+
+func TestAgentRuleOtherSendersUnaffected(t *testing.T) {
+	e := newArEnv(t, arBigMandate())
+	r := e.good(10,
+		e.sign(arRelayerKey, &arStranger, big.NewInt(7), arTransfer, nil),
+		e.sign(arRelayerKey, nil, common.Big0, 100_000, []byte{0x60, 0x00, 0x60, 0x00, 0xf3}),
+	)
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	require.Equal(t, types.ReceiptStatusSuccessful, r[1].Status)
+	require.Equal(t, big.NewInt(7), e.balance(arStranger))
+}
