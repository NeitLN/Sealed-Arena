+func TestAgentPolicyChargeSpendOverflow(t *testing.T) {
+	e := newEnv(t, big.NewInt(261126))
+	agent := common.HexToAddress("0x00000000000000000000000000000000000000a2")
+	maxU256 := new(big.Int).Sub(new(big.Int).Lsh(common.Big1, 256), common.Big1)
+	require.NoError(t, ChargeSpend(e.db, agent, maxU256, 100))
+	require.ErrorIs(t, ChargeSpend(e.db, agent, common.Big1, 100), ErrCounterOverflow)
