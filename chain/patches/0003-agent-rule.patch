+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentrulev2
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/evm/utils"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+func TestAgentRuleV2ConfigVerifyRejectsDisable(t *testing.T) {
+	require.NoError(t, NewConfig(utils.PointerTo[uint64](100)).Verify(nil))
+	disable := &Config{Upgrade: precompileconfig.Upgrade{BlockTimestamp: utils.PointerTo[uint64](200), Disable: true}}
+	require.ErrorIs(t, disable.Verify(nil), ErrDisableNotAllowed)
+}
+
+func TestAgentRuleV2ConfigEqual(t *testing.T) {
+	a := NewConfig(utils.PointerTo[uint64](100))
+	require.True(t, a.Equal(NewConfig(utils.PointerTo[uint64](100))))
+	require.False(t, a.Equal(NewConfig(utils.PointerTo[uint64](101))))
+	require.Equal(t, ConfigKey, a.Key())
+}
diff --git a/graft/subnet-evm/precompile/contracts/agentrulev2/module.go b/graft/subnet-evm/precompile/contracts/agentrulev2/module.go
new file mode 100644
index 0000000..ab33f06
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentrulev2/module.go
@@ -0,0 +1,67 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+// Package agentrulev2 activates version 2 of the Sealed Arena agent rule. It is a config-only
+// precompile: scheduling "agentRuleV2Config" in precompileUpgrades at a timestamp T makes the rule
+// v2 from T on, so blocks before T keep their v1 meaning when a node re-executes history. The
+// contract has no functions. Activation is one-way (Verify refuses disable).
+package agentrulev2
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/ava-labs/libevm/common"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/modules"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+var _ contract.Configurator = (*configurator)(nil)
+
+// ConfigKey is the key used in json config files to schedule rule v2.
+const ConfigKey = "agentRuleV2Config"
+
+// ContractAddress is the address of the marker precompile, next to AgentPolicy.
+var ContractAddress = common.HexToAddress("0x0300000000000000000000000000000000000002")
+
+// ErrDisableNotAllowed is returned by Verify for an upgrade that disables rule v2.
+var ErrDisableNotAllowed = errors.New("agentrulev2: rule v2 cannot be disabled once scheduled")
+
+// Contract has no functions; any call to it fails.
+var Contract = func() contract.StatefulPrecompiledContract {
+	c, err := contract.NewStatefulPrecompileContract(nil, nil)
+	if err != nil {
+		panic(err)
+	}
+	return c
+}()
+
+// Module registers the precompile.
+var Module = modules.Module{
+	ConfigKey:    ConfigKey,
+	Address:      ContractAddress,
+	Contract:     Contract,
+	Configurator: &configurator{},
+}
+
+type configurator struct{}
+
+func init() {
+	if err := modules.RegisterModule(Module); err != nil {
+		panic(err)
+	}
+}
+
+func (*configurator) MakeConfig() precompileconfig.Config { return new(Config) }
+
+// Configure writes the rule version into AgentPolicy's storage at activation, before any
+// transaction of the activating block, so the precompile can read it (agentpolicy.RuleVersion).
+func (*configurator) Configure(_ precompileconfig.ChainConfig, cfg precompileconfig.Config, state contract.StateDB, _ contract.ConfigurationBlockContext) error {
+	if _, ok := cfg.(*Config); !ok {
+		return fmt.Errorf("expected config type %T, got %T: %v", &Config{}, cfg, cfg)
+	}
+	agentpolicy.SetRuleVersion(state, 2)
+	return nil
+}
