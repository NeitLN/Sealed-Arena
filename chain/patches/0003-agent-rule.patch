+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+)
+
+// agentTx2 signs a type 2 transaction from the agent with the given tip, gas and data.
+func (e *arEnv) agentTx2(to *common.Address, value *big.Int, gas uint64, tip *big.Int, data []byte, al types.AccessList) *types.Transaction {
+	tx, err := types.SignNewTx(arAgentKey, e.signer, &types.DynamicFeeTx{
+		ChainID: e.chainID(), Nonce: e.nonces[arAgent], GasTipCap: tip, GasFeeCap: arFeeCap,
+		Gas: gas, To: to, Value: value, Data: data, AccessList: al,
+	})
+	require.NoError(e.t, err)
+	e.nonces[arAgent]++
+	return tx
+}
+
+var arFiveGwei = big.NewInt(5_000_000_000)
+
+// Before the switch, v1 holds (a 5 gwei tip is fine); from the block at T the same payment is
+// invalid, and a payment within the v2 limits goes through.
+func TestAgentRuleV2ActivationBoundary(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(40), dummy.NewCoinbaseFaker())
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, arFiveGwei, nil, nil))                                    // t = 20
+	e.good(10, e.agentTx2(&arPayee, common.Big1, 30_000, arFiveGwei, nil, nil))                                        // t = 30, gas 30000 too
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, common.Big1, arTransfer, arFiveGwei, nil, nil)), ErrAgentTipTooHigh) // t = 40
+	receipts := e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, AgentMaxTip, nil, nil))                       // t = 40
+	require.Equal(t, types.ReceiptStatusSuccessful, receipts[0].Status)
+	require.Equal(t, arTransfer, receipts[0].GasUsed)
+	e.checkInvariant()
+}
+
+func TestAgentRuleV2GasDataAndAccessList(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(0), dummy.NewCoinbaseFaker())
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, common.Big1, arTransfer+1, arTip, nil, nil)), ErrAgentGasLimit)
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, common.Big1, 30_000, arTip, []byte{0x01}, nil)), ErrAgentGasLimit)
+	// Gas below the transfer cost: the agent check in preCheck refuses it before the intrinsic
+	// gas check; either way the transaction is invalid and nothing is charged.
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, common.Big1, arTransfer-1, arTip, nil, nil)), ErrAgentGasLimit)
+	require.Equal(t, 0, e.spend().TotalCharged.Sign())
+	// Data or an access list with exactly 21000 gas: refused (intrinsic gas fails first for data).
+	al := types.AccessList{{Address: arStranger}}
+	err := e.bad(e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, al))
+	require.Error(t, err)
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil))
+	e.checkInvariant()
+}
+
+func TestAgentRuleV2TipCap(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(0), dummy.NewCoinbaseFaker())
+	over := new(big.Int).Add(AgentMaxTip, common.Big1)
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, common.Big1, arTransfer, over, nil, nil)), ErrAgentTipTooHigh)
+	receipts := e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, AgentMaxTip, nil, nil))
+	require.Equal(t, types.ReceiptStatusSuccessful, receipts[0].Status)
+	// A legacy payment pays gasPrice - baseFee as its tip: 1000 gwei here, far above the cap.
+	require.ErrorIs(t, e.bad(e.sign0(&arPayee, common.Big1)), ErrAgentTipTooHigh)
+}
+
+func (e *arEnv) sign0(to *common.Address, value *big.Int) *types.Transaction {
+	tx, err := types.SignNewTx(arAgentKey, e.signer, &types.LegacyTx{
+		Nonce: e.nonces[arAgent], GasPrice: arFeeCap, Gas: arTransfer, To: to, Value: value,
+	})
+	require.NoError(e.t, err)
+	e.nonces[arAgent]++
+	return tx
+}
+
+func TestAgentRuleV2NativePrecompilePayeeRefused(t *testing.T) {
+	bn256Add := common.BytesToAddress([]byte{0x06})
+	m := arMandate([]common.Address{arPayee, bn256Add}, arCoin, new(big.Int).Mul(arCoin, big.NewInt(5)), arFarFuture)
+	e := newArEnvWith(t, m, arConfigV2At(0), dummy.NewCoinbaseFaker())
+	require.ErrorIs(t, e.bad(e.agentTx2(&bn256Add, common.Big0, arTransfer, arTip, nil, nil)), ErrAgentPayeeIsPrecompile)
+	require.Equal(t, 0, e.spend().TotalCharged.Sign())
+	require.True(t, IsNativePrecompile(common.BytesToAddress([]byte{0x01})))
+	require.True(t, IsNativePrecompile(common.BytesToAddress([]byte{0x0a})))
+	require.True(t, IsNativePrecompile(common.HexToAddress("0x0000000000000000000000000000000000000100")))
+	require.False(t, IsNativePrecompile(common.BytesToAddress([]byte{0x0b})))
+	require.False(t, IsNativePrecompile(arPayee))
+}
+
+func TestAgentRuleV2TxTypeWhitelist(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(0), dummy.NewCoinbaseFaker())
+	st, err := e.chain.State()
+	require.NoError(t, err)
+	for _, typ := range []uint8{3, 4, 0x7f} {
+		_, applies, err := CheckAgentTx(st, e.head.Time(), AgentTx{
+			From: arAgent, To: &arPayee, Value: common.Big1, GasLimit: arTransfer, GasFeeCap: arFeeCap,
+			Plain: true, V2: true, TxType: typ, GasTipCap: arTip,
+		})
+		require.True(t, applies)
+		require.ErrorIs(t, err, ErrAgentTxTypeNotAllowed, "type %d", typ)
+	}
+	for _, typ := range []uint8{0, 1, 2} {
+		_, _, err := CheckAgentTx(st, e.head.Time(), AgentTx{
+			From: arAgent, To: &arPayee, Value: common.Big1, GasLimit: arTransfer, GasFeeCap: arFeeCap,
+			Plain: true, V2: true, TxType: typ, GasTipCap: arTip,
+		})
+		require.NoError(t, err, "type %d", typ)
+	}
+}
+
+// A set-code authorization naming a registered agent makes the transaction invalid from v2 on,
+// whoever sends it; before v2 it is not checked. (No such transaction decodes at the pinned
+// version, so the message is built by hand.)
+func TestAgentRuleV2SetCodeAuthorityRefused(t *testing.T) {
+	run := func(cfgV2 bool, authorities []common.Address) error {
+		cfg := arConfig()
+		if cfgV2 {
+			cfg = arConfigV2At(0)
+		}
+		e := newArEnvWith(t, arBigMandate(), cfg, dummy.NewCoinbaseFaker())
+		st, err := e.chain.State()
+		require.NoError(t, err)
+		msg := &Message{
+			From: arRelayer, To: &arStranger, Nonce: st.GetNonce(arRelayer), Value: common.Big1,
+			GasLimit: arTransfer, GasPrice: arFeeCap, GasFeeCap: arFeeCap, GasTipCap: arTip,
+			SetCodeAuthorities: authorities,
+		}
+		_, _, err = e.applyMessage(msg)
+		return err
+	}
+	require.ErrorIs(t, run(true, []common.Address{arAgent}), ErrAgentSetCodeAuthority)
+	require.NoError(t, run(true, []common.Address{arStranger}))
+	require.NoError(t, run(false, []common.Address{arAgent}))
+}
+
+// A node syncing from genesis re-executes blocks from both sides of the switch and reaches the
+// same head: blocks before T stay valid under v1 even though they would be invalid under v2.
+func TestAgentRuleV2GenesisReplay(t *testing.T) {
+	cfg := arConfigV2At(40)
+	e := newArEnvWith(t, arBigMandate(), cfg, dummy.NewCoinbaseFaker())
+	e.good(10, e.agentTx2(&arPayee, common.Big1, 30_000, arFiveGwei, nil, nil))      // t = 20, v1 only
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, arFiveGwei, nil, nil))  // t = 30, v1 only
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, AgentMaxTip, nil, nil)) // t = 40, v2
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, AgentMaxTip, nil, nil)) // t = 50, v2
+
+	fresh, err := NewBlockChain(rawdb.NewMemoryDatabase(), DefaultCacheConfig, e.gspec, dummy.NewCoinbaseFaker(), vm.Config{}, common.Hash{}, false)
+	require.NoError(t, err)
+	defer fresh.Stop()
+	var blocks types.Blocks
+	for n := uint64(1); n <= e.head.NumberU64(); n++ {
+		blocks = append(blocks, e.chain.GetBlockByNumber(n))
+	}
+	_, err = fresh.InsertChain(blocks)
+	require.NoError(t, err)
+	require.Equal(t, e.head.Hash(), fresh.CurrentBlock().Hash())
+	st, err := fresh.State()
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), agentpolicy.RuleVersion(st))
+}
+
+// The effective tip is min(tipCap, feeCap - baseFee): what the block producer gets per gas. A
+// payment whose declared tip is above the cap but whose fee cap leaves less than the cap above
+// the base fee is valid, legacy ones included (their tip is gasPrice - baseFee).
+func TestAgentRuleV2EffectiveTipUsesBaseFee(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(0), dummy.NewCoinbaseFaker())
+	st, err := e.chain.State()
+	require.NoError(t, err)
+	baseFee := big.NewInt(25_000_000_000)
+	halfGwei := big.NewInt(500_000_000)
+	check := func(txType uint8, tipCap, feeCap *big.Int) error {
+		_, _, err := CheckAgentTx(st, e.head.Time(), AgentTx{
+			From: arAgent, To: &arPayee, Value: common.Big1, GasLimit: arTransfer,
+			GasFeeCap: feeCap, Plain: true, V2: true, TxType: txType, GasTipCap: tipCap, BaseFee: baseFee,
+		})
+		return err
+	}
+	justAbove := new(big.Int).Add(new(big.Int).Add(baseFee, AgentMaxTip), common.Big1)
+	atCap := new(big.Int).Add(baseFee, AgentMaxTip)
+	half := new(big.Int).Add(baseFee, halfGwei)
+	// Legacy: tip = gasPrice - baseFee.
+	require.NoError(t, check(0, half, half))
+	require.NoError(t, check(0, atCap, atCap))
+	require.ErrorIs(t, check(0, justAbove, justAbove), ErrAgentTipTooHigh)
+	// Type 2: a 2 gwei tip cap with only 0.5 gwei of room above the base fee pays 0.5 gwei.
+	require.NoError(t, check(2, big.NewInt(2_000_000_000), half))
+	require.ErrorIs(t, check(2, big.NewInt(2_000_000_000), justAbove), ErrAgentTipTooHigh)
+	// No base fee (before London): the declared tip counts.
+	_, _, err = CheckAgentTx(st, e.head.Time(), AgentTx{
+		From: arAgent, To: &arPayee, Value: common.Big1, GasLimit: arTransfer, GasFeeCap: arFeeCap,
+		Plain: true, V2: true, TxType: 2, GasTipCap: big.NewInt(2_000_000_000),
+	})
+	require.ErrorIs(t, err, ErrAgentTipTooHigh)
+}
