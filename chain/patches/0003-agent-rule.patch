+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params/paramstest"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/plugin/evm/extension"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/upgrade/upgradetest"
+	"github.com/ava-labs/avalanchego/vms/components/chain"
+)
+
+func agentAssertion(t *testing.T, owner *ecdsa.PrivateKey, challenge common.Hash) []byte {
+	t.Helper()
+	authData := append(make([]byte, 32), 0x05, 0, 0, 0, 1)
+	clientData := []byte(`{"type":"webauthn.get","challenge":"` + base64.RawURLEncoding.EncodeToString(challenge.Bytes()) + `"}`)
+	ch := sha256.Sum256(clientData)
+	digest := sha256.Sum256(append(append([]byte{}, authData...), ch[:]...))
+	r, s, err := ecdsa.Sign(rand.Reader, owner, digest[:])
+	require.NoError(t, err)
+	if half := new(big.Int).Rsh(elliptic.P256().Params().N, 1); s.Cmp(half) > 0 {
+		s.Sub(elliptic.P256().Params().N, s)
+	}
+	tBytes, _ := abi.NewType("bytes", "", nil)
+	tB32, _ := abi.NewType("bytes32", "", nil)
+	auth, err := abi.Arguments{{Type: tBytes}, {Type: tBytes}, {Type: tB32}, {Type: tB32}}.Pack(
+		authData, clientData, [32]byte(common.BigToHash(r)), [32]byte(common.BigToHash(s)))
+	require.NoError(t, err)
+	return auth
+}
+
+// TestAgentRuleConcurrentPaymentsThroughPoolAndBuilder exercises the real txpool and
+// block builder: 20 payments that are each valid on their own sit in the pool at once;
+// the built block holds only as many as the daily budget allows, the rest never make
+// it into a block, and the block verifies.
+func TestAgentRuleConcurrentPaymentsThroughPoolAndBuilder(t *testing.T) {
+	genesis := &core.Genesis{}
+	require.NoError(t, genesis.UnmarshalJSON([]byte(toGenesisJSON(paramstest.ForkToChainConfig[upgradetest.Latest]))))
+	params.GetExtra(genesis.Config).GenesisPrecompiles = extras.Precompiles{
+		agentpolicy.ConfigKey: agentpolicy.NewConfig(utils.PointerTo[uint64](0)),
+	}
+	genesisJSON, err := genesis.MarshalJSON()
+	require.NoError(t, err)
+
+	fork := upgradetest.Latest
+	tvm := newVM(t, testVMConfig{fork: &fork, genesisJSON: string(genesisJSON)})
+	defer func() { require.NoError(t, tvm.vm.Shutdown(t.Context())) }()
+
+	chainID := tvm.vm.chainConfig.ChainID
+	signer := types.LatestSignerForChainID(chainID)
+	relayerKey, agentKey := testKeys[0].ToECDSA(), testKeys[1].ToECDSA()
+	agent := testEthAddrs[1]
+	payee := common.HexToAddress("0x00000000000000000000000000000000000000A1")
+	stranger := common.HexToAddress("0x00000000000000000000000000000000000000B2")
+	gasPrice := big.NewInt(testMinGasPrice)
+
+	nonces := map[common.Address]uint64{}
+	send := func(key *ecdsa.PrivateKey, to *common.Address, value *big.Int, gas uint64, data []byte) *types.Transaction {
+		from := crypto.PubkeyToAddress(key.PublicKey)
+		tx, err := types.SignNewTx(key, signer, &types.LegacyTx{Nonce: nonces[from], GasPrice: gasPrice, Gas: gas, To: to, Value: value, Data: data})
+		require.NoError(t, err)
+		nonces[from]++
+		return tx
+	}
+	precompile := agentpolicy.ContractAddress
+	// Move the VM clock well past the minimum block delay before each build, so the
+	// test does not depend on wall-clock timing between blocks.
+	nextBlock := func() {
+		tvm.vm.clock.Set(tvm.vm.clock.Time().Add(5 * time.Second))
+	}
+
+	// Block 1: register the agent and set its mandate (relayer sends, passkey signs).
+	owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	x, y := [32]byte(common.BigToHash(owner.X)), [32]byte(common.BigToHash(owner.Y))
+	sig, err := crypto.Sign(agentpolicy.RegisterDigest(chainID, agent, x, y).Bytes(), agentKey)
+	require.NoError(t, err)
+	regData, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: agent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(t, err)
+
+	value := big.NewInt(1_000)
+	charge := new(big.Int).Add(value, new(big.Int).Mul(big.NewInt(21_000), gasPrice))
+	const fits = 7
+	daily := new(big.Int).Mul(charge, big.NewInt(fits))
+	m := agentpolicy.IAgentPolicyMandate{Payees: []common.Address{payee}, PerTxCap: charge, DailyCap: daily, Expiry: 4_102_444_800}
+	auth := agentAssertion(t, owner, agentpolicy.SetMandateChallenge(chainID, agent, m, common.Big0))
+	mandateData, err := agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: agent, M: m, Nonce: common.Big0, Auth: auth})
+	require.NoError(t, err)
+
+	errs := tvm.vm.txPool.AddRemotesSync([]*types.Transaction{
+		send(relayerKey, &precompile, common.Big0, 300_000, regData),
+		send(relayerKey, &precompile, common.Big0, 1_000_000, mandateData),
+	})
+	require.NoError(t, errs[0])
+	require.NoError(t, errs[1])
+	nextBlock()
+	issueAndAccept(t, tvm.vm)
+	// The pool resets to the new head on a background thread; wait for it before checking admission.
+	require.NoError(t, tvm.vm.txPool.Sync())
+
+	// The pool refuses forbidden agent transactions with the rule's error.
+	forbidden := send(agentKey, &stranger, value, 21_000, nil)
+	nonces[agent]--
+	require.ErrorIs(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{forbidden})[0], core.ErrAgentPayeeNotAllowed)
+	creation := send(agentKey, nil, common.Big0, 100_000, []byte{0x00})
+	nonces[agent]--
+	require.ErrorIs(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{creation})[0], core.ErrAgentContractCreation)
+
+	// 20 payments, each within perTxCap and each passing the pool check on its own.
+	payments := make([]*types.Transaction, 20)
+	for i := range payments {
+		payments[i] = send(agentKey, &payee, value, 21_000, nil)
+	}
+	for i, err := range tvm.vm.txPool.AddRemotesSync(payments) {
+		require.NoError(t, err, "payment %d", i)
+	}
+
+	nextBlock()
+	blk := issueAndAccept(t, tvm.vm) // builds, verifies and accepts
+	ethBlock := blk.(*chain.BlockWrapper).Block.(extension.ExtendedBlock).GetEthBlock()
+	included := 0
+	total := new(big.Int)
+	for _, tx := range ethBlock.Transactions() {
+		if from, _ := types.Sender(signer, tx); from == agent {
+			included++
+			total.Add(total, new(big.Int).Add(tx.Value(), new(big.Int).Mul(new(big.Int).SetUint64(tx.Gas()), tx.GasPrice())))
+		}
+	}
+	require.Equal(t, fits, included)
+	require.LessOrEqual(t, total.Cmp(daily), 0, "charged %s above dailyCap %s", total, daily)
+
+	state, err := tvm.vm.blockChain.StateAt(ethBlock.Root())
+	require.NoError(t, err)
+	sp := agentpolicy.SpendForDay(state, agent, ethBlock.Time())
+	require.Equal(t, 0, total.Cmp(sp.SpentToday))
+	require.Equal(t, uint64(fits), state.GetNonce(agent))
+	require.Equal(t, new(big.Int).Mul(value, big.NewInt(fits)), state.GetBalance(payee).ToBig())
+
+	// Invariant: balance(agent) >= funded - totalCharged.
+	floor := new(big.Int).Sub(initialFund, sp.TotalCharged)
+	require.GreaterOrEqual(t, state.GetBalance(agent).ToBig().Cmp(floor), 0)
+
+	// The remaining payments are not included in a later block of the same day.
+	require.NoError(t, tvm.vm.txPool.Sync())
+	nextBlock()
+	_, err = tvm.vm.BuildBlock(t.Context())
+	require.Error(t, err, "nothing left that fits the budget")
+}
+
+// An agent that spent its whole daily budget in the last block of a day must be able
+// to pay again after midnight even if no other transaction has moved the chain on:
+// the pool admits by the later of head time and its clock, and the block (built at
+// the new day's time) accepts the payment.
+func TestAgentRuleDailyRolloverOnIdleChain(t *testing.T) {
+	genesis := &core.Genesis{}
+	require.NoError(t, genesis.UnmarshalJSON([]byte(toGenesisJSON(paramstest.ForkToChainConfig[upgradetest.Latest]))))
+	params.GetExtra(genesis.Config).GenesisPrecompiles = extras.Precompiles{
+		agentpolicy.ConfigKey: agentpolicy.NewConfig(utils.PointerTo[uint64](0)),
+	}
+	genesisJSON, err := genesis.MarshalJSON()
+	require.NoError(t, err)
+	fork := upgradetest.Latest
+	tvm := newVM(t, testVMConfig{fork: &fork, genesisJSON: string(genesisJSON)})
+	defer func() { require.NoError(t, tvm.vm.Shutdown(t.Context())) }()
+
+	// The pool reads the VM's (mock) clock in this test.
+	prevNow := txpool.Now
+	txpool.Now = tvm.vm.clock.Time
+	defer func() { txpool.Now = prevNow }()
+
+	chainID := tvm.vm.chainConfig.ChainID
+	signer := types.LatestSignerForChainID(chainID)
+	relayerKey, agentKey := testKeys[0].ToECDSA(), testKeys[1].ToECDSA()
+	agent := testEthAddrs[1]
+	payee := common.HexToAddress("0x00000000000000000000000000000000000000A1")
+	gasPrice := big.NewInt(testMinGasPrice)
+	nonces := map[common.Address]uint64{}
+	send := func(key *ecdsa.PrivateKey, to *common.Address, value *big.Int, gas uint64, data []byte) *types.Transaction {
+		from := crypto.PubkeyToAddress(key.PublicKey)
+		tx, err := types.SignNewTx(key, signer, &types.LegacyTx{Nonce: nonces[from], GasPrice: gasPrice, Gas: gas, To: to, Value: value, Data: data})
+		require.NoError(t, err)
+		nonces[from]++
+		return tx
+	}
+	advance := func(d time.Duration) { tvm.vm.clock.Set(tvm.vm.clock.Time().Add(d)) }
+	precompile := agentpolicy.ContractAddress
+
+	owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	x, y := [32]byte(common.BigToHash(owner.X)), [32]byte(common.BigToHash(owner.Y))
+	sig, err := crypto.Sign(agentpolicy.RegisterDigest(chainID, agent, x, y).Bytes(), agentKey)
+	require.NoError(t, err)
+	regData, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: agent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(t, err)
+	value := big.NewInt(1_000)
+	charge := new(big.Int).Add(value, new(big.Int).Mul(big.NewInt(21_000), gasPrice))
+	m := agentpolicy.IAgentPolicyMandate{Payees: []common.Address{payee}, PerTxCap: charge, DailyCap: charge, Expiry: 4_102_444_800}
+	auth := agentAssertion(t, owner, agentpolicy.SetMandateChallenge(chainID, agent, m, common.Big0))
+	mandateData, err := agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: agent, M: m, Nonce: common.Big0, Auth: auth})
+	require.NoError(t, err)
+	for _, err := range tvm.vm.txPool.AddRemotesSync([]*types.Transaction{
+		send(relayerKey, &precompile, common.Big0, 300_000, regData),
+		send(relayerKey, &precompile, common.Big0, 1_000_000, mandateData),
+	}) {
+		require.NoError(t, err)
+	}
+	advance(5 * time.Second)
+	issueAndAccept(t, tvm.vm)
+	require.NoError(t, tvm.vm.txPool.Sync())
+
+	// Spend the whole daily budget; the pool is then empty.
+	require.NoError(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{send(agentKey, &payee, value, 21_000, nil)})[0])
+	advance(5 * time.Second)
+	issueAndAccept(t, tvm.vm)
+	// The pool resets to the new head on a background thread; wait for it before checking admission.
+	require.NoError(t, tvm.vm.txPool.Sync())
+
+	// Same day: refused by the pool.
+	over := send(agentKey, &payee, value, 21_000, nil)
+	require.ErrorIs(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{over})[0], core.ErrAgentBudgetExceeded)
+
+	// Next day, no block in between: admitted and included.
+	advance(24 * time.Hour)
+	require.NoError(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{over})[0])
+	blk := issueAndAccept(t, tvm.vm)
+	ethBlock := blk.(*chain.BlockWrapper).Block.(extension.ExtendedBlock).GetEthBlock()
+	require.Len(t, ethBlock.Transactions(), 1)
+	require.Equal(t, over.Hash(), ethBlock.Transactions()[0].Hash())
+
+	state, err := tvm.vm.blockChain.StateAt(ethBlock.Root())
+	require.NoError(t, err)
+	sp := agentpolicy.SpendForDay(state, agent, ethBlock.Time())
+	require.Equal(t, 0, charge.Cmp(sp.SpentToday))
+	require.Equal(t, 0, new(big.Int).Mul(charge, big.NewInt(2)).Cmp(sp.TotalCharged))
+}
