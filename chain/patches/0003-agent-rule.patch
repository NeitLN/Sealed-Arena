+	// Block 1: register the agent and set its mandate (relayer sends, passkey signs).
+	owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	x, y := [32]byte(common.BigToHash(owner.X)), [32]byte(common.BigToHash(owner.Y))
+	sig, err := crypto.Sign(agentpolicy.RegisterDigest(chainID, agent, x, y).Bytes(), agentKey)
+	require.NoError(t, err)
+	regData, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: agent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(t, err)
+
+	value := big.NewInt(1_000)
+	charge := new(big.Int).Add(value, new(big.Int).Mul(big.NewInt(21_000), gasPrice))
+	const fits = 7
+	daily := new(big.Int).Mul(charge, big.NewInt(fits))
+	m := agentpolicy.IAgentPolicyMandate{Payees: []common.Address{payee}, PerTxCap: charge, DailyCap: daily, Expiry: 4_102_444_800}
+	auth := agentAssertion(t, owner, agentpolicy.SetMandateChallenge(chainID, agent, m, common.Big0))
+	mandateData, err := agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: agent, M: m, Nonce: common.Big0, Auth: auth})
+	require.NoError(t, err)
+
+	errs := tvm.vm.txPool.AddRemotesSync([]*types.Transaction{
+		send(relayerKey, &precompile, common.Big0, 300_000, regData),
+		send(relayerKey, &precompile, common.Big0, 1_000_000, mandateData),
+	})
+	require.NoError(t, errs[0])
+	require.NoError(t, errs[1])
+	nextBlock()
+	issueAndAccept(t, tvm.vm)
+	// The pool resets to the new head on a background thread; wait for it before checking admission.
+	require.NoError(t, tvm.vm.txPool.Sync())
+
+	// The pool refuses forbidden agent transactions with the rule's error.
+	forbidden := send(agentKey, &stranger, value, 21_000, nil)
+	nonces[agent]--
+	require.ErrorIs(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{forbidden})[0], core.ErrAgentPayeeNotAllowed)
+	creation := send(agentKey, nil, common.Big0, 100_000, []byte{0x00})
+	nonces[agent]--
+	require.ErrorIs(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{creation})[0], core.ErrAgentContractCreation)
+
+	// 20 payments, each within perTxCap. The pool counts what the agent already has pooled:
+	// the first `fits` are admitted, the rest are refused with the rule's error.
+	payments := make([]*types.Transaction, 20)
+	for i := range payments {
+		payments[i] = send(agentKey, &payee, value, 21_000, nil)
+	}
+	for i, err := range tvm.vm.txPool.AddRemotesSync(payments) {
+		if i < fits {
+			require.NoError(t, err, "payment %d", i)
+		} else {
+			require.ErrorIs(t, err, core.ErrAgentBudgetExceeded, "payment %d", i)
+		}
+	}
+	nonces[agent] = uint64(fits)
+
+	nextBlock()
+	blk := issueAndAccept(t, tvm.vm) // builds, verifies and accepts
+	ethBlock := blk.(*chain.BlockWrapper).Block.(extension.ExtendedBlock).GetEthBlock()
+	included := 0
+	total := new(big.Int)
+	for _, tx := range ethBlock.Transactions() {
+		if from, _ := types.Sender(signer, tx); from == agent {
+			included++
+			total.Add(total, new(big.Int).Add(tx.Value(), new(big.Int).Mul(new(big.Int).SetUint64(tx.Gas()), tx.GasPrice())))
+		}
+	}
+	require.Equal(t, fits, included)
+	require.LessOrEqual(t, total.Cmp(daily), 0, "charged %s above dailyCap %s", total, daily)
+
+	state, err := tvm.vm.blockChain.StateAt(ethBlock.Root())
+	require.NoError(t, err)
+	sp := agentpolicy.SpendForDay(state, agent, ethBlock.Time())
+	require.Equal(t, 0, total.Cmp(sp.SpentToday))
+	require.Equal(t, uint64(fits), state.GetNonce(agent))
+	require.Equal(t, new(big.Int).Mul(value, big.NewInt(fits)), state.GetBalance(payee).ToBig())
+
+	// Invariant: balance(agent) >= funded - totalCharged.
+	floor := new(big.Int).Sub(initialFund, sp.TotalCharged)
+	require.GreaterOrEqual(t, state.GetBalance(agent).ToBig().Cmp(floor), 0)
+
+	// Nothing of the agent's is left waiting in the pool, so no later block can carry it.
+	require.NoError(t, tvm.vm.txPool.Sync())
+	pending, queued := tvm.vm.txPool.ContentFrom(agent)
+	require.Empty(t, pending)
+	require.Empty(t, queued)
+	nextBlock()
+	_, err = tvm.vm.BuildBlock(t.Context())
+	require.Error(t, err, "nothing left to build")
+}
+
+// agentPoolEnv is a VM with an agent registered to a passkey and given a mandate whose daily
+// budget fits `fits` payments of `value`.
+type agentPoolEnv struct {
+	t         *testing.T
+	tvm       *testVM
+	signer    types.Signer
+	chainID   *big.Int
+	relayer   *ecdsa.PrivateKey
+	agentKey  *ecdsa.PrivateKey
+	agent     common.Address
+	payee     common.Address
+	owner     *ecdsa.PrivateKey
+	ownerNo   int64
+	value     *big.Int
+	gasPrice  *big.Int
+	nonces    map[common.Address]uint64
+	nextBlock func()
+}
+
+func newAgentPoolEnv(t *testing.T, fits int64) *agentPoolEnv {
+	return newAgentPoolEnvRule(t, fits, false)
+}
+
+// newAgentPoolEnvRule is newAgentPoolEnv with agent rule v2 active from genesis when v2 is set.
+func newAgentPoolEnvRule(t *testing.T, fits int64, v2 bool) *agentPoolEnv {
+	genesis := &core.Genesis{}
+	require.NoError(t, genesis.UnmarshalJSON([]byte(toGenesisJSON(paramstest.ForkToChainConfig[upgradetest.Latest]))))
+	params.GetExtra(genesis.Config).GenesisPrecompiles = extras.Precompiles{
+		agentpolicy.ConfigKey: agentpolicy.NewConfig(utils.PointerTo[uint64](0)),
+	}
+	if v2 {
+		params.GetExtra(genesis.Config).GenesisPrecompiles[agentrulev2.ConfigKey] = agentrulev2.NewConfig(utils.PointerTo[uint64](0))
+	}
+	genesisJSON, err := genesis.MarshalJSON()
+	require.NoError(t, err)
+	fork := upgradetest.Latest
+	tvm := newVM(t, testVMConfig{fork: &fork, genesisJSON: string(genesisJSON)})
+	t.Cleanup(func() { require.NoError(t, tvm.vm.Shutdown(t.Context())) })
+
+	e := &agentPoolEnv{
+		t: t, tvm: tvm, chainID: tvm.vm.chainConfig.ChainID,
+		relayer: testKeys[0].ToECDSA(), agentKey: testKeys[1].ToECDSA(), agent: testEthAddrs[1],
+		payee: common.HexToAddress("0x00000000000000000000000000000000000000A1"),
+		value: new(big.Int).Exp(big.NewInt(10), big.NewInt(17), nil), gasPrice: big.NewInt(testMinGasPrice), nonces: map[common.Address]uint64{},
+	}
+	e.signer = types.LatestSignerForChainID(e.chainID)
+	e.nextBlock = func() { tvm.vm.clock.Set(tvm.vm.clock.Time().Add(5 * time.Second)) }
+	e.owner, err = ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	x, y := [32]byte(common.BigToHash(e.owner.X)), [32]byte(common.BigToHash(e.owner.Y))
+	// Under rule v2 the agent and the owner sign for this chain's v2 domain (snow context ids).
+	domain := agentpolicy.DomainV2(tvm.vm.ctx.NetworkID, tvm.vm.ctx.ChainID, e.chainID)
+	digest := agentpolicy.RegisterDigest(e.chainID, e.agent, x, y)
+	if v2 {
+		digest = agentpolicy.RegisterDigestV2(domain, e.agent, x, y)
+	}
+	sig, err := crypto.Sign(digest.Bytes(), e.agentKey)
+	require.NoError(t, err)
+	regData, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: e.agent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(t, err)
+	charge := e.charge()
+	// The cap per payment is the whole daily budget, so only the daily budget limits these tests.
+	daily := new(big.Int).Mul(charge, big.NewInt(fits))
+	m := agentpolicy.IAgentPolicyMandate{
+		Payees: []common.Address{e.payee}, PerTxCap: daily, DailyCap: daily, Expiry: 4_102_444_800,
+	}
+	var mandateData []byte
+	if v2 {
+		m2 := agentpolicy.IAgentPolicyMandateV2{Payees: m.Payees, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, DailyFeeCap: m.DailyCap, Expiry: m.Expiry}
+		auth := agentAssertion(t, e.owner, agentpolicy.SetMandateV2Challenge(domain, e.agent, m2, big.NewInt(e.ownerNo)))
+		mandateData, err = agentpolicy.PackSetMandateV2(agentpolicy.SetMandateV2Input{Agent: e.agent, M: m2, Nonce: big.NewInt(e.ownerNo), Auth: auth})
+	} else {
+		auth := agentAssertion(t, e.owner, agentpolicy.SetMandateChallenge(e.chainID, e.agent, m, big.NewInt(e.ownerNo)))
+		mandateData, err = agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: e.agent, M: m, Nonce: big.NewInt(e.ownerNo), Auth: auth})
+	}
+	require.NoError(t, err)
+	e.ownerNo++
+	e.block(e.relayerTx(regData, 300_000), e.relayerTx(mandateData, 1_000_000))
+	return e
+}
+
+func (e *agentPoolEnv) charge() *big.Int {
+	return new(big.Int).Add(e.value, new(big.Int).Mul(big.NewInt(21_000), e.gasPrice))
+}
+
+func (e *agentPoolEnv) sign(key *ecdsa.PrivateKey, nonce uint64, to *common.Address, value *big.Int, gas uint64, data []byte) *types.Transaction {
+	tx, err := types.SignNewTx(key, e.signer, &types.LegacyTx{Nonce: nonce, GasPrice: e.gasPrice, Gas: gas, To: to, Value: value, Data: data})
+	require.NoError(e.t, err)
+	return tx
+}
+
+func (e *agentPoolEnv) relayerTx(data []byte, gas uint64) *types.Transaction {
+	from := crypto.PubkeyToAddress(e.relayer.PublicKey)
+	to := agentpolicy.ContractAddress
+	tx := e.sign(e.relayer, e.nonces[from], &to, common.Big0, gas, data)
+	e.nonces[from]++
+	return tx
+}
+
+// pay signs a payment from the agent at `nonce` (the caller tracks the agent's nonces).
+func (e *agentPoolEnv) pay(nonce uint64) *types.Transaction {
+	return e.sign(e.agentKey, nonce, &e.payee, e.value, 21_000, nil)
+}
+
+// block adds txs to the pool, builds, accepts and waits for the pool to reset.
+func (e *agentPoolEnv) block(txs ...*types.Transaction) {
+	for i, err := range e.tvm.vm.txPool.AddRemotesSync(txs) {
+		require.NoError(e.t, err, "tx %d", i)
+	}
+	e.nextBlock()
+	issueAndAccept(e.t, e.tvm.vm)
+	require.NoError(e.t, e.tvm.vm.txPool.Sync())
+}
+
+// Pooled agent transactions that a new head makes invalid (here: the owner froze the agent)
+// are dropped from the pool, so they cannot be built into a later block.
+func TestAgentRulePoolPrunesOnHeadChange(t *testing.T) {
+	e := newAgentPoolEnv(t, 7)
+	// Payments with a nonce gap stay queued, not pending, and are not built into the next block.
+	for i, err := range e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{e.pay(1), e.pay(2), e.pay(3)}) {
+		require.NoError(t, err, "payment %d", i)
+	}
+	_, queued := e.tvm.vm.txPool.ContentFrom(e.agent)
+	require.Len(t, queued, 3)
+
+	auth := agentAssertion(t, e.owner, agentpolicy.FreezeChallenge(e.chainID, e.agent, big.NewInt(e.ownerNo)))
+	freezeData, err := agentpolicy.PackFreeze(agentpolicy.FreezeInput{Agent: e.agent, Nonce: big.NewInt(e.ownerNo), Auth: auth})
+	require.NoError(t, err)
+	e.ownerNo++
+	e.block(e.relayerTx(freezeData, 300_000))
+
+	pending, queued := e.tvm.vm.txPool.ContentFrom(e.agent)
+	require.Empty(t, pending, "frozen agent keeps nothing pending")
+	require.Empty(t, queued, "frozen agent keeps nothing queued")
+}
+
+// The budget is counted in nonce order: a payment counts only the agent's pooled payments with a
+// lower nonce. Payments that arrive out of order (or are queued ahead with a nonce gap) cannot
+// take the budget from an earlier nonce; the excess at the end is dropped at the next head.
+func TestAgentRulePoolBudgetFollowsNonceOrder(t *testing.T) {
+	e := newAgentPoolEnv(t, 2)
+	// Nonces 2, 0, 1 arrive in that order; all are admitted (each fits with the lower ones).
+	for i, tx := range []*types.Transaction{e.pay(2), e.pay(0), e.pay(1)} {
+		require.NoError(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{tx})[0], "payment %d", i)
+	}
+	// The block takes nonces 0 and 1 (the budget); nonce 2 does not fit and is dropped.
+	e.block()
+	state, err := e.tvm.vm.blockChain.State()
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), state.GetNonce(e.agent))
+	pending, queued := e.tvm.vm.txPool.ContentFrom(e.agent)
+	require.Empty(t, pending)
+	require.Empty(t, queued, "the payment over the budget is not left waiting")
+}
+
+// Payments queued far ahead do not hold the budget for the next nonce.
+func TestAgentRulePoolQueuedAheadDoesNotBlock(t *testing.T) {
+	e := newAgentPoolEnv(t, 2)
+	for i, tx := range []*types.Transaction{e.pay(5), e.pay(6)} {
+		require.NoError(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{tx})[0], "queued payment %d", i)
+	}
+	require.NoError(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{e.pay(0)})[0])
+	require.NoError(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{e.pay(1)})[0])
+	// Within the pending run (nonces 0 and 1) the daily budget still holds.
+	require.ErrorIs(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{e.pay(2)})[0], core.ErrAgentBudgetExceeded)
+}
+
+// Replacing a pooled payment counts only the difference: a replacement with a higher fee that
+// still fits is admitted, one that does not fit is refused.
+func TestAgentRulePoolReplacementUsesDelta(t *testing.T) {
+	e := newAgentPoolEnv(t, 2)
+	require.NoError(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{e.pay(0), e.pay(1)})[0])
+	// Same nonce, 20% higher gas price: the charge grows past the budget of 2 payments.
+	bump := new(big.Int).Div(new(big.Int).Mul(e.gasPrice, big.NewInt(12)), big.NewInt(10))
+	over, err := types.SignNewTx(e.agentKey, e.signer, &types.LegacyTx{Nonce: 1, GasPrice: bump, Gas: 21_000, To: &e.payee, Value: e.value})
+	require.NoError(t, err)
+	require.ErrorIs(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{over})[0], core.ErrAgentBudgetExceeded)
+	// Same nonce, higher price, lower value so the charge is unchanged: admitted as a replacement.
+	extra := new(big.Int).Mul(big.NewInt(21_000), new(big.Int).Sub(bump, e.gasPrice))
+	require.Negative(t, extra.Cmp(e.value), "test setup: the fee bump must be smaller than the value")
+	same, err := types.SignNewTx(e.agentKey, e.signer, &types.LegacyTx{Nonce: 1, GasPrice: bump, Gas: 21_000, To: &e.payee, Value: new(big.Int).Sub(e.value, extra)})
+	require.NoError(t, err)
+	require.NoError(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{same})[0])
+}
+
+// An agent that spent its whole daily budget in the last block of a day must be able
+// to pay again after midnight even if no other transaction has moved the chain on:
+// the pool admits by the later of head time and its clock, and the block (built at
+// the new day's time) accepts the payment.
+func TestAgentRuleDailyRolloverOnIdleChain(t *testing.T) {
+	genesis := &core.Genesis{}
+	require.NoError(t, genesis.UnmarshalJSON([]byte(toGenesisJSON(paramstest.ForkToChainConfig[upgradetest.Latest]))))
+	params.GetExtra(genesis.Config).GenesisPrecompiles = extras.Precompiles{
+		agentpolicy.ConfigKey: agentpolicy.NewConfig(utils.PointerTo[uint64](0)),
+	}
+	genesisJSON, err := genesis.MarshalJSON()
+	require.NoError(t, err)
+	fork := upgradetest.Latest
+	tvm := newVM(t, testVMConfig{fork: &fork, genesisJSON: string(genesisJSON)})
+	defer func() { require.NoError(t, tvm.vm.Shutdown(t.Context())) }()
+
+	// The pool reads the VM's (mock) clock in this test.
+	prevNow := txpool.Now
+	txpool.Now = tvm.vm.clock.Time
+	defer func() { txpool.Now = prevNow }()
+
+	chainID := tvm.vm.chainConfig.ChainID
+	signer := types.LatestSignerForChainID(chainID)
+	relayerKey, agentKey := testKeys[0].ToECDSA(), testKeys[1].ToECDSA()
+	agent := testEthAddrs[1]
+	payee := common.HexToAddress("0x00000000000000000000000000000000000000A1")
+	gasPrice := big.NewInt(testMinGasPrice)
+	nonces := map[common.Address]uint64{}
+	send := func(key *ecdsa.PrivateKey, to *common.Address, value *big.Int, gas uint64, data []byte) *types.Transaction {
+		from := crypto.PubkeyToAddress(key.PublicKey)
+		tx, err := types.SignNewTx(key, signer, &types.LegacyTx{Nonce: nonces[from], GasPrice: gasPrice, Gas: gas, To: to, Value: value, Data: data})
+		require.NoError(t, err)
+		nonces[from]++
+		return tx
+	}
+	advance := func(d time.Duration) { tvm.vm.clock.Set(tvm.vm.clock.Time().Add(d)) }
+	precompile := agentpolicy.ContractAddress
+
+	owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	x, y := [32]byte(common.BigToHash(owner.X)), [32]byte(common.BigToHash(owner.Y))
+	sig, err := crypto.Sign(agentpolicy.RegisterDigest(chainID, agent, x, y).Bytes(), agentKey)
+	require.NoError(t, err)
+	regData, err := agentpolicy.PackRegister(agentpolicy.RegisterInput{Agent: agent, OwnerX: x, OwnerY: y, AgentSig: sig})
+	require.NoError(t, err)
+	value := big.NewInt(1_000)
+	charge := new(big.Int).Add(value, new(big.Int).Mul(big.NewInt(21_000), gasPrice))
+	m := agentpolicy.IAgentPolicyMandate{Payees: []common.Address{payee}, PerTxCap: charge, DailyCap: charge, Expiry: 4_102_444_800}
+	auth := agentAssertion(t, owner, agentpolicy.SetMandateChallenge(chainID, agent, m, common.Big0))
+	mandateData, err := agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: agent, M: m, Nonce: common.Big0, Auth: auth})
+	require.NoError(t, err)
+	for _, err := range tvm.vm.txPool.AddRemotesSync([]*types.Transaction{
+		send(relayerKey, &precompile, common.Big0, 300_000, regData),
+		send(relayerKey, &precompile, common.Big0, 1_000_000, mandateData),
+	}) {
+		require.NoError(t, err)
+	}
+	advance(5 * time.Second)
+	issueAndAccept(t, tvm.vm)
+	require.NoError(t, tvm.vm.txPool.Sync())
+
+	// Spend the whole daily budget; the pool is then empty.
+	require.NoError(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{send(agentKey, &payee, value, 21_000, nil)})[0])
+	advance(5 * time.Second)
+	issueAndAccept(t, tvm.vm)
+	// The pool resets to the new head on a background thread; wait for it before checking admission.
+	require.NoError(t, tvm.vm.txPool.Sync())
+
+	// Same day: refused by the pool.
+	over := send(agentKey, &payee, value, 21_000, nil)
+	require.ErrorIs(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{over})[0], core.ErrAgentBudgetExceeded)
+
+	// Next day, no block in between: admitted and included.
+	advance(24 * time.Hour)
+	require.NoError(t, tvm.vm.txPool.AddRemotesSync([]*types.Transaction{over})[0])
+	blk := issueAndAccept(t, tvm.vm)
+	ethBlock := blk.(*chain.BlockWrapper).Block.(extension.ExtendedBlock).GetEthBlock()
+	require.Len(t, ethBlock.Transactions(), 1)
+	require.Equal(t, over.Hash(), ethBlock.Transactions()[0].Hash())
+
+	state, err := tvm.vm.blockChain.StateAt(ethBlock.Root())
+	require.NoError(t, err)
+	sp := agentpolicy.SpendForDay(state, agent, ethBlock.Time())
+	require.Equal(t, 0, charge.Cmp(sp.SpentToday))
+	require.Equal(t, 0, new(big.Int).Mul(charge, big.NewInt(2)).Cmp(sp.TotalCharged))
+}
+
+// With rule v2 the pool refuses an agent payment whose tip is above the cap, or whose gas is not
+// 21000, on arrival; a payment within the v2 limits is admitted and built into a block.
+func TestAgentRulePoolV2RefusesOnArrival(t *testing.T) {
+	e := newAgentPoolEnvRule(t, 7, true)
+	head := e.tvm.vm.blockChain.CurrentBlock()
+	feeCap := new(big.Int).Mul(head.BaseFee, big.NewInt(2))
+	pay := func(nonce uint64, gas uint64, tip *big.Int) *types.Transaction {
+		tx, err := types.SignNewTx(e.agentKey, e.signer, &types.DynamicFeeTx{
+			ChainID: e.chainID, Nonce: nonce, GasTipCap: tip, GasFeeCap: feeCap, Gas: gas, To: &e.payee, Value: big.NewInt(1),
+		})
+		require.NoError(t, err)
+		return tx
+	}
+	over := new(big.Int).Add(core.AgentMaxTip, common.Big1)
+	require.ErrorIs(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{pay(0, 21_000, over)})[0], core.ErrAgentTipTooHigh)
+	require.ErrorIs(t, e.tvm.vm.txPool.AddRemotesSync([]*types.Transaction{pay(0, 30_000, core.AgentMaxTip)})[0], core.ErrAgentGasLimit)
+	e.block(pay(0, 21_000, core.AgentMaxTip))
+	state, err := e.tvm.vm.blockChain.State()
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), state.GetNonce(e.agent))
+}
