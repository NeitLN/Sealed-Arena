+// Now is the clock the pools use for time-based admission rules. It is not used
+// in consensus code; tests may replace it.
+var Now = time.Now
+
+// PoolTime is the time the agent rule uses for pool admission: the later of the
+// head block time and the local clock. With only the head time, an agent whose
+// daily budget ran out in the last block before midnight could not get a payment
+// into the pool on an idle chain (no new block, so no new day). Block validity
+// (preCheck) always uses the block time.
+func PoolTime(headTime uint64) uint64 {
+	now := Now().Unix()
+	if now < 0 {
+		return headTime
+	}
+	return max(headTime, uint64(now))
+}
