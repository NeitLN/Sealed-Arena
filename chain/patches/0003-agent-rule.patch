+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentrulev2
+
+import (
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/precompileconfig"
+)
+
+var _ precompileconfig.Config = (*Config)(nil)
+
+// Config schedules rule v2. Its parameters are constants of the rule version; changing them
+// would be a new version with its own key.
+type Config struct {
+	precompileconfig.Upgrade
+}
+
+// NewConfig schedules rule v2 at blockTimestamp.
+func NewConfig(blockTimestamp *uint64) *Config {
+	return &Config{Upgrade: precompileconfig.Upgrade{BlockTimestamp: blockTimestamp}}
+}
+
+func (*Config) Key() string { return ConfigKey }
+
+// Verify refuses disable: v2 changes what owners sign and cannot be undone.
+func (c *Config) Verify(precompileconfig.ChainConfig) error {
+	if c.Disable {
+		return ErrDisableNotAllowed
+	}
+	return nil
+}
+
+// Equal returns true if s is a *Config scheduled identically.
+func (c *Config) Equal(s precompileconfig.Config) bool {
+	other, ok := s.(*Config)
+	if !ok {
+		return false
+	}
+	return c.Upgrade.Equal(&other.Upgrade)
+}
