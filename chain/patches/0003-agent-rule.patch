index 0000000..7d5c5da
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/v2.go
@@ -0,0 +1,369 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"errors"
+	"math/big"
+
+	"github.com/ava-labs/libevm/accounts/abi"
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/vm"
+	"github.com/ava-labs/libevm/crypto"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+)
+
+// Rule v2 (activated by agentRuleV2Config): owner proofs are bound to this chain's Avalanche
+// network and blockchain ids, mandates carry a daily fee cap, and freeze proofs are for a freeze
+// epoch so the owner can sign one ahead of time.
+
+var (
+	ErrNoBlockchainID   = errors.New("agentpolicy: blockchain id unavailable")
+	ErrUseSetMandateV2  = errors.New("agentpolicy: setMandate is replaced by setMandateV2 under rule v2")
+	ErrBadFreezeEpoch   = errors.New("agentpolicy: freeze epoch does not match")
+	ErrEpochExhausted   = errors.New("agentpolicy: freeze epoch exhausted")
+	ErrFeeCapAboveDaily = errors.New("agentpolicy: dailyFeeCap greater than dailyCap")
+)
+
+const (
+	SetMandateV2GasCost uint64 = 500000
+	GetMandateV2GasCost uint64 = 30000
+	GetFeeSpendGasCost  uint64 = 5000
+	FreezeEpochGasCost  uint64 = 2000
+	RuleVersionGasCost  uint64 = 2000
+)
+
+// IAgentPolicyMandateV2 is the mandate of rule v2.
+type IAgentPolicyMandateV2 struct {
+	Payees      []common.Address
+	PerTxCap    *big.Int
+	DailyCap    *big.Int
+	DailyFeeCap *big.Int
+	Expiry      uint64
+}
+
+type SetMandateV2Input struct {
+	Agent common.Address
+	M     IAgentPolicyMandateV2
+	Nonce *big.Int
+	Auth  []byte
+}
+
+type GetMandateV2Output struct {
+	M         IAgentPolicyMandateV2
+	FeeCapSet bool
+	Frozen    bool
+}
+
+type GetFeeSpendOutput struct {
+	FeeSpentToday *big.Int
+	DayIndex      uint64
+}
+
+var tMandateV2, _ = abi.NewType("tuple", "", []abi.ArgumentMarshaling{
+	{Name: "payees", Type: "address[]"},
+	{Name: "perTxCap", Type: "uint256"},
+	{Name: "dailyCap", Type: "uint256"},
+	{Name: "dailyFeeCap", Type: "uint256"},
+	{Name: "expiry", Type: "uint64"},
+})
+
+// isV2 reports whether rule v2 is active (the marker agentrulev2 writes at activation).
+func isV2(s contract.StateReader) bool { return RuleVersion(s) >= 2 }
+
+// v2Only activates the v2 functions; before rule v2 their selectors behave as unknown ones.
+func v2Only(as contract.AccessibleState) bool { return isV2(as.GetStateDB()) }
+
+// snowIDsProvider lets tests supply the Avalanche ids without a snow context.
+type snowIDsProvider interface {
+	SnowIDs() (networkID uint32, blockchainID [32]byte)
+}
+
+// DomainV2 binds owner proofs to one chain: keccak256(abi.encode("SealedArena.AgentPolicy.v2",
+// networkID, blockchainID, evmChainID, AgentPolicy address)). The local network and the Sealed L1
+// on Fuji share the EVM chain id but not the blockchain id.
+func DomainV2(networkID uint32, blockchainID [32]byte, evmChainID *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tUint256}, {Type: tBytes32}, {Type: tUint256}, {Type: tAddress}},
+		"SealedArena.AgentPolicy.v2", new(big.Int).SetUint64(uint64(networkID)), blockchainID, evmChainID, ContractAddress,
+	))
+}
+
+func domainV2(as contract.AccessibleState) (common.Hash, error) {
+	chainID, err := evmChainID(as)
+	if err != nil {
+		return common.Hash{}, err
+	}
+	if p, ok := as.(snowIDsProvider); ok {
+		n, id := p.SnowIDs()
+		return DomainV2(n, id, chainID), nil
+	}
+	ctx := as.GetSnowContext()
+	if ctx == nil || ctx.ChainID == ([32]byte{}) {
+		return common.Hash{}, ErrNoBlockchainID // fail closed
+	}
+	return DomainV2(ctx.NetworkID, ctx.ChainID, chainID), nil
+}
+
+// RegisterDigestV2 is what the agent key signs to register under rule v2.
+func RegisterDigestV2(domain common.Hash, agent common.Address, ownerX, ownerY [32]byte) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tBytes32}, {Type: tBytes32}},
+		"SealedArena:register", [32]byte(domain), agent, ownerX, ownerY,
+	))
+}
+
+// MandateV2Hash is keccak256(abi.encode(m)).
+func MandateV2Hash(m IAgentPolicyMandateV2) common.Hash {
+	return crypto.Keccak256Hash(mustPack(abi.Arguments{{Type: tMandateV2}}, m))
+}
+
+// SetMandateV2Challenge is what the owner signs to set a v2 mandate.
+func SetMandateV2Challenge(domain common.Hash, agent common.Address, m IAgentPolicyMandateV2, nonce *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tBytes32}, {Type: tUint256}},
+		"SealedArena:setMandate", [32]byte(domain), agent, [32]byte(MandateV2Hash(m)), nonce,
+	))
+}
+
+// FreezeChallengeV2 is what the owner signs to freeze the agent during `epoch`. It does not
+// involve the owner nonce, so it can be signed ahead of time and stays valid until an unfreeze.
+func FreezeChallengeV2(domain common.Hash, agent common.Address, epoch *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tUint256}},
+		"SealedArena:freeze", [32]byte(domain), agent, epoch,
+	))
+}
+
+// UnfreezeChallengeV2 is what the owner signs to unfreeze; it uses the owner nonce and the epoch.
+func UnfreezeChallengeV2(domain common.Hash, agent common.Address, nonce, epoch *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tBytes32}, {Type: tAddress}, {Type: tUint256}, {Type: tUint256}},
+		"SealedArena:unfreeze", [32]byte(domain), agent, nonce, epoch,
+	))
+}
+
+func doSetMandateV2(as contract.AccessibleState, remainingGas *uint64, in SetMandateV2Input) error {
+	if len(in.M.Payees) > MaxPayees {
+		return ErrTooManyPayees
+	}
+	if in.M.PerTxCap == nil || in.M.DailyCap == nil || in.M.DailyFeeCap == nil || in.M.PerTxCap.Cmp(in.M.DailyCap) > 0 {
+		return ErrPerTxAboveDaily
+	}
+	if in.M.DailyFeeCap.Cmp(in.M.DailyCap) > 0 {
+		return ErrFeeCapAboveDaily
+	}
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	current, err := checkOwner(st, in.Agent, in.Nonce, in.Auth, SetMandateV2Challenge(domain, in.Agent, in.M, in.Nonce))
+	if err != nil {
+		return err
+	}
+	data := MandateSetEventData{
+		PerTxCap:   in.M.PerTxCap,
+		DailyCap:   in.M.DailyCap,
+		Expiry:     in.M.Expiry,
+		PayeeCount: big.NewInt(int64(len(in.M.Payees))),
+	}
+	topics, packed, err := PackMandateSetEvent(in.Agent, data)
+	if err != nil {
+		return err
+	}
+	ev := event{GetMandateSetEventGasCost(data), topics, packed}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+
+	bumpNonce(st, in.Agent, current)
+	writeMandate(st, in.Agent, Mandate{Payees: in.M.Payees, PerTxCap: in.M.PerTxCap, DailyCap: in.M.DailyCap, Expiry: in.M.Expiry})
+	writeFeeCap(st, in.Agent, in.M.DailyFeeCap)
+	addLog(as, ev)
+	return nil
+}
+
+// doFreezeV2: valid iff `epoch` is the agent's current freeze epoch and the owner signed it. It
+// does not use or change the owner nonce. Freezing a frozen agent succeeds without a change.
+func doFreezeV2(as contract.AccessibleState, remainingGas *uint64, agent common.Address, epoch *big.Int, auth []byte) error {
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	if !isRegistered(st, agent) {
+		return ErrNotRegistered
+	}
+	if epoch == nil || !epoch.IsUint64() || epoch.Uint64() != FreezeEpoch(st, agent) {
+		return ErrBadFreezeEpoch
+	}
+	x := [32]byte(getWord(st, agent, fieldOwnerX))
+	y := [32]byte(getWord(st, agent, fieldOwnerY))
+	if err := VerifyWebAuthn(auth, FreezeChallengeV2(domain, agent, epoch), x, y); err != nil {
+		return err
+	}
+	if isFrozen(st, agent) {
+		return nil
+	}
+	topics, packed, err := PackFrozenEvent(agent)
+	if err != nil {
+		return err
+	}
+	ev := event{GetFrozenEventGasCost(), topics, packed}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	setFlag(st, agent, flagFrozen, true)
+	addLog(as, ev)
+	return nil
+}
+
+// doUnfreezeV2 checks the owner nonce and the epoch, then moves both on, so an earlier freeze
+// proof cannot be replayed after the owner unfreezes.
+func doUnfreezeV2(as contract.AccessibleState, remainingGas *uint64, agent common.Address, nonce *big.Int, auth []byte) error {
+	domain, err := domainV2(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	epoch := FreezeEpoch(st, agent)
+	if epoch == ^uint64(0) {
+		return ErrEpochExhausted
+	}
+	current, err := checkOwner(st, agent, nonce, auth, UnfreezeChallengeV2(domain, agent, nonce, new(big.Int).SetUint64(epoch)))
+	if err != nil {
+		return err
+	}
+	topics, packed, err := PackUnfrozenEvent(agent)
+	if err != nil {
+		return err
+	}
+	ev := event{GetUnfrozenEventGasCost(), topics, packed}
+	if err := chargeEvent(remainingGas, ev); err != nil {
+		return err
+	}
+	bumpNonce(st, agent, current)
+	setUint64(st, agent, fieldFreezeEpoch, epoch+1)
+	setFlag(st, agent, flagFrozen, false)
+	addLog(as, ev)
+	return nil
+}
+
+// ---- ABI functions ----------------------------------------------------------------------
+
+func PackSetMandateV2(in SetMandateV2Input) ([]byte, error) {
+	return AgentPolicyABI.Pack("setMandateV2", in.Agent, in.M, in.Nonce, in.Auth)
+}
+
+func UnpackSetMandateV2Input(input []byte) (SetMandateV2Input, error) {
+	in := SetMandateV2Input{}
+	err := AgentPolicyABI.UnpackInputIntoInterface(&in, "setMandateV2", input)
+	return in, err
+}
+
+func setMandateV2(as contract.AccessibleState, _ common.Address, _ common.Address, input []byte, suppliedGas uint64, readOnly bool) ([]byte, uint64, error) {
+	remainingGas, err := contract.DeductGas(suppliedGas, SetMandateV2GasCost)
+	if err != nil {
+		return nil, 0, err
+	}
+	if readOnly {
+		return nil, remainingGas, vm.ErrWriteProtection
+	}
+	in, err := UnpackSetMandateV2Input(input)
+	if err != nil {
+		return nil, remainingGas, err
+	}
+	if err := doSetMandateV2(as, &remainingGas, in); err != nil {
+		return nil, remainingGas, err
+	}
+	return []byte{}, remainingGas, nil
+}
+
+func PackGetMandateV2(agent common.Address) ([]byte, error) {
+	return AgentPolicyABI.Pack("getMandateV2", agent)
+}
+
+func UnpackGetMandateV2Output(output []byte) (GetMandateV2Output, error) {
+	out := GetMandateV2Output{}
+	err := AgentPolicyABI.UnpackIntoInterface(&out, "getMandateV2", output)
+	return out, err
+}
+
+func getMandateV2(as contract.AccessibleState, _ common.Address, _ common.Address, input []byte, suppliedGas uint64, _ bool) ([]byte, uint64, error) {
+	remainingGas, err := contract.DeductGas(suppliedGas, GetMandateV2GasCost)
+	if err != nil {
+		return nil, 0, err
+	}
+	agent, err := UnpackGetMandateInput(input)
+	if err != nil {
+		return nil, remainingGas, err
+	}
+	registered, m, frozen, _ := GetMandateForRule(as.GetStateDB(), agent)
+	out := GetMandateV2Output{M: IAgentPolicyMandateV2{Payees: []common.Address{}, PerTxCap: new(big.Int), DailyCap: new(big.Int), DailyFeeCap: new(big.Int)}}
+	if registered {
+		out = GetMandateV2Output{
+			M:         IAgentPolicyMandateV2{Payees: m.Payees, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, DailyFeeCap: m.DailyFeeCap, Expiry: m.Expiry},
+			FeeCapSet: m.FeeCapSet,
+			Frozen:    frozen,
+		}
+	}
+	packed, err := AgentPolicyABI.PackOutput("getMandateV2", out.M, out.FeeCapSet, out.Frozen)
+	return packed, remainingGas, err
+}
+
+func PackGetFeeSpend(agent common.Address) ([]byte, error) {
+	return AgentPolicyABI.Pack("getFeeSpend", agent)
+}
+
+func getFeeSpend(as contract.AccessibleState, _ common.Address, _ common.Address, input []byte, suppliedGas uint64, _ bool) ([]byte, uint64, error) {
+	remainingGas, err := contract.DeductGas(suppliedGas, GetFeeSpendGasCost)
+	if err != nil {
+		return nil, 0, err
+	}
+	agent, err := UnpackGetMandateInput(input)
+	if err != nil {
+		return nil, remainingGas, err
+	}
+	ts := as.GetBlockContext().Timestamp()
+	packed, err := AgentPolicyABI.PackOutput("getFeeSpend", FeeSpendForDay(as.GetStateDB(), agent, ts), ts/86400)
+	return packed, remainingGas, err
+}
+
+func PackFreezeEpoch(agent common.Address) ([]byte, error) {
+	return AgentPolicyABI.Pack("freezeEpoch", agent)
+}
+
+func freezeEpoch(as contract.AccessibleState, _ common.Address, _ common.Address, input []byte, suppliedGas uint64, _ bool) ([]byte, uint64, error) {
+	remainingGas, err := contract.DeductGas(suppliedGas, FreezeEpochGasCost)
+	if err != nil {
+		return nil, 0, err
+	}
+	agent, err := UnpackGetMandateInput(input)
+	if err != nil {
+		return nil, remainingGas, err
+	}
+	packed, err := AgentPolicyABI.PackOutput("freezeEpoch", new(big.Int).SetUint64(FreezeEpoch(as.GetStateDB(), agent)))
+	return packed, remainingGas, err
+}
+
+func PackRuleVersion() ([]byte, error) { return AgentPolicyABI.Pack("ruleVersion") }
+
+func ruleVersion(as contract.AccessibleState, _ common.Address, _ common.Address, _ []byte, suppliedGas uint64, _ bool) ([]byte, uint64, error) {
+	remainingGas, err := contract.DeductGas(suppliedGas, RuleVersionGasCost)
+	if err != nil {
+		return nil, 0, err
+	}
+	packed, err := AgentPolicyABI.PackOutput("ruleVersion", new(big.Int).SetUint64(RuleVersion(as.GetStateDB())))
+	return packed, remainingGas, err
+}
+
+// v2Functions are added to the precompile, active only under rule v2.
+var v2Functions = map[string]contract.RunStatefulPrecompileFunc{
+	"setMandateV2": setMandateV2,
+	"getMandateV2": getMandateV2,
+	"getFeeSpend":  getFeeSpend,
+	"freezeEpoch":  freezeEpoch,
+	"ruleVersion":  ruleVersion,
+}
