+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"encoding/json"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/ids"
+)
+
+// The rule v2 digests computed here match those computed by packages/shared (TypeScript) for the
+// same inputs (chain/testvectors/agentpolicy-v2.json), so the console and the precompile agree.
+func TestAgentPolicyV2DigestsMatchTypeScript(t *testing.T) {
+	path := os.Getenv("SEALED_TESTVECTORS")
+	require.NotEmpty(t, path, "chain/scripts/test.sh sets SEALED_TESTVECTORS")
+	raw, err := os.ReadFile(filepath.Join(filepath.Dir(path), "agentpolicy-v2.json"))
+	require.NoError(t, err)
+	var v struct {
+		Input struct {
+			NetworkID    uint32 `json:"networkId"`
+			BlockchainID string `json:"blockchainId"`
+			ChainID      string `json:"chainId"`
+			Agent        string `json:"agent"`
+			OwnerX       string `json:"ownerX"`
+			OwnerY       string `json:"ownerY"`
+			Mandate      struct {
+				Payees      []string `json:"payees"`
+				PerTxCap    string   `json:"perTxCap"`
+				DailyCap    string   `json:"dailyCap"`
+				DailyFeeCap string   `json:"dailyFeeCap"`
+				Expiry      string   `json:"expiry"`
+			} `json:"mandate"`
+			Nonce string `json:"nonce"`
+			Epoch string `json:"epoch"`
+		} `json:"input"`
+		Domain, Register, MandateHash, SetMandate, Freeze, Unfreeze string
+		Cb58                                                        struct {
+			ID  string `json:"id"`
+			Hex string `json:"hex"`
+		} `json:"cb58"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &v))
+	n := func(s string) *big.Int {
+		x, ok := new(big.Int).SetString(s, 10)
+		require.True(t, ok, s)
+		return x
+	}
+	in := v.Input
+	chainID := n(in.ChainID)
+	agent := common.HexToAddress(in.Agent)
+	m := IAgentPolicyMandateV2{
+		PerTxCap: n(in.Mandate.PerTxCap), DailyCap: n(in.Mandate.DailyCap),
+		DailyFeeCap: n(in.Mandate.DailyFeeCap), Expiry: n(in.Mandate.Expiry).Uint64(),
+	}
+	for _, p := range in.Mandate.Payees {
+		m.Payees = append(m.Payees, common.HexToAddress(p))
+	}
+	domain := DomainV2(in.NetworkID, [32]byte(common.HexToHash(in.BlockchainID)), chainID)
+	require.Equal(t, v.Domain, domain.Hex())
+	require.Equal(t, v.Register, RegisterDigestV2(domain, agent, [32]byte(common.HexToHash(in.OwnerX)), [32]byte(common.HexToHash(in.OwnerY))).Hex())
+	require.Equal(t, v.MandateHash, MandateV2Hash(m).Hex())
+	require.Equal(t, v.SetMandate, SetMandateV2Challenge(domain, agent, m, n(in.Nonce)).Hex())
+	require.Equal(t, v.Freeze, FreezeChallengeV2(domain, agent, n(in.Epoch)).Hex())
+	require.Equal(t, v.Unfreeze, UnfreezeChallengeV2(domain, agent, n(in.Nonce), n(in.Epoch)).Hex())
+
+	id, err := ids.FromString(v.Cb58.ID)
+	require.NoError(t, err)
+	require.Equal(t, v.Cb58.Hex, common.Hash(id).Hex())
+}
