+// ruleVersionKey holds the agent-rule version in AgentPolicy's storage: 0 until rule v2 is
+// activated (agentrulev2.Configure writes 2). It cannot collide with per-agent slots, which are
+// keccak hashes of (agent, field, ...).
+var ruleVersionKey = common.BytesToHash([]byte("sealed-arena.agent-rule-version"))
+
+// RuleVersion returns 2 once rule v2 is active, 1 before.
+func RuleVersion(s contract.StateReader) uint64 {
+	if v := s.GetState(ContractAddress, ruleVersionKey).Big().Uint64(); v >= 2 {
+		return v
+	}
+	return 1
+}
+
+// SetRuleVersion writes the rule version (called at rule v2 activation only).
+func SetRuleVersion(s contract.StateDB, v uint64) {
+	s.SetState(ContractAddress, ruleVersionKey, common.BigToHash(new(big.Int).SetUint64(v)))
 }
