diff --git a/graft/subnet-evm/core/agent_policy_v2_test.go b/graft/subnet-evm/core/agent_policy_v2_test.go
new file mode 100644
index 0000000..2e86701
--- /dev/null
+++ b/graft/subnet-evm/core/agent_policy_v2_test.go
@@ -0,0 +1,136 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package core
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/types"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/consensus/dummy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+)
+
+// mandate reads the agent's mandate at the head.
+func (e *arEnv) mandate() (agentpolicy.Mandate, bool) {
+	st, err := e.chain.State()
+	require.NoError(e.t, err)
+	_, m, frozen, _ := agentpolicy.GetMandateForRule(st, arAgent)
+	return m, frozen
+}
+
+// Under rule v2 a mandate carries a daily fee cap: the fourth payment of the day goes over it.
+func TestAgentPolicyV2DailyFeeCap(t *testing.T) {
+	gas := new(big.Int).Mul(new(big.Int).SetUint64(arTransfer), arFeeCap)
+	m := arBigMandate()
+	e := newArEnvWith(t, nil, arConfigV2At(0), dummy.NewCoinbaseFaker())
+	e.good(10, e.relayerCall(e.setMandateV2Data(agentpolicy.IAgentPolicyMandateV2{
+		Payees: m.Payees, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap,
+		DailyFeeCap: new(big.Int).Mul(gas, big.NewInt(3)), Expiry: m.Expiry,
+	}), 1_000_000))
+	got, _ := e.mandate()
+	require.True(t, got.FeeCapSet)
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil), e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil), e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil))
+	require.ErrorIs(t, e.bad(e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil)), ErrAgentFeeBudgetExceeded)
+	// The next UTC day the fee counter starts again.
+	e.good(86_400, e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil))
+	e.checkInvariant()
+}
+
+// A mandate set before rule v2 has no fee cap after the switch: payments go on within dailyCap.
+func TestAgentPolicyV2MandateFromV1KeepsWorking(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(40), dummy.NewCoinbaseFaker())
+	got, _ := e.mandate()
+	require.False(t, got.FeeCapSet)
+	e.good(10, e.pay(1))                                                       // t = 20, v1
+	e.good(10, e.pay(1))                                                       // t = 30, v1
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil)) // t = 40, v2
+	e.good(10, e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil)) // t = 50, v2
+	e.checkInvariant()
+}
+
+// From the switch, setMandate (v1) is refused and setMandateV2 works; before it, setMandateV2 is
+// not a function of the precompile.
+func TestAgentPolicyV2SetMandateSwitch(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(40), dummy.NewCoinbaseFaker())
+	m := arBigMandate()
+	v2 := agentpolicy.IAgentPolicyMandateV2{Payees: []common.Address{arPayee}, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, DailyFeeCap: m.DailyCap, Expiry: m.Expiry}
+
+	// t = 20: setMandateV2 does not exist yet (the call fails, nothing changes).
+	r := e.good(10, e.relayerCall(e.setMandateV2Data(v2), 1_000_000))
+	require.Equal(t, types.ReceiptStatusFailed, r[0].Status)
+	e.ownerNo-- // the proof was not used
+	got, _ := e.mandate()
+	require.Len(t, got.Payees, len(m.Payees))
+
+	e.good(10) // t = 30
+	// t = 40, rule v2: the v1 setMandate (and its v1 proof) is refused.
+	nonce := new(big.Int).SetUint64(e.ownerNo)
+	v1Data, err := agentpolicy.PackSetMandate(agentpolicy.SetMandateInput{Agent: arAgent, M: *arMandate([]common.Address{arPayee}, m.PerTxCap, m.DailyCap, m.Expiry), Nonce: nonce, Auth: e.assertion(agentpolicy.SetMandateChallenge(e.chainID(), arAgent, *arMandate([]common.Address{arPayee}, m.PerTxCap, m.DailyCap, m.Expiry), nonce))})
+	require.NoError(t, err)
+	r = e.good(10, e.relayerCall(v1Data, 1_000_000))
+	require.Equal(t, types.ReceiptStatusFailed, r[0].Status)
+	got, _ = e.mandate()
+	require.Len(t, got.Payees, len(m.Payees), "the v1 call changed nothing")
+
+	// setMandateV2 with a v2 proof works.
+	r = e.good(10, e.relayerCall(e.setMandateV2Data(v2), 1_000_000))
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	got, _ = e.mandate()
+	require.Equal(t, []common.Address{arPayee}, got.Payees)
+	require.True(t, got.FeeCapSet)
+}
+
+// A v2 proof made for another blockchain (same EVM chain id) is refused.
+func TestAgentPolicyV2CrossNetworkReplayRefused(t *testing.T) {
+	e := newArEnvWith(t, nil, arConfigV2At(0), dummy.NewCoinbaseFaker())
+	m := arBigMandate()
+	v2 := agentpolicy.IAgentPolicyMandateV2{Payees: m.Payees, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, DailyFeeCap: m.DailyCap, Expiry: m.Expiry}
+	other := agentpolicy.DomainV2(arNetworkID, [32]byte{0x01}, e.chainID())
+	nonce := new(big.Int).SetUint64(e.ownerNo)
+	data, err := agentpolicy.PackSetMandateV2(agentpolicy.SetMandateV2Input{Agent: arAgent, M: v2, Nonce: nonce, Auth: e.assertion(agentpolicy.SetMandateV2Challenge(other, arAgent, v2, nonce))})
+	require.NoError(t, err)
+	r := e.good(10, e.relayerCall(data, 1_000_000))
+	require.Equal(t, types.ReceiptStatusFailed, r[0].Status)
+	got, _ := e.mandate()
+	require.Empty(t, got.Payees)
+}
+
+// A freeze proof signed ahead of time stays valid across setMandateV2 calls; after an unfreeze
+// the old proof no longer works.
+func TestAgentPolicyV2PreSignedFreeze(t *testing.T) {
+	e := newArEnvWith(t, arBigMandate(), arConfigV2At(0), dummy.NewCoinbaseFaker())
+	preSigned := e.freezeV2Data() // epoch 0
+	m := arBigMandate()
+	v2 := agentpolicy.IAgentPolicyMandateV2{Payees: m.Payees, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, DailyFeeCap: m.DailyCap, Expiry: m.Expiry}
+	e.good(10, e.relayerCall(e.setMandateV2Data(v2), 1_000_000))
+	e.good(10, e.relayerCall(e.setMandateV2Data(v2), 1_000_000))
+
+	r := e.good(10, e.relayerCall(preSigned, 300_000))
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	_, frozen := e.mandate()
+	require.True(t, frozen)
+	require.ErrorIs(t, e.bad(e.pay2()), ErrAgentFrozen)
+	// Freezing again with the same proof succeeds and changes nothing.
+	r = e.good(10, e.relayerCall(preSigned, 300_000))
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+
+	r = e.good(10, e.relayerCall(e.freezeData(false), 300_000)) // unfreeze: epoch 0 -> 1
+	require.Equal(t, types.ReceiptStatusSuccessful, r[0].Status)
+	_, frozen = e.mandate()
+	require.False(t, frozen)
+	r = e.good(10, e.relayerCall(preSigned, 300_000)) // the epoch-0 proof is dead
+	require.Equal(t, types.ReceiptStatusFailed, r[0].Status)
+	_, frozen = e.mandate()
+	require.False(t, frozen)
+	e.good(10, e.pay2())
+	e.checkInvariant()
+}
+
+// pay2 is a v2-conformant payment of 1 wei to the listed payee.
+func (e *arEnv) pay2() *types.Transaction {
+	return e.agentTx2(&arPayee, common.Big1, arTransfer, arTip, nil, nil)
+}
diff --git a/graft/subnet-evm/core/agent_rule.go b/graft/subnet-evm/core/agent_rule.go
new file mode 100644
index 0000000..05a4053
--- /dev/null
+++ b/graft/subnet-evm/core/agent_rule.go
@@ -0,0 +1,261 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package core
+
+import (
+	"errors"
+	"fmt"
+	"math/big"
+	"slices"
+
+	"github.com/ava-labs/libevm/common"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/params"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentpolicy"
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contracts/agentrulev2"
+)
+
+// Sealed Arena validity rule (docs/ARCHITECTURE.md 3.1). A transaction whose sender is
+// a registered agent is valid only inside the agent's mandate. Violations are returned
+// from preCheck, which makes the transaction invalid (it cannot be part of a block),
+// and from the txpool, which refuses it.
+var (
+	ErrAgentContractCreation = errors.New("agent: contract creation not allowed")
+	ErrAgentPayeeNotAllowed  = errors.New("agent: payee not allowed")
+	ErrAgentPayeeHasCode     = errors.New("agent: payee has code")
+	ErrAgentFrozen           = errors.New("agent: frozen")
+	ErrAgentMandateExpired   = errors.New("agent: mandate expired")
+	ErrAgentBudgetExceeded   = errors.New("agent: budget exceeded")
+	ErrAgentTxTypeNotAllowed = errors.New("agent: transaction type not allowed")
+
+	// Rule v2 (from agentRuleV2Config's activation time).
+	ErrAgentGasLimit          = errors.New("agent: gas limit must be 21000")
+	ErrAgentCallData          = errors.New("agent: call data or access list not allowed")
+	ErrAgentPayeeIsPrecompile = errors.New("agent: payee is a precompile")
+	ErrAgentTipTooHigh        = errors.New("agent: tip too high")
+	ErrAgentSetCodeAuthority  = errors.New("agent: set-code authority is a registered agent")
+	ErrAgentFeeBudgetExceeded = errors.New("agent: fee budget exceeded")
+)
+
+// Rule v2 constants. Changing them is a new rule version.
+const (
+	// AgentTransferGas is the only gas limit an agent payment may have: a plain transfer to an
+	// address without code uses exactly this much, so an included payment always succeeds.
+	AgentTransferGas uint64 = 21_000
+)
+
+// AgentMaxTip is the highest effective priority fee per gas an agent may pay (1 gwei).
+var AgentMaxTip = big.NewInt(1_000_000_000)
+
+// AgentRuleState is the read access the rule needs. Both the EVM state in preCheck
+// and the txpool state satisfy it.
+type AgentRuleState interface {
+	contract.StateReader
+	GetCodeSize(common.Address) int
+}
+
+// AgentTx is the part of a transaction the rule looks at.
+type AgentTx struct {
+	From      common.Address
+	To        *common.Address
+	Value     *big.Int
+	GasLimit  uint64
+	GasFeeCap *big.Int // legacy and access-list transactions: the gas price
+	// Plain is true for transaction types 0, 1 and 2, the only types an agent may send.
+	Plain bool
+	// Reserved is what the agent already has in the transaction pool (the sum of the charges of
+	// its other pooled transactions). Only the pool sets it; preCheck leaves it nil, so block
+	// validity is unchanged.
+	Reserved *big.Int
+
+	// V2 applies the rule v2 checks (set from the rule version at the block's time). The fields
+	// below are read only when V2 is set.
+	V2            bool
+	TxType        uint8
+	GasTipCap     *big.Int // for types 0 and 1, the gas price
+	BaseFee       *big.Int // base fee of the block (pool: of the head); nil before London
+	DataLen       int
+	AccessListLen int
+}
+
+// IsNativePrecompile reports whether addr is one of the EVM's native precompiles at the pinned
+// version (0x01 to 0x0a, and P-256 verification at 0x100). They have no code in state, so the
+// "payee has code" check does not catch them. The list is part of rule v2: it does not follow
+// library upgrades.
+func IsNativePrecompile(addr common.Address) bool {
+	for _, b := range addr[:18] {
+		if b != 0 {
+			return false
+		}
+	}
+	v := uint16(addr[18])<<8 | uint16(addr[19])
+	return (v >= 0x01 && v <= 0x0a) || v == 0x100
+}
+
+// effectiveTip is min(tipCap, feeCap - baseFee), or tipCap when there is no base fee.
+func effectiveTip(tx AgentTx) *big.Int {
+	tip := tx.GasTipCap
+	if tip == nil {
+		tip = tx.GasFeeCap
+	}
+	if tx.BaseFee == nil {
+		return tip
+	}
+	headroom := new(big.Int).Sub(tx.GasFeeCap, tx.BaseFee)
+	if headroom.Cmp(tip) < 0 {
+		return headroom
+	}
+	return tip
+}
+
+// checkAgentTxV2 is applied after every v1 check passed, so it only refuses transactions that
+// v1 accepts, and v1 refusal reasons do not change.
+func checkAgentTxV2(tx AgentTx) error {
+	if tx.TxType > 2 {
+		return ErrAgentTxTypeNotAllowed
+	}
+	if tx.GasLimit != AgentTransferGas {
+		return fmt.Errorf("%w: %d", ErrAgentGasLimit, tx.GasLimit)
+	}
+	if tx.DataLen != 0 || tx.AccessListLen != 0 {
+		return ErrAgentCallData
+	}
+	if tx.To != nil && IsNativePrecompile(*tx.To) {
+		return fmt.Errorf("%w: %s", ErrAgentPayeeIsPrecompile, tx.To.Hex())
+	}
+	if tip := effectiveTip(tx); tip.Cmp(AgentMaxTip) > 0 {
+		return fmt.Errorf("%w: %s above %s", ErrAgentTipTooHigh, tip, AgentMaxTip)
+	}
+	return nil
+}
+
+// CheckSetCodeAuthorities refuses (rule v2) a transaction from any sender whose set-code
+// authorizations (EIP-7702) name a registered agent: setting code on the agent's account would
+// let anyone call into it without a transaction from the agent.
+func CheckSetCodeAuthorities(state AgentRuleState, authorities []common.Address) error {
+	for _, a := range authorities {
+		if registered, _, _, _ := agentpolicy.GetMandateForRule(state, a); registered {
+			return fmt.Errorf("%w: %s", ErrAgentSetCodeAuthority, a.Hex())
+		}
+	}
+	return nil
+}
+
+// AgentMaxFee is the most the transaction can pay in fees: gasLimit * gasFeeCap.
+func AgentMaxFee(tx AgentTx) *big.Int {
+	if tx.GasFeeCap == nil {
+		return new(big.Int)
+	}
+	return new(big.Int).Mul(new(big.Int).SetUint64(tx.GasLimit), tx.GasFeeCap)
+}
+
+// AgentCharge returns value + gasLimit * gasFeeCap, the most the transaction can take
+// from the sender. The rule charges this amount, not the gas actually used.
+func AgentCharge(tx AgentTx) *big.Int {
+	charge := new(big.Int).SetUint64(tx.GasLimit)
+	if tx.GasFeeCap != nil {
+		charge.Mul(charge, tx.GasFeeCap)
+	} else {
+		charge.SetUint64(0)
+	}
+	if tx.Value != nil {
+		charge.Add(charge, tx.Value)
+	}
+	return charge
+}
+
+// CheckAgentTx applies the rule. It only reads state. `applies` is false when the
+// sender is not a registered agent, in which case the rule does not constrain the
+// transaction. When `applies` is true and err is nil, `charge` is the amount the
+// caller must record with agentpolicy.ChargeSpend (preCheck only).
+//
+// The caller decides whether the rule is active (AgentPolicy enabled at the block time).
+func CheckAgentTx(state AgentRuleState, timestamp uint64, tx AgentTx) (charge *big.Int, applies bool, err error) {
+	registered, m, frozen, _ := agentpolicy.GetMandateForRule(state, tx.From)
+	if !registered {
+		return nil, false, nil
+	}
+	if !tx.Plain {
+		return nil, true, ErrAgentTxTypeNotAllowed
+	}
+	// A decoded transaction always has a fee cap; a message built without one would otherwise be
+	// charged no gas (AgentCharge), so it is refused instead of passing for free.
+	if tx.GasFeeCap == nil {
+		return nil, true, fmt.Errorf("%w: no fee cap", ErrAgentBudgetExceeded)
+	}
+	// 1. no contract creation
+	if tx.To == nil {
+		return nil, true, ErrAgentContractCreation
+	}
+	// 2. payee in the mandate
+	if !slices.Contains(m.Payees, *tx.To) {
+		return nil, true, fmt.Errorf("%w: %s", ErrAgentPayeeNotAllowed, tx.To.Hex())
+	}
+	// 3. payee has no code
+	if state.GetCodeSize(*tx.To) > 0 {
+		return nil, true, fmt.Errorf("%w: %s", ErrAgentPayeeHasCode, tx.To.Hex())
+	}
+	// 4. not frozen
+	if frozen {
+		return nil, true, ErrAgentFrozen
+	}
+	// 5. block.timestamp < expiry
+	if timestamp >= m.Expiry {
+		return nil, true, ErrAgentMandateExpired
+	}
+	// 6. charge <= perTxCap
+	charge = AgentCharge(tx)
+	if charge.Cmp(m.PerTxCap) > 0 {
+		return nil, true, fmt.Errorf("%w: charge %s above perTxCap %s", ErrAgentBudgetExceeded, charge, m.PerTxCap)
+	}
+	// 7. spentToday + charge <= dailyCap (spentToday is zero on a new UTC day)
+	spent := agentpolicy.SpendForDay(state, tx.From, timestamp).SpentToday
+	if tx.Reserved != nil && tx.Reserved.Sign() > 0 {
+		// Pool only: count what the agent already has pooled.
+		if total := new(big.Int).Add(new(big.Int).Add(spent, tx.Reserved), charge); total.Cmp(m.DailyCap) > 0 {
+			return nil, true, fmt.Errorf("%w: spentToday %s + pooled %s + charge %s above dailyCap %s", ErrAgentBudgetExceeded, spent, tx.Reserved, charge, m.DailyCap)
+		}
+	}
+	if total := new(big.Int).Add(spent, charge); total.Cmp(m.DailyCap) > 0 {
+		return nil, true, fmt.Errorf("%w: spentToday %s + charge %s above dailyCap %s", ErrAgentBudgetExceeded, spent, charge, m.DailyCap)
+	}
+	if tx.V2 {
+		if err := checkAgentTxV2(tx); err != nil {
+			return nil, true, err
+		}
+		// The daily fee cap of a v2 mandate (a mandate set before v2 has none: only dailyCap
+		// limits fees, as in v1). The fee counts at its maximum, gas limit x fee cap.
+		if m.FeeCapSet {
+			fee := AgentMaxFee(tx)
+			spentFees := agentpolicy.FeeSpendForDay(state, tx.From, timestamp)
+			if total := new(big.Int).Add(spentFees, fee); total.Cmp(m.DailyFeeCap) > 0 {
+				return nil, true, fmt.Errorf("%w: fees today %s + fee %s above dailyFeeCap %s", ErrAgentFeeBudgetExceeded, spentFees, fee, m.DailyFeeCap)
+			}
+		}
+	}
+	return charge, true, nil
+}
+
+// AgentRuleVersion is the version of the agent rule that applies at a time.
+type AgentRuleVersion int
+
+const (
+	AgentRuleOff AgentRuleVersion = iota // AgentPolicy not enabled
+	AgentRuleV1
+	AgentRuleV2
+)
+
+// AgentRuleVersionAt returns the rule version at `time` from the chain config: off before
+// AgentPolicy is enabled, v2 once agentRuleV2Config is active, v1 otherwise.
+func AgentRuleVersionAt(c *params.ChainConfig, time uint64) AgentRuleVersion {
+	x := params.GetExtra(c)
+	switch {
+	case !x.IsPrecompileEnabled(agentpolicy.ContractAddress, time):
+		return AgentRuleOff
+	case x.IsPrecompileEnabled(agentrulev2.ContractAddress, time):
+		return AgentRuleV2
+	default:
+		return AgentRuleV1
+	}
+}
