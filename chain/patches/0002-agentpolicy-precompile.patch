+
+	t.Run("16 payees and a later mandate with fewer payees", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		owner, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		require.NoError(t, err)
+		// Use a Go-built owner key for this flow so arbitrary mandates can be signed.
+		ownerX, ownerY := p256Pub(owner)
+		agentKey, err := crypto.HexToECDSA(strings.Repeat("12", 32))
+		require.NoError(t, err)
+		sig, err := crypto.Sign(RegisterDigest(e.chainID, v.OtherAgent, ownerX, ownerY).Bytes(), agentKey)
+		require.NoError(t, err)
