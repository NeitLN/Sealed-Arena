+	t.Run("signature for another chain id: rejected", func(t *testing.T) {
+		e := newEnv(t, big.NewInt(1))
+		_, err := e.call(t, registerInput(t, v.Agent, x, y, hexBytes(t, v.Register.AgentSig)), false)
+		require.ErrorIs(t, err, ErrBadAgentSignature)
