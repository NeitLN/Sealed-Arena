+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"math/big"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/types"
+	"github.com/ava-labs/libevm/core/vm"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+)
+
+// chainIDProvider lets tests supply the EVM chain id without a full EVM.
+type chainIDProvider interface {
+	EVMChainID() *big.Int
+}
+
+type precompileEnvProvider interface {
+	GetPrecompileEnv() vm.PrecompileEnvironment
+}
+
+// evmChainID returns the EVM chain id (261126 on the Sealed L1). It is part of every
+// signed message so a signature for one chain cannot be replayed on another.
+func evmChainID(as contract.AccessibleState) (*big.Int, error) {
+	if p, ok := as.(chainIDProvider); ok {
+		return new(big.Int).Set(p.EVMChainID()), nil
+	}
+	if p, ok := as.(precompileEnvProvider); ok {
+		if cfg := p.GetPrecompileEnv().ChainConfig(); cfg != nil && cfg.ChainID != nil {
+			return new(big.Int).Set(cfg.ChainID), nil
+		}
+	}
+	return nil, ErrNoChainID
+}
+
+func emit(as contract.AccessibleState, remainingGas *uint64, gas uint64, topics []common.Hash, data []byte) error {
+	var err error
+	if *remainingGas, err = contract.DeductGas(*remainingGas, gas); err != nil {
+		return err
+	}
+	as.GetStateDB().AddLog(&types.Log{
+		Address:     ContractAddress,
+		Topics:      topics,
+		Data:        data,
+		BlockNumber: as.GetBlockContext().Number().Uint64(),
+	})
+	return nil
+}
+
+func doRegister(as contract.AccessibleState, remainingGas *uint64, in RegisterInput) error {
+	st := as.GetStateDB()
+	if isRegistered(st, in.Agent) {
+		return ErrAlreadyRegistered
+	}
+	if !validOwnerKey(in.OwnerX, in.OwnerY) {
+		return ErrBadOwnerKey
+	}
+	chainID, err := evmChainID(as)
+	if err != nil {
+		return err
+	}
+	if err := verifyAgentSignature(in.Agent, RegisterDigest(chainID, in.Agent, in.OwnerX, in.OwnerY), in.AgentSig); err != nil {
+		return err
+	}
+
+	setFlag(st, in.Agent, flagRegistered, true)
+	setWord(st, in.Agent, fieldOwnerX, in.OwnerX)
+	setWord(st, in.Agent, fieldOwnerY, in.OwnerY)
+	setUint64(st, in.Agent, fieldOwnerNonce, 0)
+
+	data := AgentRegisteredEventData{OwnerX: in.OwnerX, OwnerY: in.OwnerY}
+	topics, packed, err := PackAgentRegisteredEvent(in.Agent, data)
+	if err != nil {
+		return err
+	}
+	return emit(as, remainingGas, GetAgentRegisteredEventGasCost(data), topics, packed)
+}
+
+// checkOwner verifies that `nonce` is the next owner nonce and that `auth` is the
+// owner's passkey assertion over `challenge`; on success it increments the nonce.
+func checkOwner(st contract.StateDB, agent common.Address, nonce *big.Int, auth []byte, challenge common.Hash) error {
+	if !isRegistered(st, agent) {
+		return ErrNotRegistered
+	}
+	current := getUint64(st, agent, fieldOwnerNonce)
+	if nonce == nil || !nonce.IsUint64() || nonce.Uint64() != current {
+		return ErrBadNonce
+	}
+	x := [32]byte(getWord(st, agent, fieldOwnerX))
+	y := [32]byte(getWord(st, agent, fieldOwnerY))
+	if err := VerifyWebAuthn(auth, challenge, x, y); err != nil {
+		return err
+	}
+	setUint64(st, agent, fieldOwnerNonce, current+1)
+	return nil
+}
+
+func doSetMandate(as contract.AccessibleState, remainingGas *uint64, in SetMandateInput) error {
+	if len(in.M.Payees) > MaxPayees {
+		return ErrTooManyPayees
+	}
+	if in.M.PerTxCap == nil || in.M.DailyCap == nil || in.M.PerTxCap.Cmp(in.M.DailyCap) > 0 {
+		return ErrPerTxAboveDaily
+	}
+	chainID, err := evmChainID(as)
+	if err != nil {
+		return err
+	}
+	st := as.GetStateDB()
+	if err := checkOwner(st, in.Agent, in.Nonce, in.Auth, SetMandateChallenge(chainID, in.Agent, in.M, in.Nonce)); err != nil {
+		return err
+	}
+	writeMandate(st, in.Agent, Mandate{
+		Payees:   in.M.Payees,
+		PerTxCap: in.M.PerTxCap,
+		DailyCap: in.M.DailyCap,
+		Expiry:   in.M.Expiry,
+	})
+
+	data := MandateSetEventData{
+		PerTxCap:   in.M.PerTxCap,
+		DailyCap:   in.M.DailyCap,
+		Expiry:     in.M.Expiry,
+		PayeeCount: big.NewInt(int64(len(in.M.Payees))),
+	}
+	topics, packed, err := PackMandateSetEvent(in.Agent, data)
+	if err != nil {
+		return err
+	}
+	return emit(as, remainingGas, GetMandateSetEventGasCost(data), topics, packed)
+}
+
+func doToggleFreeze(as contract.AccessibleState, remainingGas *uint64, agent common.Address, nonce *big.Int, auth []byte, freeze bool) error {
+	chainID, err := evmChainID(as)
+	if err != nil {
+		return err
+	}
+	challenge := UnfreezeChallenge(chainID, agent, nonce)
+	if freeze {
+		challenge = FreezeChallenge(chainID, agent, nonce)
+	}
+	st := as.GetStateDB()
+	if err := checkOwner(st, agent, nonce, auth, challenge); err != nil {
+		return err
+	}
+	setFlag(st, agent, flagFrozen, freeze)
+
+	if freeze {
+		topics, packed, err := PackFrozenEvent(agent)
+		if err != nil {
+			return err
+		}
+		return emit(as, remainingGas, GetFrozenEventGasCost(), topics, packed)
+	}
+	topics, packed, err := PackUnfrozenEvent(agent)
+	if err != nil {
+		return err
+	}
+	return emit(as, remainingGas, GetUnfrozenEventGasCost(), topics, packed)
+}
+
+func viewMandate(st contract.StateReader, agent common.Address) GetMandateOutput {
+	registered, m, frozen, _ := GetMandateForRule(st, agent)
+	if !registered {
+		return GetMandateOutput{M: IAgentPolicyMandate{Payees: []common.Address{}, PerTxCap: new(big.Int), DailyCap: new(big.Int)}}
+	}
+	return GetMandateOutput{
+		M:      IAgentPolicyMandate{Payees: m.Payees, PerTxCap: m.PerTxCap, DailyCap: m.DailyCap, Expiry: m.Expiry},
+		Frozen: frozen,
+	}
+}
+
+// viewSpend reports the counter as of the current block: spentToday reads as zero
+// once the UTC day has changed, matching what the validity rule will apply.
+func viewSpend(st contract.StateReader, agent common.Address, timestamp uint64) GetSpendOutput {
+	sp := SpendForDay(st, agent, timestamp)
+	return GetSpendOutput{SpentToday: sp.SpentToday, DayIndex: sp.DayIndex, TotalCharged: sp.TotalCharged}
+}
