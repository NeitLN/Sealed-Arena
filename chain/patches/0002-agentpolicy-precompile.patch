+// ---- clientDataJSON parsing -----------------------------------------------------
+
+func TestAgentPolicyParseClientData(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		json string
+		ok   bool
+	}{
+		{"minimal", `{"type":"webauthn.get","challenge":"abc"}`, true},
+		{"extra fields", `{"type":"webauthn.get","challenge":"abc","origin":"x","crossOrigin":false,"other":{"a":[1,2]}}`, true},
+		{"duplicate type", `{"type":"webauthn.create","type":"webauthn.get","challenge":"abc"}`, false},
+		{"duplicate challenge", `{"type":"webauthn.get","challenge":"abc","challenge":"abd"}`, false},
+		{"missing challenge", `{"type":"webauthn.get"}`, false},
+		{"challenge not a string", `{"type":"webauthn.get","challenge":1}`, false},
+		{"not an object", `["webauthn.get"]`, false},
+		{"trailing data", `{"type":"webauthn.get","challenge":"abc"}{}`, false},
+		{"truncated", `{"type":"webauthn.get","challenge":"abc"`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, _, err := parseClientData([]byte(tc.json))
+			if tc.ok {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, ErrBadClientData)
+			}
+		})
+	}
+}
