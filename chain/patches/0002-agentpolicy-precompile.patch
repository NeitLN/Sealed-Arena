+func TestAgentPolicySetMandate(t *testing.T) {
+	v := loadVectors(t)
+	m := v.mandate(t)
+
+	t.Run("challenge matches the shared vector", func(t *testing.T) {
+		require.Equal(t, common.HexToHash(v.SetMandate.Challenge), SetMandateChallenge(bigStr(t, v.ChainID), v.Agent, m, big.NewInt(0)))
+	})
+
+	t.Run("valid passkey proof: stored, nonce +1, MandateSet emitted", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		_, err := e.call(t, setMandateInput(t, v.Agent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.NoError(t, err)
+		require.Equal(t, uint64(1), ownerNonceOf(t, e, v.Agent))
+		got := mandateOf(t, e, v.Agent)
+		require.Equal(t, m.Payees, got.M.Payees)
+		require.Equal(t, 0, m.PerTxCap.Cmp(got.M.PerTxCap))
+		require.Equal(t, 0, m.DailyCap.Cmp(got.M.DailyCap))
+		require.Equal(t, m.Expiry, got.M.Expiry)
+		require.False(t, got.Frozen)
+		logs := e.db.raw.Logs()
+		require.Equal(t, AgentPolicyABI.Events["MandateSet"].ID, logs[len(logs)-1].Topics[0])
+	})
+
+	errByName := map[string]error{
+		"ErrBadOwnerSignature": ErrBadOwnerSignature,
+		"ErrChallengeMismatch": ErrChallengeMismatch,
+		"ErrBadClientDataType": ErrBadClientDataType,
+		"ErrUserNotPresent":    ErrUserNotPresent,
+		"ErrHighS":             ErrHighS,
+		"ErrBadClientData":     ErrBadClientData,
+	}
+	for name, a := range v.SetMandate.Invalid {
+		t.Run("vector "+name+": rejected", func(t *testing.T) {
+			want, ok := errByName[a.Error]
+			require.True(t, ok, "unknown error %s", a.Error)
+			e := registeredEnv(t, v)
+			_, err := e.call(t, setMandateInput(t, v.Agent, m, 0, hexBytes(t, a.Auth)), false)
+			require.ErrorIs(t, err, want)
+			require.Equal(t, uint64(0), ownerNonceOf(t, e, v.Agent), "nonce must not move")
+		})
+	}
+
+	t.Run("replay of a used proof: rejected", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		in := setMandateInput(t, v.Agent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth))
+		_, err := e.call(t, in, false)
+		require.NoError(t, err)
+		_, err = e.call(t, in, false)
+		require.ErrorIs(t, err, ErrBadNonce)
+	})
+
+	t.Run("future nonce: rejected", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		_, err := e.call(t, setMandateInput(t, v.Agent, m, 1, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.ErrorIs(t, err, ErrBadNonce)
+	})
+
+	t.Run("proof for agent A used for agent B: rejected", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		// Register the other agent with the same owner key, then replay agent A's proof on it.
+		key, err := crypto.HexToECDSA(strings.Repeat("12", 32))
+		require.NoError(t, err)
+		x, y := hex32(t, v.Owner.X), hex32(t, v.Owner.Y)
+		sig, err := crypto.Sign(RegisterDigest(e.chainID, v.OtherAgent, x, y).Bytes(), key)
+		require.NoError(t, err)
+		_, err = e.call(t, registerInput(t, v.OtherAgent, x, y, sig), false)
+		require.NoError(t, err)
+		_, err = e.call(t, setMandateInput(t, v.OtherAgent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.ErrorIs(t, err, ErrChallengeMismatch)
