+// ---- spend counter (used by the validity rule in T05) --------------------------
+
+func TestAgentPolicyChargeSpend(t *testing.T) {
+	e := newEnv(t, big.NewInt(261126))
+	agent := common.HexToAddress("0x00000000000000000000000000000000000000a1")
+	day := uint64(20_000)
+	ts := day*86400 + 100
+
+	ChargeSpend(e.db, agent, big.NewInt(300), ts)
+	ChargeSpend(e.db, agent, big.NewInt(200), ts+3600)
+	sp := SpendForDay(e.db, agent, ts+7200)
+	require.Equal(t, int64(500), sp.SpentToday.Int64())
+	require.Equal(t, int64(500), sp.TotalCharged.Int64())
+	require.Equal(t, day, sp.DayIndex)
+
+	// Next UTC day: spentToday starts again, totalCharged keeps the history.
+	next := (day+1)*86400 + 5
+	require.Equal(t, int64(0), SpendForDay(e.db, agent, next).SpentToday.Int64())
+	ChargeSpend(e.db, agent, big.NewInt(70), next)
+	sp = SpendForDay(e.db, agent, next)
+	require.Equal(t, int64(70), sp.SpentToday.Int64())
+	require.Equal(t, int64(570), sp.TotalCharged.Int64())
+	require.Equal(t, day+1, sp.DayIndex)
+
+	// getSpend reports the same view at the block time.
+	e.ts = next + 10
+	in, err := PackGetSpend(agent)
+	require.NoError(t, err)
+	ret, err := e.call(t, in, true)
+	require.NoError(t, err)
+	out, err := UnpackGetSpendOutput(ret)
+	require.NoError(t, err)
+	require.Equal(t, int64(70), out.SpentToday.Int64())
+	require.Equal(t, int64(570), out.TotalCharged.Int64())
+}
+
+func TestAgentPolicyGetMandateForRule(t *testing.T) {
+	v := loadVectors(t)
+	e := newEnv(t, bigStr(t, v.ChainID))
+	registered, _, _, _ := GetMandateForRule(e.db, v.Agent)
+	require.False(t, registered)
+
+	e = registeredEnv(t, v)
+	registered, m, frozen, sp := GetMandateForRule(e.db, v.Agent)
+	require.True(t, registered)
+	require.Empty(t, m.Payees, "a new agent has no mandate")
+	require.Equal(t, uint64(0), m.Expiry)
+	require.False(t, frozen)
+	require.Equal(t, int64(0), sp.TotalCharged.Int64())
+}
