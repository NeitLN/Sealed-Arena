+// ---- freeze / unfreeze -------------------------------------------------------
+
+func TestAgentPolicyFreeze(t *testing.T) {
+	v := loadVectors(t)
+	m := v.mandate(t)
+
+	withMandate := func(t *testing.T) *testEnv {
+		e := registeredEnv(t, v)
+		_, err := e.call(t, setMandateInput(t, v.Agent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.NoError(t, err)
+		return e
+	}
+
+	t.Run("challenges match the shared vectors", func(t *testing.T) {
+		chainID := bigStr(t, v.ChainID)
+		require.Equal(t, common.HexToHash(v.Freeze.Challenge), FreezeChallenge(chainID, v.Agent, big.NewInt(1)))
+		require.Equal(t, common.HexToHash(v.Unfreeze.Challenge), UnfreezeChallenge(chainID, v.Agent, big.NewInt(2)))
+	})
+
+	t.Run("owner freezes then unfreezes", func(t *testing.T) {
+		e := withMandate(t)
+		_, err := e.call(t, freezeInput(t, v.Agent, 1, hexBytes(t, v.Freeze.Valid.Auth), true), false)
+		require.NoError(t, err)
+		require.True(t, mandateOf(t, e, v.Agent).Frozen)
+		require.Equal(t, AgentPolicyABI.Events["Frozen"].ID, e.db.raw.Logs()[len(e.db.raw.Logs())-1].Topics[0])
+
+		_, err = e.call(t, freezeInput(t, v.Agent, 2, hexBytes(t, v.Unfreeze.Valid.Auth), false), false)
+		require.NoError(t, err)
+		require.False(t, mandateOf(t, e, v.Agent).Frozen)
+		require.Equal(t, AgentPolicyABI.Events["Unfrozen"].ID, e.db.raw.Logs()[len(e.db.raw.Logs())-1].Topics[0])
+		require.Equal(t, uint64(3), ownerNonceOf(t, e, v.Agent))
+	})
+
+	t.Run("freeze proof cannot unfreeze", func(t *testing.T) {
+		e := withMandate(t)
+		_, err := e.call(t, freezeInput(t, v.Agent, 1, hexBytes(t, v.Freeze.Valid.Auth), false), false)
+		require.ErrorIs(t, err, ErrChallengeMismatch)
+	})
+
+	t.Run("wrong key cannot freeze", func(t *testing.T) {
+		e := withMandate(t)
+		attacker, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		require.NoError(t, err)
+		auth := p256Assertion(t, attacker, FreezeChallenge(e.chainID, v.Agent, big.NewInt(1)))
+		_, err = e.call(t, freezeInput(t, v.Agent, 1, auth, true), false)
+		require.ErrorIs(t, err, ErrBadOwnerSignature)
+		require.False(t, mandateOf(t, e, v.Agent).Frozen)
+	})
+}
+
+// The agent key can only register (once). It cannot change the mandate or the
+// frozen flag, whoever sends the transaction.
+func TestAgentPolicyAgentKeyCannotChangeMandate(t *testing.T) {
+	v := loadVectors(t)
+	m := v.mandate(t)
+	e := registeredEnv(t, v)
+	agentKey, err := crypto.HexToECDSA(strings.Repeat("11", 32))
+	require.NoError(t, err)
+	require.Equal(t, v.Agent, crypto.PubkeyToAddress(agentKey.PublicKey))
+
+	// An agent secp256k1 signature in place of the passkey proof.
+	agentSig, err := crypto.Sign(SetMandateChallenge(e.chainID, v.Agent, m, big.NewInt(0)).Bytes(), agentKey)
+	require.NoError(t, err)
+	_, _, err = AgentPolicyPrecompile.Run(e, v.Agent, ContractAddress, setMandateInput(t, v.Agent, m, 0, agentSig), callGas, false)
+	require.ErrorIs(t, err, ErrBadAuthEncoding)
+
+	// A passkey the attacker controls.
+	attacker, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	auth := p256Assertion(t, attacker, SetMandateChallenge(e.chainID, v.Agent, m, big.NewInt(0)))
+	_, _, err = AgentPolicyPrecompile.Run(e, v.Agent, ContractAddress, setMandateInput(t, v.Agent, m, 0, auth), callGas, false)
+	require.ErrorIs(t, err, ErrBadOwnerSignature)
+	_, _, err = AgentPolicyPrecompile.Run(e, v.Agent, ContractAddress, freezeInput(t, v.Agent, 0, auth, false), callGas, false)
+	require.Error(t, err)
+
+	// Re-registering with a new owner key.
+	newX, newY := p256Pub(attacker)
+	sig, err := crypto.Sign(RegisterDigest(e.chainID, v.Agent, newX, newY).Bytes(), agentKey)
+	require.NoError(t, err)
+	_, err = e.call(t, registerInput(t, v.Agent, newX, newY, sig), false)
+	require.ErrorIs(t, err, ErrAlreadyRegistered)
+
+	require.Equal(t, uint64(0), ownerNonceOf(t, e, v.Agent))
+	require.Empty(t, mandateOf(t, e, v.Agent).M.Payees)
+}
