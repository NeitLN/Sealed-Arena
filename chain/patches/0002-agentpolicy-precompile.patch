+	t.Run("second registration: rejected", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		other := hex32(t, v.OtherOwner.X)
+		_, err := e.call(t, registerInput(t, v.Agent, other, hex32(t, v.OtherOwner.Y), hexBytes(t, v.Register.AgentSig)), false)
+		require.ErrorIs(t, err, ErrAlreadyRegistered)
+	})
+
+	t.Run("owner key not on P-256: rejected", func(t *testing.T) {
+		e := newEnv(t, bigStr(t, v.ChainID))
+		badY := y
+		badY[31] ^= 1
+		_, err := e.call(t, registerInput(t, v.Agent, x, badY, hexBytes(t, v.Register.AgentSig)), false)
+		require.ErrorIs(t, err, ErrBadOwnerKey)
+		_, err = e.call(t, registerInput(t, v.Agent, [32]byte{}, [32]byte{}, hexBytes(t, v.Register.AgentSig)), false)
