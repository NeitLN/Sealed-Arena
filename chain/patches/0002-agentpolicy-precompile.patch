+	t.Run("signature by another key: rejected", func(t *testing.T) {
+		e := newEnv(t, bigStr(t, v.ChainID))
+		_, err := e.call(t, registerInput(t, v.Agent, x, y, hexBytes(t, v.Register.OtherAgentSig)), false)
+		require.ErrorIs(t, err, ErrBadAgentSignature)
