+	t.Run("perTxCap greater than dailyCap: rejected", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		bad := m
+		bad.PerTxCap = new(big.Int).Add(m.DailyCap, common.Big1)
+		_, err := e.call(t, setMandateInput(t, v.Agent, bad, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.ErrorIs(t, err, ErrPerTxAboveDaily)
