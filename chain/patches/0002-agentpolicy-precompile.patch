index 0000000..f988102
--- /dev/null
+++ b/graft/subnet-evm/precompile/contracts/agentpolicy/webauthn.go
@@ -0,0 +1,237 @@
+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"bytes"
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+
+	"github.com/ava-labs/libevm/accounts/abi"
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/crypto"
+)
+
+var (
+	ErrNotRegistered       = errors.New("agentpolicy: agent not registered")
+	ErrAlreadyRegistered   = errors.New("agentpolicy: agent already registered")
+	ErrBadAgentSignature   = errors.New("agentpolicy: agent signature invalid")
+	ErrBadOwnerKey         = errors.New("agentpolicy: owner key is not a P-256 point")
+	ErrBadNonce            = errors.New("agentpolicy: nonce does not match ownerNonce")
+	ErrBadAuthEncoding     = errors.New("agentpolicy: auth is not abi.encode(bytes,bytes,bytes32,bytes32)")
+	ErrBadClientData       = errors.New("agentpolicy: clientDataJSON invalid")
+	ErrBadClientDataType   = errors.New("agentpolicy: clientDataJSON type is not webauthn.get")
+	ErrChallengeMismatch   = errors.New("agentpolicy: challenge mismatch")
+	ErrUserNotPresent      = errors.New("agentpolicy: user present flag not set")
+	ErrBadAuthenticatorDat = errors.New("agentpolicy: authenticatorData too short")
+	ErrHighS               = errors.New("agentpolicy: signature s is in the upper half")
+	ErrBadOwnerSignature   = errors.New("agentpolicy: owner signature invalid")
+	ErrTooManyPayees       = errors.New("agentpolicy: more than 16 payees")
+	ErrPerTxAboveDaily     = errors.New("agentpolicy: perTxCap greater than dailyCap")
+	ErrNoChainID           = errors.New("agentpolicy: chain id unavailable")
+)
+
+var (
+	tString, _  = abi.NewType("string", "", nil)
+	tUint256, _ = abi.NewType("uint256", "", nil)
+	tAddress, _ = abi.NewType("address", "", nil)
+	tBytes32, _ = abi.NewType("bytes32", "", nil)
+	tBytes, _   = abi.NewType("bytes", "", nil)
+	tMandate, _ = abi.NewType("tuple", "", []abi.ArgumentMarshaling{
+		{Name: "payees", Type: "address[]"},
+		{Name: "perTxCap", Type: "uint256"},
+		{Name: "dailyCap", Type: "uint256"},
+		{Name: "expiry", Type: "uint64"},
+	})
+
+	authArgs = abi.Arguments{{Type: tBytes}, {Type: tBytes}, {Type: tBytes32}, {Type: tBytes32}}
+
+	p256HalfN = new(big.Int).Rsh(elliptic.P256().Params().N, 1)
+)
+
+func mustPack(args abi.Arguments, values ...any) []byte {
+	b, err := args.Pack(values...)
+	if err != nil {
+		panic(err) // only reachable with a programming error in this file
+	}
+	return b
+}
+
+// RegisterDigest is keccak256(abi.encode("SealedArena:register", chainId, agent, ownerX, ownerY)).
+func RegisterDigest(chainID *big.Int, agent common.Address, ownerX, ownerY [32]byte) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tUint256}, {Type: tAddress}, {Type: tBytes32}, {Type: tBytes32}},
+		"SealedArena:register", chainID, agent, ownerX, ownerY,
+	))
+}
+
+// MandateHash is keccak256(abi.encode(m)).
+func MandateHash(m IAgentPolicyMandate) common.Hash {
+	return crypto.Keccak256Hash(mustPack(abi.Arguments{{Type: tMandate}}, m))
+}
+
+// SetMandateChallenge is keccak256(abi.encode("SealedArena:setMandate", chainId, agent, keccak256(abi.encode(m)), nonce)).
+func SetMandateChallenge(chainID *big.Int, agent common.Address, m IAgentPolicyMandate, nonce *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tUint256}, {Type: tAddress}, {Type: tBytes32}, {Type: tUint256}},
+		"SealedArena:setMandate", chainID, agent, [32]byte(MandateHash(m)), nonce,
+	))
+}
+
+// FreezeChallenge and UnfreezeChallenge follow docs/ARCHITECTURE.md 3.3.
+func FreezeChallenge(chainID *big.Int, agent common.Address, nonce *big.Int) common.Hash {
+	return toggleChallenge("SealedArena:freeze", chainID, agent, nonce)
+}
+
+func UnfreezeChallenge(chainID *big.Int, agent common.Address, nonce *big.Int) common.Hash {
+	return toggleChallenge("SealedArena:unfreeze", chainID, agent, nonce)
+}
+
+func toggleChallenge(tag string, chainID *big.Int, agent common.Address, nonce *big.Int) common.Hash {
+	return crypto.Keccak256Hash(mustPack(
+		abi.Arguments{{Type: tString}, {Type: tUint256}, {Type: tAddress}, {Type: tUint256}},
+		tag, chainID, agent, nonce,
+	))
+}
+
+// verifyAgentSignature checks a 65-byte secp256k1 signature (r || s || v, v in {0,1,27,28})
+// by `agent` over `digest`, with s in the lower half.
+func verifyAgentSignature(agent common.Address, digest common.Hash, sig []byte) error {
+	if len(sig) != 65 {
+		return ErrBadAgentSignature
+	}
+	s := make([]byte, 65)
+	copy(s, sig)
+	if s[64] >= 27 {
+		s[64] -= 27
+	}
+	r, sv := new(big.Int).SetBytes(s[:32]), new(big.Int).SetBytes(s[32:64])
+	if !crypto.ValidateSignatureValues(s[64], r, sv, true) {
+		return ErrBadAgentSignature
+	}
+	pub, err := crypto.SigToPub(digest.Bytes(), s)
+	if err != nil || crypto.PubkeyToAddress(*pub) != agent {
+		return ErrBadAgentSignature
+	}
+	return nil
+}
+
+// validOwnerKey reports whether (x, y) is a point on P-256 (not the identity).
+func validOwnerKey(x, y [32]byte) bool {
+	raw := make([]byte, 0, 65)
+	raw = append(raw, 0x04)
+	raw = append(raw, x[:]...)
+	raw = append(raw, y[:]...)
+	_, err := ecdh.P256().NewPublicKey(raw)
+	return err == nil
+}
+
+// parseClientData extracts "type" and "challenge" from clientDataJSON. The input must be
+// a single JSON object; duplicate keys anywhere at the top level are rejected, and both
+// fields must be present and be strings.
+func parseClientData(raw []byte) (typ, challenge string, err error) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	tok, err := dec.Token()
+	if err != nil || tok != json.Delim('{') {
+		return "", "", ErrBadClientData
+	}
+	seen := make(map[string]bool)
+	var gotType, gotChallenge bool
+	for dec.More() {
+		keyTok, err := dec.Token()
+		if err != nil {
+			return "", "", ErrBadClientData
+		}
+		key, ok := keyTok.(string)
+		if !ok || seen[key] {
+			return "", "", fmt.Errorf("%w: duplicate or invalid key", ErrBadClientData)
+		}
+		seen[key] = true
+		var value json.RawMessage
+		if err := dec.Decode(&value); err != nil {
+			return "", "", ErrBadClientData
+		}
+		switch key {
+		case "type":
+			if err := json.Unmarshal(value, &typ); err != nil {
+				return "", "", ErrBadClientData
+			}
+			gotType = true
+		case "challenge":
+			if err := json.Unmarshal(value, &challenge); err != nil {
+				return "", "", ErrBadClientData
+			}
+			gotChallenge = true
+		}
+	}
+	if tok, err := dec.Token(); err != nil || tok != json.Delim('}') {
+		return "", "", ErrBadClientData
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return "", "", fmt.Errorf("%w: trailing data", ErrBadClientData)
+	}
+	if !gotType || !gotChallenge {
+		return "", "", fmt.Errorf("%w: missing type or challenge", ErrBadClientData)
+	}
+	return typ, challenge, nil
+}
+
+// VerifyWebAuthn checks `auth` = abi.encode(bytes authenticatorData, bytes clientDataJSON,
+// bytes32 r, bytes32 s) against the expected challenge and the owner's P-256 key.
+func VerifyWebAuthn(auth []byte, challenge common.Hash, ownerX, ownerY [32]byte) error {
+	vals, err := authArgs.Unpack(auth)
+	if err != nil || len(vals) != 4 {
+		return ErrBadAuthEncoding
+	}
+	authData, ok1 := vals[0].([]byte)
+	clientData, ok2 := vals[1].([]byte)
+	rb, ok3 := vals[2].([32]byte)
+	sb, ok4 := vals[3].([32]byte)
+	if !ok1 || !ok2 || !ok3 || !ok4 {
+		return ErrBadAuthEncoding
+	}
+	// Reject trailing or non-canonical encodings: re-encoding must give the same bytes.
+	if !bytes.Equal(mustPack(authArgs, authData, clientData, rb, sb), auth) {
+		return ErrBadAuthEncoding
+	}
+
+	typ, gotChallenge, err := parseClientData(clientData)
+	if err != nil {
+		return err
+	}
+	if typ != "webauthn.get" {
+		return ErrBadClientDataType
+	}
+	if gotChallenge != base64.RawURLEncoding.EncodeToString(challenge.Bytes()) {
+		return ErrChallengeMismatch
+	}
+	if len(authData) < 37 {
+		return ErrBadAuthenticatorDat
+	}
+	if authData[32]&0x01 == 0 {
+		return ErrUserNotPresent
+	}
+
+	r, s := new(big.Int).SetBytes(rb[:]), new(big.Int).SetBytes(sb[:])
+	if s.Cmp(p256HalfN) > 0 {
+		return ErrHighS
+	}
+	if !validOwnerKey(ownerX, ownerY) {
+		return ErrBadOwnerKey
+	}
+	clientHash := sha256.Sum256(clientData)
+	msg := sha256.Sum256(append(append([]byte{}, authData...), clientHash[:]...))
+	pub := &ecdsa.PublicKey{Curve: elliptic.P256(), X: new(big.Int).SetBytes(ownerX[:]), Y: new(big.Int).SetBytes(ownerY[:])}
+	if r.Sign() <= 0 || s.Sign() <= 0 || !ecdsa.Verify(pub, msg[:], r, s) {
+		return ErrBadOwnerSignature
+	}
+	return nil
+}
