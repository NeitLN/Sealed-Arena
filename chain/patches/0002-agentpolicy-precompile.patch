+	t.Run("unregistered agent: rejected", func(t *testing.T) {
+		e := newEnv(t, bigStr(t, v.ChainID))
+		_, err := e.call(t, setMandateInput(t, v.Agent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.ErrorIs(t, err, ErrNotRegistered)
