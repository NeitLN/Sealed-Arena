+// p256Assertion builds a WebAuthn assertion over `challenge` in Go, for cases the
+// shared vectors do not cover.
+func p256Assertion(t *testing.T, key *ecdsa.PrivateKey, challenge common.Hash) []byte {
+	t.Helper()
+	authData := append(make([]byte, 32), 0x05, 0, 0, 0, 1)
+	clientData := []byte(`{"type":"webauthn.get","challenge":"` + base64.RawURLEncoding.EncodeToString(challenge.Bytes()) + `"}`)
+	ch := sha256.Sum256(clientData)
+	digest := sha256.Sum256(append(append([]byte{}, authData...), ch[:]...))
+	r, s, err := ecdsa.Sign(rand.Reader, key, digest[:])
+	require.NoError(t, err)
+	if s.Cmp(p256HalfN) > 0 {
+		s.Sub(elliptic.P256().Params().N, s)
+	}
+	return mustPack(authArgs, authData, clientData, [32]byte(common.BigToHash(r)), [32]byte(common.BigToHash(s)))
+}
