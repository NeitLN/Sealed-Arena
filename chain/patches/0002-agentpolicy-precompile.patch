+		require.Equal(t, AgentPolicyABI.Events["AgentRegistered"].ID, logs[0].Topics[0])
+		require.Equal(t, common.BytesToHash(v.Agent.Bytes()), logs[0].Topics[1])
+		require.Equal(t, uint64(0), ownerNonceOf(t, e, v.Agent))
+	})
