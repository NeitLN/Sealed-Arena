+		e.chainID = big.NewInt(43113)
+		_, err := e.call(t, setMandateInput(t, v.Agent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.ErrorIs(t, err, ErrChallengeMismatch)
+	})
+
+	t.Run("more than 16 payees: rejected", func(t *testing.T) {
+		e := registeredEnv(t, v)
+		many := m
+		many.Payees = make([]common.Address, MaxPayees+1)
+		for i := range many.Payees {
+			many.Payees[i] = common.BigToAddress(big2(int64(i + 1)))
+		}
+		_, err := e.call(t, setMandateInput(t, v.Agent, many, 0, hexBytes(t, v.SetMandate.Valid.Auth)), false)
+		require.ErrorIs(t, err, ErrTooManyPayees)
