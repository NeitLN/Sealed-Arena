+// ---- read-only mode ----------------------------------------------------------
+
+func TestAgentPolicyReadOnly(t *testing.T) {
+	v := loadVectors(t)
+	m := v.mandate(t)
+	e := registeredEnv(t, v)
+
+	reads := map[string]func() ([]byte, error){
+		"isAgent":    func() ([]byte, error) { return PackIsAgent(v.Agent) },
+		"getMandate": func() ([]byte, error) { return PackGetMandate(v.Agent) },
+		"getSpend":   func() ([]byte, error) { return PackGetSpend(v.Agent) },
+		"ownerNonce": func() ([]byte, error) { return PackOwnerNonce(v.Agent) },
+		"ownerKey":   func() ([]byte, error) { return PackOwnerKey(v.Agent) },
+	}
+	for name, pack := range reads {
+		t.Run(name+" works read-only", func(t *testing.T) {
+			in, err := pack()
+			require.NoError(t, err)
+			_, err = e.call(t, in, true)
+			require.NoError(t, err)
+		})
+	}
+
+	writes := map[string][]byte{
+		"register":   registerInput(t, v.OtherAgent, hex32(t, v.Owner.X), hex32(t, v.Owner.Y), hexBytes(t, v.Register.AgentSig)),
+		"setMandate": setMandateInput(t, v.Agent, m, 0, hexBytes(t, v.SetMandate.Valid.Auth)),
+		"freeze":     freezeInput(t, v.Agent, 0, nil, true),
+		"unfreeze":   freezeInput(t, v.Agent, 0, nil, false),
+	}
+	for name, in := range writes {
+		t.Run(name+" is rejected read-only", func(t *testing.T) {
+			_, err := e.call(t, in, true)
+			require.ErrorIs(t, err, vm.ErrWriteProtection)
+		})
+	}
+
+	t.Run("ownerKey returns the registered key", func(t *testing.T) {
+		in, err := PackOwnerKey(v.Agent)
+		require.NoError(t, err)
+		ret, err := e.call(t, in, true)
+		require.NoError(t, err)
+		out, err := UnpackOwnerKeyOutput(ret)
+		require.NoError(t, err)
+		require.Equal(t, hex32(t, v.Owner.X), out.X)
+		require.Equal(t, hex32(t, v.Owner.Y), out.Y)
+	})
+}
