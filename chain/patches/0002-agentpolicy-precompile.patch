+// Copyright (C) 2026, Sealed Arena. See the file LICENSE for licensing terms.
+
+package agentpolicy
+
+import (
+	"encoding/binary"
+	"math/big"
+
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/crypto"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+)
+
+// Storage layout. Every value lives in the precompile's own account at
+// keccak256(agent || field) (or keccak256(agent || field || index) for payees),
+// so agents never collide and nothing depends on map iteration order.
+const (
+	fieldFlags        byte = 1 // bit 0: registered, bit 1: frozen, bit 2: has mandate
+	fieldOwnerX       byte = 2
+	fieldOwnerY       byte = 3
+	fieldOwnerNonce   byte = 4
+	fieldPerTxCap     byte = 5
+	fieldDailyCap     byte = 6
+	fieldExpiry       byte = 7
+	fieldPayeeCount   byte = 8
+	fieldSpentToday   byte = 9
+	fieldDayIndex     byte = 10
+	fieldTotalCharged byte = 11
+	fieldPayee        byte = 12 // followed by a 1-byte index
+)
+
+const (
+	flagRegistered uint64 = 1 << 0
+	flagFrozen     uint64 = 1 << 1
+
+	// MaxPayees is the largest payee list a mandate may hold.
+	MaxPayees = 16
+)
+
+func slot(agent common.Address, field byte, extra ...byte) common.Hash {
+	buf := make([]byte, 0, common.AddressLength+2)
+	buf = append(buf, agent.Bytes()...)
+	buf = append(buf, field)
+	buf = append(buf, extra...)
+	return crypto.Keccak256Hash(buf)
+}
+
+func getWord(s contract.StateReader, agent common.Address, field byte, extra ...byte) common.Hash {
+	return s.GetState(ContractAddress, slot(agent, field, extra...))
+}
+
+func setWord(s contract.StateDB, agent common.Address, field byte, v common.Hash, extra ...byte) {
+	s.SetState(ContractAddress, slot(agent, field, extra...), v)
+}
+
+func getUint64(s contract.StateReader, agent common.Address, field byte) uint64 {
+	h := getWord(s, agent, field)
+	return binary.BigEndian.Uint64(h[24:])
+}
+
+func setUint64(s contract.StateDB, agent common.Address, field byte, v uint64) {
+	var h common.Hash
+	binary.BigEndian.PutUint64(h[24:], v)
+	setWord(s, agent, field, h)
+}
+
+func getBig(s contract.StateReader, agent common.Address, field byte) *big.Int {
+	return getWord(s, agent, field).Big()
+}
+
+func setBig(s contract.StateDB, agent common.Address, field byte, v *big.Int) {
+	setWord(s, agent, field, common.BigToHash(v))
+}
+
+// Mandate is the decoded mandate of one agent.
+type Mandate struct {
+	Payees   []common.Address
+	PerTxCap *big.Int
+	DailyCap *big.Int
+	Expiry   uint64
+}
+
+// Spend is the spend counter of one agent.
+type Spend struct {
+	SpentToday   *big.Int
+	DayIndex     uint64
+	TotalCharged *big.Int
+}
+
+func isRegistered(s contract.StateReader, agent common.Address) bool {
+	return getUint64(s, agent, fieldFlags)&flagRegistered != 0
+}
+
+func isFrozen(s contract.StateReader, agent common.Address) bool {
+	return getUint64(s, agent, fieldFlags)&flagFrozen != 0
+}
+
+func setFlag(s contract.StateDB, agent common.Address, flag uint64, on bool) {
+	flags := getUint64(s, agent, fieldFlags)
+	if on {
+		flags |= flag
+	} else {
+		flags &^= flag
+	}
+	setUint64(s, agent, fieldFlags, flags)
+}
+
+func readMandate(s contract.StateReader, agent common.Address) Mandate {
+	n := int(getUint64(s, agent, fieldPayeeCount))
+	if n > MaxPayees {
+		n = MaxPayees
+	}
+	payees := make([]common.Address, n)
+	for i := 0; i < n; i++ {
+		payees[i] = common.BytesToAddress(getWord(s, agent, fieldPayee, byte(i)).Bytes())
+	}
+	return Mandate{
+		Payees:   payees,
+		PerTxCap: getBig(s, agent, fieldPerTxCap),
+		DailyCap: getBig(s, agent, fieldDailyCap),
+		Expiry:   getUint64(s, agent, fieldExpiry),
+	}
+}
+
+func writeMandate(s contract.StateDB, agent common.Address, m Mandate) {
+	old := int(getUint64(s, agent, fieldPayeeCount))
+	for i := 0; i < MaxPayees; i++ {
+		var v common.Hash
+		if i < len(m.Payees) {
+			v = common.BytesToHash(m.Payees[i].Bytes())
+		} else if i >= old {
+			continue // slot already empty
+		}
+		setWord(s, agent, fieldPayee, v, byte(i))
+	}
+	setUint64(s, agent, fieldPayeeCount, uint64(len(m.Payees)))
+	setBig(s, agent, fieldPerTxCap, m.PerTxCap)
+	setBig(s, agent, fieldDailyCap, m.DailyCap)
+	setUint64(s, agent, fieldExpiry, m.Expiry)
+}
+
+func readSpend(s contract.StateReader, agent common.Address) Spend {
+	return Spend{
+		SpentToday:   getBig(s, agent, fieldSpentToday),
+		DayIndex:     getUint64(s, agent, fieldDayIndex),
+		TotalCharged: getBig(s, agent, fieldTotalCharged),
+	}
+}
+
+// GetMandateForRule returns the agent's registration status, mandate, frozen flag
+// and spend counter, read-only. It is the entry point for the validity rule (T05).
+func GetMandateForRule(s contract.StateReader, agent common.Address) (registered bool, m Mandate, frozen bool, spend Spend) {
+	if !isRegistered(s, agent) {
+		return false, Mandate{PerTxCap: new(big.Int), DailyCap: new(big.Int)}, false, Spend{SpentToday: new(big.Int), TotalCharged: new(big.Int)}
+	}
+	return true, readMandate(s, agent), isFrozen(s, agent), readSpend(s, agent)
+}
+
+// SpendForDay returns the spend counter as seen at `timestamp`: spentToday is zero
+// when the UTC day (timestamp / 86400) differs from the stored day index.
+func SpendForDay(s contract.StateReader, agent common.Address, timestamp uint64) Spend {
+	sp := readSpend(s, agent)
+	day := timestamp / 86400
+	if sp.DayIndex != day {
+		sp.SpentToday = new(big.Int)
+		sp.DayIndex = day
+	}
+	return sp
+}
+
+// ChargeSpend adds `charge` to the agent's spend counters at `timestamp`
+// (spentToday resets when the UTC day changes; totalCharged never resets).
+// Callers must check the mandate first; this function only records.
+func ChargeSpend(s contract.StateDB, agent common.Address, charge *big.Int, timestamp uint64) {
+	sp := SpendForDay(s, agent, timestamp)
+	setBig(s, agent, fieldSpentToday, new(big.Int).Add(sp.SpentToday, charge))
+	setUint64(s, agent, fieldDayIndex, sp.DayIndex)
+	setBig(s, agent, fieldTotalCharged, new(big.Int).Add(sp.TotalCharged, charge))
+}
diff --git a/graft/subnet-evm/precompile/contracts/agentpolicy/webauthn.go b/graft/subnet-evm/precompile/contracts/agentpolicy/webauthn.go
