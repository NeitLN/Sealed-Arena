// Writes chain/testvectors/agentpolicy-v2.json: rule v2 digests for fixed inputs, computed with
// packages/shared. The Go tests of the precompile check they compute the same values.
// Usage: pnpm --filter @sealed-arena/shared exec tsx scripts/gen-v2-vectors.mts
import { writeFileSync } from "node:fs";
import {
  cb58ToHex,
  domainV2,
  freezeChallengeV2,
  mandateV2Hash,
  registerDigestV2,
  setMandateV2Challenge,
  unfreezeChallengeV2,
} from "../src/agentPolicy.js";

const input = {
  networkId: 5,
  blockchainId: "0x4f6f17e8f2a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b",
  chainId: "261126",
  agent: "0x19E7E376E7C213B7E7e7e46cc70A5dD086DAff2A",
  ownerX: "0xd65a93977caa3d1b081852ff57a79e465f1660577304baead505dd3a48589cf3",
  ownerY: "0x50185e895372df6221ea3a137557e473fddb6755f05bd507c3c533fce9c91285",
  mandate: {
    payees: [
      "0x00000000000000000000000000000000000000a1",
      "0x00000000000000000000000000000000000000b2",
    ],
    perTxCap: "500000000000000000",
    dailyCap: "1000000000000000000",
    dailyFeeCap: "1000000000000000",
    expiry: "1800000000",
  },
  nonce: "3",
  epoch: "2",
} as const;

const m = {
  payees: input.mandate.payees,
  perTxCap: BigInt(input.mandate.perTxCap),
  dailyCap: BigInt(input.mandate.dailyCap),
  dailyFeeCap: BigInt(input.mandate.dailyFeeCap),
  expiry: BigInt(input.mandate.expiry),
};
const domain = domainV2(input.networkId, input.blockchainId, BigInt(input.chainId));
const out = {
  note: "Rule v2 digests for fixed inputs. Generated by packages/shared/scripts/gen-v2-vectors.mts.",
  input,
  domain,
  register: registerDigestV2(domain, input.agent, input.ownerX, input.ownerY),
  mandateHash: mandateV2Hash(m),
  setMandate: setMandateV2Challenge(domain, input.agent, m, BigInt(input.nonce)),
  freeze: freezeChallengeV2(domain, input.agent, BigInt(input.epoch)),
  unfreeze: unfreezeChallengeV2(domain, input.agent, BigInt(input.nonce), BigInt(input.epoch)),
  // The Sealed L1 on Fuji's blockchain id, as the console reads it from deployments/fuji.json.
  cb58: {
    id: "UFo3xChM9b9efQkg93qPnswkJi7VR1XW7KQg9wE7gnCULfbYo",
    hex: cb58ToHex("UFo3xChM9b9efQkg93qPnswkJi7VR1XW7KQg9wE7gnCULfbYo"),
  },
};
writeFileSync(
  new URL("../../../chain/testvectors/agentpolicy-v2.json", import.meta.url),
  `${JSON.stringify(out, null, 2)}\n`,
);
console.log("wrote chain/testvectors/agentpolicy-v2.json");
