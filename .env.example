# Copy to .env and fill in. Never commit .env.
# Each service will also ship its own .env.example as it is added.

# RPC endpoint of the Sealed L1 (local network by default).
SEALED_RPC_URL=http://127.0.0.1:9650/ext/bc/sealed/rpc

# x402 facilitator and sample seller (services/facilitator, services/seller).
FACILITATOR_PORT=4020
SELLER_PORT=4021
FACILITATOR_URL=http://127.0.0.1:4020
# Address the seller is paid at; defaults to the first payee of the seeded mandate.
SELLER_PAY_TO=
# URL buyers reach the seller at; resource URLs (bound into each payment) are built from it.
SELLER_BASE_URL=http://127.0.0.1:4021

# Relayer for owner passkey actions (services/relayer) and the owner console (web/).
RELAYER_PORT=4040
# Required outside the local network; on the local network the public development key is used.
RELAYER_PRIVATE_KEY=
# RPC URL the web page should read from (defaults to SEALED_RPC_URL).
RELAYER_PUBLIC_RPC=
# Comma-separated browser origins allowed to call the relayer (default: any).
RELAYER_ALLOWED_ORIGINS=
# Set to 1 only behind a reverse proxy you run (client address from X-Forwarded-For).
RELAYER_TRUST_PROXY=
# Read by the web build: where the relayer is.
VITE_RELAYER_URL=http://127.0.0.1:4040
