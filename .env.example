# Copy to .env and fill in. Never commit .env.
# Each service will also ship its own .env.example as it is added.

# RPC endpoint of the Sealed L1 (local network by default).
SEALED_RPC_URL=http://127.0.0.1:9650/ext/bc/sealed/rpc

# x402 facilitator and sample seller (services/facilitator, services/seller).
FACILITATOR_PORT=4020
SELLER_PORT=4021
FACILITATOR_URL=http://127.0.0.1:4020
# Address the seller is paid at; defaults to the first payee of the seeded mandate.
SELLER_PAY_TO=
# URL buyers reach the seller at; resource URLs (bound into each payment) are built from it.
SELLER_BASE_URL=http://127.0.0.1:4021
